{
	"name": "hrms-backend",
	"version": "1.0.0",
	"description": "Human Resource Management System Backend",
	"scripts": {
		"dev": "next dev -H localhost -p 3000",
		"build": "rimraf .next src/app/api/engine src/app/lib/payroll-engine && npx prisma generate && node --max-old-space-size=8192 node_modules/next/dist/bin/next build",
		"start": "next start",
		"lint": "eslint . --max-warnings 0",
		"typecheck": "node --max-old-space-size=8192 node_modules/typescript/bin/tsc --noEmit -p .",
		"test": "jest --config jest.config.ts",
		"test:unit": "jest --config jest.config.ts tests/phed/unit",
		"test:api": "jest --config jest.config.ts tests/phed/api",
		"test:security": "jest --config jest.config.ts tests/phed/security",
		"test:db:prepare": "node scripts/test-db.js prepare",
		"test:db": "node scripts/test-db.js run",
		"db:push": "prisma db push",
		"db:studio": "prisma studio",
		"db:generate": "prisma generate",
		"db:seed": "tsx scripts/seed.ts",
		"db:seed:payroll-templates": "tsx scripts/seed-system-payroll-templates.ts",
		"setup": "powershell -File scripts/setup-windows.ps1",
		"verify": "tsx scripts/verify-env.ts",
		"docs:api": "tsx scripts/generate-api-reference.ts",
		"postinstall": "prisma generate"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1106.0",
		"@aws-sdk/s3-request-presigner": "^3.1106.0",
		"@fontsource/noto-sans": "^5.2.10",
		"@prisma/adapter-pg": "^7.3.0",
		"@prisma/client": "^7.3.0",
		"@prisma/engines": "^7.3.0",
		"@react-pdf/renderer": "^4.5.1",
		"@types/exceljs": "^0.5.3",
		"archiver": "^8.0.0",
		"bcryptjs": "^2.4.3",
		"compromise": "^14.14.5",
		"cors": "^2.8.5",
		"decimal.js": "^10.6.0",
		"docxtemplater": "^3.69.3",
		"dotenv": "^17.4.2",
		"exceljs": "^4.4.0",
		"file-type": "^21.1.1",
		"form-data": "^4.0.5",
		"formidable": "^3.5.4",
		"fuse.js": "^7.5.0",
		"he": "^1.2.0",
		"iconv-lite": "^0.7.0",
		"imapflow": "^1.7.1",
		"jose": "^6.2.3",
		"jsonwebtoken": "^9.0.2",
		"livekit-server-sdk": "^2.17.0",
		"mailgun.js": "^12.7.1",
		"mailparser": "^3.9.15",
		"mammoth": "^1.11.0",
		"multer": "^1.4.5-lts.1",
		"natural": "^8.1.0",
		"next": "^15.5.29",
		"nodemailer": "10.3.1",
		"pdf-lib": "^1.17.1",
		"pdf-parse": "^2.4.5",
		"pdfkit": "^0.14.0",
		"pg": "^8.18.0",
		"pg-boss": "^10.4.2",
		"pizzip": "^3.2.0",
		"puppeteer": "25.16.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"sharp": "^0.35.5",
		"stopword": "^3.1.5",
		"supports-color": "^10.2.2",
		"validator": "^13.15.26",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/archiver": "^8.0.0",
		"@types/bcryptjs": "^2.4.6",
		"@types/formidable": "^3.4.6",
		"@types/he": "^1.2.3",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/mailparser": "^3.4.6",
		"@types/multer": "^1.4.13",
		"@types/node": "^20.19.26",
		"@types/nodemailer": "^6.4.21",
		"@types/pdfkit": "^0.12.12",
		"@types/pg": "^8.16.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/uuid": "^10.0.0",
		"@types/validator": "^13.15.10",
		"docx": "^9.7.1",
		"eslint": "^9.39.5",
		"globals": "^17.14.0",
		"jest": "^30.3.0",
		"jest-environment-node": "^30.3.0",
		"prisma": "^7.3.0",
		"ts-jest": "^29.4.9",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.2"
	},
	"overrides": {
		"readdir-glob": {
			"minimatch": "11.0.4"
		},
		"exceljs": {
			"uuid": "11.1.1"
		},
		"next": {
			"postcss": "8.5.32"
		}
	}
}
