
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id                     String                   @id @default(cuid())
  companyName            String
  tradingName            String?
  rcNumber               String?
  industry               String?
  website                String?
  biography              String?                  @db.Text
  fiscalYearStart        String?
  leaveYearStart         String?
  status                 String                   @default("Active")
  address                String?
  phone                  String?
  email                  String
  logo                   String?
  taxId                  String?
  baseCurrency           String                   @default("NGN") @db.VarChar(3)
  archived               Int                      @default(0)
  createdBy              String
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime?                @updatedAt
  workWeekPattern        String?                  @db.VarChar(20)

  // Offer letter / employer details (populated onto the offer letter template).
  // Every company-specific value comes from here so the shared template stays generic.
  secondedCompany        String?                  // client org a hire may be seconded to
  hrRepName              String?                  // HR representative who signs the letter
  hrRepTitle             String?                  // e.g. "HRBP"
  communicationTool      String?                  // official comms tool, e.g. "Lark"
  governingLaw           String?                  @default("Laws of the Federal Republic of Nigeria")
  arbitrationVenue       String?                  @default("Lagos")
  // Days a candidate has to accept + return the signed offer letter before the
  // offer lapses. Per-company (multi-tenant); null falls back to the 14-day default.
  offerResponseDays      Int?

  // Locations
  locations              Location[]

  // Offer letter templates
  offerTemplates         OfferTemplate[]

  // AI & Settings
  aiSettings             AISettings?
  aiUsageLogs            AIUsageLog[]
  
  // Attendance
  attendances            Attendance[]
  
  // Recruitment
  assessmentPlans        RecruitmentAssessmentPlan[]
  candidateAssessments   RecruitmentCandidateAssessment[]
  candidateDocuments     CandidateDocument[]
  candidateFiles         CandidateFile[]
  candidates             Candidate[]
  interviews             Interview[]
  applications           JobApplication[]
  jobs                   Job[]
  offers                 Offer[]
  onboardings            Onboarding[]
  
  // Leave Management
  leave_blackout_periods leave_blackout_periods[]
  leavePolicies          LeavePolicy[]
  leave_uploads          leave_uploads[]
  leaveRequests          LeaveRequest[]
  publicHolidays         PublicHoliday[]
  
  // Payroll
  payrollUploads         PayrollUpload[]
  payrolls               Payroll[]
  payslips               Payslip[]
  payrollTemplates       PayrollTemplate[]
  payrollData            PayrollData[]
  payrollTemplateUploads PayrollTemplateUpload[]
  
  // Tax
  employeeTaxProfiles    EmployeeTaxProfile[]
  taxFilingSchedules     TaxFilingSchedule[]
  annualReturns          AnnualReturn[]
  taxProfileUploads      TaxProfileUpload[]

  // Exchange Rates
  exchangeRates          CompanyExchangeRate[]

  // Pay Dates
  companyPayDates        CompanyPayDate[]

  // Payroll Engine
  payPeriods             PayPeriod[]
  employeeSalaries       EmployeeSalary[]
  payValidations         PayValidation[]
  overtimeEntries        OvertimeEntry[]
  deductionEntries       DeductionEntry[]
  computedPayslips       ComputedPayslip[]

  // Staff & Users
  staff                  StaffRecord[]
  staffUploads           StaffUpload[]
  userCompanies          UserCompany[]

  // Notifications & Logs
  notifications          Notification[]
  emailLogs              EmailLog[]

  // Department Relations
  departments            Department[]
  departmentAuditLogs    DepartmentAuditLog[]
  departmentStaffHistories DepartmentStaffHistory[]

  // Business Unit Relations
  businessUnits          BusinessUnit[]

  // Temporary role elevations granted within this company
  roleElevations         RoleElevation[]

  // Staff Loans & Benefits
  loanRequests           LoanRequest[]       @relation("CompanyLoanRequests")
  benefitRequests        BenefitRequest[]    @relation("CompanyBenefitRequests")
  benefitAllocations     BenefitAllocation[] @relation("CompanyBenefitAllocations")
  loanPolicies           LoanPolicy[]
  benefitPolicies        BenefitPolicy[]

  // PHED Module relations
  phedGrades             PhedGrade[]
  phedRegions            PhedRegion[]
  phedFeeders            PhedFeeder[]
  phedPayPoints          PhedPayPoint[]
  phedUnions             PhedUnion[]
  phedCooperatives       PhedCooperative[]
  phedDeductionLiabilities PhedDeductionLiability[]
  phedStaff              PhedStaff[]
  phedPayPeriods         PhedPayPeriod[]
  phedValidations        PhedValidation[]
  phedOvertimeEntries    PhedOvertimeEntry[]
  phedComputedPayrolls   PhedComputedPayroll[]
  phedBulkUploads        PhedBulkUpload[]
  phedPeriodAdvances     PhedStaffPeriodAdvance[]
  phedStaffAccessRoles   PhedStaffAccessRole[]
  phedApprovalMemos      PhedApprovalMemo[]
  phedRoleAccessGrants   PhedRoleAccessGrant[]
  phedChangeLogs         PhedChangeLog[]
  phedStaffExits         PhedStaffExit[]

  // Training & Certification Module relations
  trainingPrograms       TrainingProgram[]
  trainingSessions       TrainingSession[]
  trainingMaterials      TrainingMaterial[]
  assessments            Assessment[]
  assessmentAttempts     AssessmentAttempt[]
  participantProgress    ParticipantProgress[]
  certificationTypes     CertificationType[]
  certificationTemplates CertificationTemplate[]
  certificationRecords   CertificationRecord[]
  assignmentRules        AssignmentRule[]
  riskItems              RiskItem[]
  trainingAuditLogs      TrainingAuditLog[]
  moduleAccess           CompanyModuleAccess[]
  
   // Grade Levels
  gradeLevels            GradeLevel[]            //opposite of GradeLevel.company
  designations           Designation[]           //opposite of Designation.company
  
  // Benefits
  benefits               Benefit[]                 // opposite of Benefit.company
  
  // Allowance Rules
  companyAllowanceRules  CompanyAllowanceRule[]    // CompanyAllowanceRule.company
  
  // Grade Step Allowances
  gradeStepAllowances    GradeStepAllowance[]      //  GradeStepAllowance.company
  
  // Company Salary Formulas
  companySalaryFormulas  CompanySalaryFormula[]    // opposite of CompanySalaryFormula.company
  
  // Grade Allowance Templates
  gradeAllowanceTemplates GradeAllowanceTemplate[] //opposite of GradeAllowanceTemplate.company
  staffSalaryHistory      StaffSalaryHistory[]
  staffGradeHistory       StaffGradeHistory[]
  offboardings         Offboarding[]
  @@map("companies")
}

model Location {
  id        String   @id @default(cuid())
  companyId String
  name      String
  code      String?
  type      String?
  country   String?  // e.g. Nigeria, United Kingdom (defaults to Nigeria for legacy rows)
  state     String?  // level 1: State (NG) / Nation (UK) / State-Province (other)
  lga       String?  // level 2: LGA (NG) / County (UK) / City (other)
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff     StaffRecord[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("locations")
}

model PlatformModule {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  companyAccess CompanyModuleAccess[]

  @@map("platform_modules")
}

model CompanyModuleAccess {
  id        String   @id @default(cuid())
  companyId String
  moduleId  String
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module  PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([companyId, moduleId])
  @@map("company_module_access")
}

model CompanyExchangeRate {
  id            String   @id @default(cuid())
  companyId     String
  baseCurrency  String   @db.VarChar(3)
  quoteCurrency String   @db.VarChar(3)
  rate          Decimal  @db.Decimal(20, 8)
  source        String?  @default("MANUAL")
  fetchedAt     DateTime?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, baseCurrency, quoteCurrency])
  @@index([companyId, updatedAt])
  @@index([companyId, baseCurrency])
  @@map("company_exchange_rates")
}

model StaffRecord {
  id                              String              @id @default(cuid())
  staffId                         String
  email                           String
  firstName                       String
  lastName                        String
  department                      String?
  departmentId                    String?
  position                        String
  phone                           String?
  bankName                        String?
  accountNumber                   String?
  bvn                             String?
  password                        String?
  isRegistered                    Boolean             @default(false)
  requirePasswordChange           Boolean             @default(false)
  role                            String              @default("STAFF")
  isActive                        Boolean             @default(true)
  companyId                       String
  createdBy                       String
  createdAt                       DateTime            @default(now())
  updatedAt                       DateTime            @updatedAt
  encodedId                       String?
  updatedBy                       String?
  managerId                       String?
  avatarUrl                       String?
  location                        String?
  locationId                      String?

  // Relations with matching relation names
  attendances                     Attendance[]
  leaveRequestsToApproveAsManager LeaveRequest[]      @relation("LeaveRequestManagerApprover")
  leaveRequests                   LeaveRequest[]      @relation("LeaveRequestStaff")
  leaveRequestsAsHandover         LeaveRequest[]      @relation("LeaveRequestHandover")
  onboardings                     Onboarding[]
  payrolls                        Payroll[]
  payslips                        Payslip[]
  leaveBalances                   StaffLeaveBalance[]
  company                         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager                         StaffRecord?        @relation("StaffManagers", fields: [managerId], references: [id])
  directReports                   StaffRecord[]       @relation("StaffManagers")
  userCompanies                   UserCompany[]
  notifications                   Notification[]
  emailLogs                       EmailLog[]
  payrollData                     PayrollData[]
  taxProfile                      EmployeeTaxProfile?

  // Department relations
  departments                     Department?         @relation(fields: [departmentId], references: [id])
  headOfDepartment                Department[]        @relation("DepartmentHead")
  assistantHeadOfDepartment       Department[]        @relation("DepartmentAssistantHead")
  departmentStaffHistories        DepartmentStaffHistory[]

  // Business Unit relations (as head / assistant head)
  headOfBusinessUnit              BusinessUnit[]      @relation("BusinessUnitHead")
  assistantHeadOfBusinessUnit     BusinessUnit[]      @relation("BusinessUnitAssistantHead")

  // Temporary role elevations granted to this staff member
  roleElevations                  RoleElevation[]     @relation("StaffRoleElevations")

  // Location relation (legacy `location` string retained for back-compat)
  locationRecord                  Location?           @relation(fields: [locationId], references: [id])

  // Payroll Engine relations
  employeeSalaries                EmployeeSalary[]
  payValidationsAsStaff           PayValidation[]     @relation("PayValidationStaff")
  payValidationsAsSupervisor      PayValidation[]     @relation("PayValidationSupervisor")
  overtimeEntries                 OvertimeEntry[]
  deductionEntries                DeductionEntry[]
  computedPayslips                ComputedPayslip[]

  // Training & Certification Module relations
  assessmentAttempts              AssessmentAttempt[]
  participantProgress             ParticipantProgress[]
  certificationRecords            CertificationRecord[]
  trainingAuditLogs               TrainingAuditLog[]

  // Staff Loans & Benefits
  loanRequests                    LoanRequest[]       @relation("StaffLoanRequests")
  loanRequestsAsApprover          LoanRequest[]       @relation("LoanApprover")
  benefitRequests                 BenefitRequest[]    @relation("StaffBenefitRequests")
  benefitRequestsAsApprover       BenefitRequest[]    @relation("BenefitRequestApprover")
  benefitAllocations              BenefitAllocation[] @relation("StaffBenefitAllocations")
  benefitAllocationsAsAllocator   BenefitAllocation[] @relation("BenefitAllocator")
  
   // Grade Level Relations
  currentGradeId      String?
  currentGradeStep    Int?              @default(1)
  gradeLevelStartDate DateTime?
  
  // Relations
  currentGrade        GradeLevel?       @relation("StaffGradeLevel", fields: [currentGradeId], references: [id])
  
  // Salary history
  salaryHistory       StaffSalaryHistory[]
  gradeHistory        StaffGradeHistory[]
  
  // Grade-based salary calculations
  gradeBasicSalary    Decimal?          @db.Decimal(18, 2)
  gradeAllowances     Json?
   // Designation relation
  designationId       String?
  designation         Designation?       @relation(fields: [designationId], references: [id])

  // PHED Approval Workflow / Access Matrix (Module 12 & 13) — independent of `role` above
  phedAccessRole      PhedStaffAccessRole?
  offboardings                    Offboarding[]       @relation("StaffOffboardings")
  reviewedOffboardings            Offboarding[]       @relation("OffboardingReviewer")

  @@unique([staffId, companyId])
  @@unique([email, companyId])
  @@index([email])
  @@index([locationId])
  @@map("staff_records")
}

model Payroll {
  id                     String      @id @default(cuid())
  companyId              String
  staffRecordId          String
  month                  String
  year                   Int
  grossPay               Decimal?    @db.Decimal(18, 2)
  basicSalary            Decimal?    @db.Decimal(18, 2)
  housing                Decimal?    @db.Decimal(18, 2)
  transport              Decimal?    @db.Decimal(18, 2)
  dressing               Decimal?    @db.Decimal(18, 2)
  leaveAllowance         Decimal?    @db.Decimal(18, 2)
  entertainment          Decimal?    @db.Decimal(18, 2)
  utility                Decimal?    @db.Decimal(18, 2)
  otherAllowance         Decimal?    @db.Decimal(18, 2)
  proratedGrossPay       Decimal?    @db.Decimal(18, 2)
  proratedGrossWithExtra Decimal?    @db.Decimal(18, 2)
  annualPension          Decimal?    @db.Decimal(18, 2)
  annualGrossPay         Decimal?    @db.Decimal(18, 2)
  consolidatedRelief     Decimal?    @db.Decimal(18, 2)
  taxableIncome          Decimal?    @db.Decimal(18, 2)
  deductions             Decimal?    @db.Decimal(18, 2)
  payee                  Decimal?    @db.Decimal(18, 2)
  pensionDeduction       Decimal?    @db.Decimal(18, 2)
  bonusKPI               Decimal?    @db.Decimal(18, 2)
  netSalary              Decimal?    @db.Decimal(18, 2)
  finalGross             Decimal?    @db.Decimal(18, 2)
  medicalContribution    Decimal?    @db.Decimal(18, 2)
  employerPension        Decimal?    @db.Decimal(18, 2)
  nsitf                  Decimal?    @db.Decimal(18, 2)
  proratedSubTotal       Decimal?    @db.Decimal(18, 2)
  managementFee          Decimal?    @db.Decimal(18, 2)
  vatOnManagementFee     Decimal?    @db.Decimal(18, 2)
  totalInvoiceValue      Decimal?    @db.Decimal(18, 2)
  overtimeIncome         Decimal?    @db.Decimal(18, 2)
  communicationAllowance Decimal?    @db.Decimal(18, 2)
  transportationAllowance Decimal?   @db.Decimal(18, 2)
  outstandingIncome      Decimal?    @db.Decimal(18, 2)
  
  // NEW FIELDS - Add these
  walletPayment          Decimal?    @db.Decimal(18, 2)  // Maps to "Pay OPay"
  commercialPayment      Decimal?    @db.Decimal(18, 2)  // Maps to "Bank Payment"
  customFields           Json?      
  templateId             String?     // Reference to the dynamic template used
  
  status                 String      @default("PROCESSED")
  templateType           String?     @default("ISURF_STANDARD")
  uploadedBy             String
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  company                Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staffRecord            StaffRecord      @relation(fields: [staffRecordId], references: [id], onDelete: Cascade)
  template               PayrollTemplate? @relation(fields: [templateId], references: [id])
  payslips               Payslip[]
  emailLogs              EmailLog[]

  @@index([staffRecordId, month, year, companyId])
  @@index([companyId, year, month])
  @@index([templateType])
  @@index([templateId])
  @@map("payrolls")
}

model Payslip {
  id            String      @id @default(cuid())
  payrollId     String
  staffRecordId String
  companyId     String
  fileData      Bytes?
  fileName      String
  fileType      String      @default("application/pdf")
  fileSize      Int?
  filePath      String?
  month         String
  year          Int
  grossPay      Decimal?    @db.Decimal(18, 2)
  netPay        Decimal?    @db.Decimal(18, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  updatedBy     String?
  createdBy     String?
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payroll       Payroll     @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  staffRecord   StaffRecord @relation(fields: [staffRecordId], references: [id], onDelete: Cascade)
  emailLogs     EmailLog[]

  @@index([staffRecordId, year, month])
  @@map("payslips")
}

model StaffUpload {
  id           String   @id @default(cuid())
  companyId    String
  fileName     String
  filePath     String
  processedFilePath String?  // Add this field
  processedFileName String?  // Add this field
  totalRecords Int
  successful   Int
  failed       Int
  errors       String[]
  uploadedBy   String
  createdAt    DateTime @default(now())
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("staff_uploads")
}

model PayrollUpload {
  id                String           @id @default(cuid())
  companyId         String
  fileName          String
  filePath          String
  processedFilePath String?
  processedFileName String?
  templateType      String           @default("ISURF_STANDARD")
  templateId        String?
  sendEmails        Boolean          @default(true)
  totalRecords      Int              @default(0)      // ← ADD THIS
  successful        Int              @default(0)      // ← ADD THIS
  failed            Int              @default(0)      // ← ADD THIS
  payslipsGenerated Int?                              // ← ADD THIS
  payslipsUpdated   Int?
  emailsSent        Int?
  emailAttempts     Int?
  overwriteExisting Boolean          @default(false) // ← ADD THIS
  errors            String[]
  uploadedBy        String
  createdAt         DateTime         @default(now())
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template          PayrollTemplate? @relation(fields: [templateId], references: [id])

  @@map("payroll_uploads")
}

// ==================== RECRUITMENT: ASSESSMENT PLANS ====================

model RecruitmentAssessmentPlan {
  id                     String              @id @default(cuid())
  companyId              String
  name                   String
  description            String?             @db.Text
  status                 PlanStatus          @default(DRAFT)
  totalDurationMins      Int?
  createdBy              String?
  updatedBy              String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  archived               Int?                @default(0)

  company                Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rounds                 RecruitmentAssessmentRound[]
  candidateAssessments   RecruitmentCandidateAssessment[]

  @@index([companyId, status])
  @@index([companyId, archived])
  @@map("recruitment_assessment_plans")
}

model RecruitmentAssessmentRound {
  id                    String            @id @default(cuid())
  planId                String
  order                 Int
  title                 String
  interviewType         InterviewType     @default(VIDEO)
  duration              Int
  gradingMetric         String?
  questionBanks         Json?
  requiredInterviewers  Json?
  // Optional evaluation plan for the round (scoring rubric / what to assess /
  // guidance, or a link). Not required — a round can be saved without one.
  evaluationPlan        String?           @db.Text
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  plan                  RecruitmentAssessmentPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  scorecards            RecruitmentScorecard[]

  @@unique([planId, order])
  @@index([planId])
  @@map("recruitment_assessment_rounds")
}

// A re-use of a published assessment plan for a specific Job and/or Designation.
// The plan's rounds stay the reusable template; the instance carries the panel
// chosen for THIS job/designation (editable before finalising), keyed by round.
// FKs are enforced in SQL only (no Prisma relations) so the generated client is
// not required — access via (prisma as any). panelByRound shape:
//   { [roundId]: [{ staffId, name, email, role }] }
model AssessmentPlanInstance {
  id            String    @id @default(cuid())
  companyId     String
  planId        String
  jobId         String?
  designationId String?
  panelByRound  Json?
  status        String    @default("ACTIVE") // ACTIVE | ARCHIVED
  createdBy     String?
  createdByName String?
  notifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId, planId])
  @@index([companyId, jobId])
  @@index([companyId, designationId])
  @@map("assessment_plan_instances")
}

// ==================== RECRUITMENT: ASSESSMENT QUEUE ====================

model RecruitmentCandidateAssessment {
  id                String        @id @default(cuid())
  applicationId     String        @unique
  planId            String
  companyId         String
  currentRoundOrder Int           @default(1)
  roundStatus       RoundStatus   @default(AWAITING_SCHEDULING)
  scheduledAt       DateTime?
  schedulingNotes   String?       @db.Text
  interviewerIds    Json?
  averageScore      Float?
  createdBy         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  application       JobApplication                @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  plan              RecruitmentAssessmentPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  company           Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scorecards        RecruitmentScorecard[]

  @@index([companyId, roundStatus])
  @@index([planId])
  @@map("recruitment_candidate_assessments")
}

model RecruitmentScorecard {
  id                     String                  @id @default(cuid())
  candidateAssessmentId  String
  roundId                String
  interviewerId          String
  interviewerName        String?
  interviewerRole        String?
  scores                 Json
  notes                  String?                 @db.Text
  recommendation         ScorecardRecommendation
  submittedAt            DateTime                @default(now())

  candidateAssessment    RecruitmentCandidateAssessment  @relation(fields: [candidateAssessmentId], references: [id], onDelete: Cascade)
  round                  RecruitmentAssessmentRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([candidateAssessmentId, roundId, interviewerId])
  @@index([candidateAssessmentId])
  @@index([roundId])
  @@map("recruitment_scorecards")
}

// ==================== RECRUITMENT: OFFER APPROVAL WORKFLOW ====================

model RecruitmentOfferApproval {
  id            String              @id @default(cuid())
  offerId       String
  approverId    String
  approverName  String?
  approverRole  String?
  step          Int
  status        OfferApprovalStatus @default(PENDING)
  notes         String?             @db.Text
  actedAt       DateTime?
  createdAt     DateTime            @default(now())

  offer         Offer               @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId, approverId])
  @@index([offerId, step])
  @@map("recruitment_offer_approvals")
}

model JobApplication {
  id              String                    @id @default(cuid())
  companyId       String
  jobId           String
  candidateId     String
  cvFilePath      String
  cvFileName      String?
  parsedCvContent String?
  status          ApplicationStatus         @default(SUBMITTED)
  score           Int?
  notes           String?
  metadata        Json?
  reviewedBy      String?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  reviewedAt      DateTime?
  cvFileId        String?                   @unique
  archived        Int?                      @default(0)
  stageHistory    ApplicationStageHistory[]
  files           CandidateFile[]           @relation("ApplicationFiles")
  interviews      Interview[]
  candidate       Candidate                 @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  company         Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cvFile          CandidateFile?            @relation("ApplicationCVFile", fields: [cvFileId], references: [id])
  job             Job                       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  offer           Offer?
  candidateAssessment RecruitmentCandidateAssessment?

  @@unique([jobId, candidateId])
  @@index([companyId, jobId, status])
  @@index([companyId, archived])
  @@index([cvFileId])
  @@map("job_applications")
}

model CandidateFile {
  id               String            @id @default(cuid())
  companyId        String
  candidateId      String
  applicationId    String?
  type             CandidateFileType @default(CV)
  fileName         String
  mimeType         String
  sizeBytes        Int
  data             Bytes
  createdBy        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  archived         Int?              @default(0)
  application      JobApplication?   @relation("ApplicationFiles", fields: [applicationId], references: [id])
  candidate        Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cvForApplication JobApplication?   @relation("ApplicationCVFile")

  @@index([companyId, candidateId])
  @@index([companyId, archived])
  @@index([applicationId])
  @@index([companyId, applicationId, type])
  @@map("candidate_files")
}

model Keyword {
  id          String @id @default(cuid())
  name        String @unique
  description String
  jobId       String
  updatedAt   DateTime @default(now()) @updatedAt
  archived    Int?    @default(0)
  job         Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, archived])
  @@map("keywords")
}

model Job {
  id             String           @id @default(cuid())
  title          String
  description    String           @db.Text
  department     String
  position       String
  companyId      String
  status         JobStatus        @default(ACTIVE)
  expirationDate DateTime?
  
  // NEW FIELDS 
  employmentType  String?          // Full-time, Part-time, Contract, Intern, Temporary
  workplaceType   String?          // Remote, Hybrid, On-site
  experienceLevel String?          // Entry, Mid, Senior, Lead, Executive
  salaryRange     String?          // e.g., "N500,000 - N800,000"
  benefits        Json?            // Array of strings: ["health", "equity", "pto", "gym"]
  locations       Json?            // Array of objects: [{"state": "Lagos", "lga": "Ikeja"}, ...]
  // Default employment terms for offers generated against this role. Per-offer
  // values may override these. e.g. { contractDuration, probationPeriod,
  // noticePeriod, weeklyHours, dailyHours, lunchBreak, jobLocation }
  offerDefaults   Json?

  createdBy      String
  createdAt      DateTime         @default(now())
  updatedBy      String?
  updatedAt      DateTime         @updatedAt
  archived       Int?             @default(0)
  
  // The designation (from Core Setup) this vacancy recruits for. A job is tied
  // to one designation; many jobs/hires can map to the same designation. When a
  // candidate is hired, their staff record inherits this designation.
  designationId  String?

  // The Core Setup department this vacancy belongs to. Nullable FK alongside the
  // denormalised `department` name (mirrors StaffRecord's name+id pairing) so
  // existing rows are unaffected and new/edited jobs gain referential integrity.
  departmentId   String?

  // Relations
  applications   JobApplication[]
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  designation    Designation?     @relation(fields: [designationId], references: [id])
  departmentRef  Department?      @relation(fields: [departmentId], references: [id])
  keywords       Keyword[]
  //savedBy        SavedJob[]       // this for saved jobs feature

  @@index([companyId, status])
  @@index([companyId, archived])
  @@index([designationId])
  @@index([departmentId])
  @@map("jobs")
}

// Company-scoped offer letter templates. bodyHtml holds rich text with
// {{placeholder}} tokens (see lib/offers/template-variables) that are resolved
// from company / candidate / job / offer data at render time. The template
// itself is generic — no company-specific values are baked in.
model OfferTemplate {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?  @db.Text
  bodyHtml    String   @db.Text
  sections    Json?    // optional structured section/clause config for the builder
  variables   Json?    // snapshot of placeholder keys referenced by this template
  status      String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  isDefault   Boolean  @default(false)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archived    Int?     @default(0)

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([companyId, archived])
  @@index([companyId, isDefault])
  @@map("offer_templates")
}

