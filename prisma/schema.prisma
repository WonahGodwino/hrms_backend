model PayrollTemplate {
  id            String   @id @default(cuid())
  companyId     String
  templateName  String
  sections      Json
  isSystem      Boolean  @default(false)
  createdBy     String
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company        Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fields         PayrollTemplateField[]
  payrollData    PayrollData[]
  payrolls       Payroll[]
  uploads        PayrollTemplateUpload[]
  payrollUploads PayrollUpload[]

  @@index([companyId])
  @@index([isSystem])
  @@index([createdAt])
  @@map("payroll_templates")
}

model PayrollTemplateField {
  id            String   @id @default(cuid())
  templateId    String
  section       String
  displayName   String
  systemField   String
  dataType      String
  required      Boolean  @default(false)
  aliases       Json?
  showOnPayslip Boolean  @default(false)
  order         Int
  createdBy     String
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  template      PayrollTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, systemField])
  @@index([templateId, section])
  @@index([templateId, order])
  @@map("payroll_template_fields")
}

model PayrollData {
  id          String   @id @default(cuid())
  companyId   String
