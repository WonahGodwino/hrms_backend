  payPeriodId  String?
  type         String         // STAFF | VALIDATION | OVERTIME | PAYROLL_TEMPLATE
  fileName     String
  totalRecords Int
  successful   Int
  failed       Int
  errors       Json?
  uploadedBy   String
  createdAt    DateTime       @default(now())

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
