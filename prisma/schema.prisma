// Payroll Engine Enums
enum PayPeriodStatus {
  DRAFT
  VALIDATION_OPEN
  VALIDATION_CLOSED
  COMPUTING
  REVIEW
  APPROVED
  PAID
}

enum ValidationStatus {
  PENDING
  YES_FOR_PAYMENT
  NO_FOR_PAYMENT
}

enum PaymentStatus {
  PENDING
  ACTIVE
  WITHHELD
  PAID
}

enum EmployeeCategory {
  REGULAR
  CONTRACT
}

enum DeductionType {
  UNION_DUES
  COOPERATIVE
  LOAN
  SALARY_ADVANCE
  OTHER
}

enum ReportType {
  BANK_SCHEDULE
  WITHHELD_SALARIES
  PAYE_SCHEDULE
  PENSION_SCHEDULE
  NHF_SCHEDULE
  ITF_SCHEDULE
  NSITF_SCHEDULE
  COST_CENTRE_SUMMARY
}

// Pay Period - Represents a payroll cycle (monthly)
model PayPeriod {
  id                     String          @id @default(cuid())
  companyId              String
  year                   Int
  month                  Int
  periodName             String
  startDate              DateTime
  endDate                DateTime
  validationWindowStart  DateTime?
  validationWindowEnd    DateTime?
  status                 PayPeriodStatus @default(DRAFT)
  standardMonthlyHours   Int             @default(176)
  createdBy              String
  approvedBy             String?
  approvedAt             DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  company                Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  computedPayslips       ComputedPayslip[]
  payValidations         PayValidation[]
  overtimeEntries        OvertimeEntry[]
  deductionEntries       DeductionEntry[]

  @@unique([companyId, year, month])
  @@index([companyId, status])
  @@map("pay_periods")
}

// Employee Salary Structure - Defines salary components for each staff
model EmployeeSalary {
  id                       String           @id @default(cuid())
  staffId                  String
  companyId                String
  employeeCategory         EmployeeCategory @default(REGULAR)
  basicSalary              Decimal          @db.Decimal(18, 2)
  housingAllowance         Decimal          @default(0) @db.Decimal(18, 2)
  transportAllowance       Decimal          @default(0) @db.Decimal(18, 2)
  dressingAllowance        Decimal          @default(0) @db.Decimal(18, 2)
  leaveAllowance           Decimal          @default(0) @db.Decimal(18, 2)
  entertainmentAllowance   Decimal          @default(0) @db.Decimal(18, 2)
  utilityAllowance         Decimal          @default(0) @db.Decimal(18, 2)
  otherAllowances          Decimal          @default(0) @db.Decimal(18, 2)
  annualRent               Decimal          @default(0) @db.Decimal(18, 2)
  bankName                 String?
  accountNumber            String?
  accountName              String?
  pensionFundAdministrator String?
  pensionPin               String?
  isActive                 Boolean          @default(true)
  effectiveDate            DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  staff                    StaffRecord      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  company                  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([staffId, companyId, isActive])
  @@index([companyId])
  @@map("employee_salaries")
}

// Pay Validation - Supervisor validation for each staff per period
model PayValidation {
  id            String           @id @default(cuid())
  payPeriodId   String
  staffId       String
  supervisorId  String?
  departmentId  String?
  companyId     String
  status        ValidationStatus @default(PENDING)
  reason        String?
  validatedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  payPeriod     PayPeriod        @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  staff         StaffRecord      @relation("PayValidationStaff", fields: [staffId], references: [id], onDelete: Cascade)
  supervisor    StaffRecord?     @relation("PayValidationSupervisor", fields: [supervisorId], references: [id])
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([payPeriodId, staffId])
  @@index([payPeriodId, status])
  @@index([payPeriodId, supervisorId])
  @@index([companyId])
  @@map("pay_validations")
}

// Overtime Entry - Tracks overtime hours for payroll computation
model OvertimeEntry {
  id            String    @id @default(cuid())
  payPeriodId   String
  staffId       String
  companyId     String
  overtimeHours Decimal   @db.Decimal(10, 2)
  multiplier    Decimal   @default(1.5) @db.Decimal(5, 2)
  date          DateTime?
  description   String?
  sourceFileId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payPeriod     PayPeriod   @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  staff         StaffRecord @relation(fields: [staffId], references: [id], onDelete: Cascade)
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([payPeriodId, staffId])
  @@index([companyId])
  @@index([sourceFileId])
  @@map("overtime_entries")
}

// Deduction Entry - Tracks various deductions per staff per period
model DeductionEntry {
  id            String        @id @default(cuid())
  payPeriodId   String
  staffId       String
  companyId     String
  deductionType DeductionType
  amount        Decimal       @db.Decimal(18, 2)
  description   String?
  sourceFileId  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payPeriod     PayPeriod     @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  staff         StaffRecord   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([payPeriodId, staffId])
  @@index([payPeriodId, deductionType])
  @@index([companyId])
  @@index([sourceFileId])
  @@map("deduction_entries")
}

// Computed Payslip - Final computed payslip for each staff per period
model ComputedPayslip {
  id                          String          @id @default(cuid())
  payPeriodId                 String
  staffId                     String
  companyId                   String
  employeeName                String?
  employeeEmail               String?
  departmentId                String?
  departmentName              String?

  // Earnings
  basicSalary                 Decimal         @default(0) @db.Decimal(18, 2)
  housingAllowance            Decimal         @default(0) @db.Decimal(18, 2)
  transportAllowance          Decimal         @default(0) @db.Decimal(18, 2)
  dressingAllowance           Decimal         @default(0) @db.Decimal(18, 2)
  leaveAllowance              Decimal         @default(0) @db.Decimal(18, 2)
  entertainmentAllowance      Decimal         @default(0) @db.Decimal(18, 2)
  utilityAllowance            Decimal         @default(0) @db.Decimal(18, 2)
  otherAllowances             Decimal         @default(0) @db.Decimal(18, 2)
  overtimeEarnings            Decimal         @default(0) @db.Decimal(18, 2)
  bonusKpi                    Decimal         @default(0) @db.Decimal(18, 2)
  grossSalary                 Decimal         @default(0) @db.Decimal(18, 2)

  // Statutory Deductions
  pensionEmployee             Decimal         @default(0) @db.Decimal(18, 2)
  pensionEmployer             Decimal         @default(0) @db.Decimal(18, 2)
  nhf                         Decimal         @default(0) @db.Decimal(18, 2)
  nhis                        Decimal         @default(0) @db.Decimal(18, 2)
  totalStatutoryDeductions    Decimal         @default(0) @db.Decimal(18, 2)

  // Tax Calculation (Nigeria 2026)
  annualGrossIncome           Decimal         @default(0) @db.Decimal(18, 2)
  rentRelief                  Decimal         @default(0) @db.Decimal(18, 2)
  consolidatedReliefAllowance Decimal         @default(0) @db.Decimal(18, 2)
  annualChargeableIncome      Decimal         @default(0) @db.Decimal(18, 2)
  annualPAYE                  Decimal         @default(0) @db.Decimal(18, 2)
  monthlyPAYE                 Decimal         @default(0) @db.Decimal(18, 2)

  // Other Deductions
  unionDues                   Decimal         @default(0) @db.Decimal(18, 2)
  cooperativeDeduction        Decimal         @default(0) @db.Decimal(18, 2)
  loanRepayment               Decimal         @default(0) @db.Decimal(18, 2)
  otherDeductions             Decimal         @default(0) @db.Decimal(18, 2)
  totalDeductions             Decimal         @default(0) @db.Decimal(18, 2)

  // Net Salary
  netSalary                   Decimal         @default(0) @db.Decimal(18, 2)

  // Status
  paymentStatus               PaymentStatus   @default(PENDING)
  validationStatus            ValidationStatus?
  withheldReason              String?

  // Banking Details (denormalized for reports)
  bankName                    String?
  accountNumber               String?
  accountName                 String?
  pensionFundAdministrator    String?
  pensionPin                  String?

  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  payPeriod                   PayPeriod       @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  staff                       StaffRecord     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  company                     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([payPeriodId, staffId])
  @@index([payPeriodId, paymentStatus])
  @@index([payPeriodId, departmentId])
  @@index([staffId])
  @@index([companyId])
  @@map("computed_payslips")
}