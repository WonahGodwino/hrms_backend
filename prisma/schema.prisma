model PayrollTemplate {
  id                 String   @id @default(cuid())
  companyId          String
  templateName       String
  sections           Json
  isSystem           Boolean  @default(false)
  payslipCompanyName String?
  createdBy          String
  updatedBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Client billing — opt-in, for a template that runs Payroll Generation on
  // behalf of a client (e.g. an HR outsourcing agency) and needs to invoice
  // that client a management fee + VAT on top of the payroll cost. Per
  // template (not per company) since one company can run several templates
  // for different clients, each with its own negotiated terms. Hidden
  // entirely in the Review/Approval UI when disabled; the two percentages
  // are only meaningful once enabled.
  payrollInvoicingEnabled     Boolean  @default(false)
  payrollManagementFeePercent Decimal? @db.Decimal(5, 2)
  payrollVatPercent           Decimal? @db.Decimal(5, 2)

  // Pension/NSITF calculation base — NIGERIA_PENSION_EMPLOYEE,
  // NIGERIA_PENSION_EMPLOYER, NIGERIA_NSITF calculators only. Does NOT affect
  // NIGERIA_PAYE_2025's own tax basis or PERCENTAGE fields based on Gross
  // Earnings — both stay exactly as they are regardless of this setting.
  //   BHT      (default) — formulaConfig.basicField/housingField/transportField
  //             name three other fields; amount = (basic+housing+transport) * rate/100.
  //             Exactly today's behavior for every existing template.
  //   STANDARD — amount = gross * rate/100 (the standalone Gross figure,
  //             GROSS_SYSTEM_FIELD = 'gross'). basicField/housingField/
  //             transportField are unused in this mode.
  pensionCalculationBase String @default("BHT")

  // Optional company Payslip Preset: when set, payslip PDFs generated from
  // this template are rendered with the preset's HTML layout instead of the
  // built-in PDFKit generators. NULL = default system layout (unchanged).
  payslipPresetId String?
  payslipPreset   PayslipPreset? @relation(fields: [payslipPresetId], references: [id], onDelete: SetNull)

  company                  Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fields                   PayrollTemplateField[]
  payrollData              PayrollData[]
  payrolls                 Payroll[]
  uploads                  PayrollTemplateUpload[]
  payrollUploads           PayrollUpload[]
  payrollProfiles          StaffPayrollProfile[]
  payrollGenerationRuns    PayrollGenerationRun[]
  staffCompensationUploads StaffCompensationUpload[]

  @@index([companyId])
  @@index([isSystem])
  @@index([createdAt])
  @@map("payroll_templates")
}

model PayrollTemplateField {
  id            String   @id @default(cuid())
  templateId    String
  section       String
  displayName   String
  systemField   String
  dataType      String
  required      Boolean  @default(false)
  aliases       Json?
  showOnPayslip Boolean  @default(false)
  order         Int
  createdBy     String
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Payroll Generation (additive, does not affect the manual upload path,
  // which never reads these columns) — how this field's value should be
  // resolved when auto-generating a payroll run instead of parsing it from
  // an uploaded spreadsheet cell. See backend/src/app/lib/payroll/generation/.
  //   MANUAL         — left blank for HR to fill in during review (default,
  //                     matches today's fully-manual behavior)
  //   FIXED_PROFILE  — pulled from the staff's StaffPayrollProfile.values
  //   PERCENTAGE     — formulaConfig: { of: string; percent: number; min?: number; max?: number }
  //   SYSTEM_CALC    — formulaConfig: { calculator: string } e.g. 'NIGERIA_PAYE'
  valueSource   String @default("MANUAL")
  formulaConfig Json?

  template PayrollTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, systemField])
  @@index([templateId, section])
  @@index([templateId, order])
  @@map("payroll_template_fields")
}

// A company-scoped payslip LAYOUT preset: an HTML template with
// {{placeholder}} tokens that the payslip renderer interpolates with real
// payroll data before printing to PDF via puppeteer. Selected per payroll
// template (PayrollTemplate.payslipPresetId); NULL there means the built-in
// default system layout. Companies can add as many presets as they like.
model PayslipPreset {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  htmlContent String   @db.Text
  isActive    Boolean  @default(true)
  isSeed      Boolean  @default(false)
  createdBy   String
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrollTemplates PayrollTemplate[]

  @@index([companyId])
  @@map("payslip_presets")
}

model PayrollData {
  id          String    @id @default(cuid())
  companyId   String
  templateId  String
  staffId     String
  payPeriod   String
  data        Json
  status      String    @default("DRAFT")
  processedBy String?
  processedAt DateTime?
  createdBy   String
  updatedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Payroll Generation (additive) — populated only for rows created by the
  // auto-generation flow (backend/src/app/lib/payroll/generation/); null for
  // any row from another source. `status` starts using real values here
  // (GENERATED/APPROVED/REJECTED) — previously always 'DRAFT' and unused,
  // since no code path wrote to this table before this feature.
  generatedBy String?
  approvedBy  String?
  approvedAt  DateTime?
  payrollId   String?

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template PayrollTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  staff    StaffRecord     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([companyId, staffId, payPeriod])
  @@index([companyId, payPeriod, status])
  @@index([templateId, payPeriod])
  @@index([createdAt])
  @@map("payroll_data")
}

// Recurring compensation baseline for a staff member — the "fixed"
// Basic/Housing/Transport/etc. figures that barely change month to month,
// so Payroll Generation doesn't require HR to retype them every period.
// Seeded either via the compensation bulk-upload endpoint (reusing the same
// spreadsheet shape as the existing payroll template) or edited per-staff
// from the Staff Management edit drawer. Keyed by systemField, mirroring the
// same JSON-dictionary convention already used by Payroll.customFields.
model StaffPayrollProfile {
  id         String   @id @default(cuid())
  staffId    String   @unique
  companyId  String
  templateId String
  values     Json
  updatedBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  staff    StaffRecord     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template PayrollTemplate @relation(fields: [templateId], references: [id])

  @@index([companyId])
  @@index([templateId])
  @@map("staff_payroll_profiles")
}

// One row per "HR clicked Generate" — the job/history record for a Payroll
// Generation run, mirroring the existing PayrollUpload job-tracking pattern
// for the (untouched) manual upload flow. Its PayrollData rows (status
// GENERATED while under review) are what the review page edits; approving
// the run finalizes them into real Payroll/Payslip records.
model PayrollGenerationRun {
  id                  String    @id @default(cuid())
  companyId           String
  templateId          String
  payPeriod           String
  status              String    @default("GENERATED")
  totalStaff          Int
  flaggedCount        Int       @default(0)
  triggeredBy         String
  approvedBy          String?
  approvedAt          DateTime?
  // Set once per run, not per staff — the number of working days HR is
  // counting for this specific pay period (e.g. 26). Nullable so older runs
  // created before this field existed don't break; new runs always require
  // it (enforced in the route, not the DB) so attendance-based proration has
  // something to divide by.
  workingDaysInAMonth Int?
  // Staff excluded from this specific company+template+payPeriod run (e.g.
  // on unpaid leave that period). Chosen fresh per period on the Generate
  // form, or via the review page's Exclude action; re-editable on regenerate.
  excludedStaffIds    String[]  @default([])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template PayrollTemplate @relation(fields: [templateId], references: [id])

  @@index([companyId, payPeriod])
  @@index([templateId])
  @@map("payroll_generation_runs")
}

// Tracks one "Export Company Data" request — a curated, multi-sheet .xlsx
// covering the domains the requester picked (Staff, Payroll Summary, Leave,
// etc.), generated in the background the same way staff bulk-edit/payroll
// uploads are (status column here, not a generic Job table). Doubles as the
// audit trail for who pulled sensitive (unmasked bank/BVN/tax) data and when.
model CompanyExportJob {
  id                   String    @id @default(cuid())
  companyId            String
  requestedBy          String
  domains              Json // string[] of the sheet keys selected
  includeSensitiveData Boolean   @default(false)
  attendanceFrom       DateTime?
  attendanceTo         DateTime?
  status               String    @default("PROCESSING") // PROCESSING | COMPLETED | FAILED
  filePath             String?
  fileName             String?
  rowCounts            Json? // { [domain]: number } once complete
  errorMessage         String?
  startedAt            DateTime  @default(now())
  completedAt          DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_export_jobs")
}

// History of Staff Compensation Upload submissions — so HR can look back at
// what was uploaded and when, and re-download the original file to reuse
// (as-is, or lightly edited) for a later rollout instead of rebuilding it
// from scratch. Purely an audit trail: it doesn't drive anything itself —
// StaffPayrollProfile.values is still the live data Payroll Generation
// reads, and stays correct regardless of whether this history exists.
model StaffCompensationUpload {
  id           String   @id @default(cuid())
  companyId    String
  templateId   String
  fileName     String
  filePath     String
  totalRecords Int
  successful   Int
  failed       Int
  errors       Json?
  uploadedBy   String
  createdAt    DateTime @default(now())

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template PayrollTemplate @relation(fields: [templateId], references: [id])

  @@index([companyId, createdAt])
  @@index([templateId])
  @@map("staff_compensation_uploads")
}

model PayrollTemplateUpload {
  id                String   @id @default(cuid())
  companyId         String
  templateId        String
  fileName          String
  filePath          String
  processedFilePath String?
  processedFileName String?
  totalRecords      Int
  successful        Int
  failed            Int
  errors            String[]
  createdBy         String
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template PayrollTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([templateId])
  @@map("payroll_template_uploads")
}

