// Update Department model
model Department {
  id               String                   @id @default(cuid())
  name             String
  code             String
  // Denormalised business unit NAME (legacy / display). The canonical link is
  // businessUnitId → BusinessUnit; the name string is kept in sync for back-compat.
  businessUnit     String?
  businessUnitId   String?
  companyId        String
  headId           String?
  assistantHeadId  String?
  status           String                   @default("Active")
  activeHeadcount  Int?                     @default(0)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  maxHeadcount     Int?
  costCenter       String?
  budgetCode       String?
  positionCapacity Json?
  company          Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff            StaffRecord[]
  jobs             Job[]
  head             StaffRecord?             @relation("DepartmentHead", fields: [headId], references: [id])
  assistantHead    StaffRecord?             @relation("DepartmentAssistantHead", fields: [assistantHeadId], references: [id])
  businessUnitRef  BusinessUnit?            @relation(fields: [businessUnitId], references: [id])
  auditLogs        DepartmentAuditLog[]
  staffHistory     DepartmentStaffHistory[]
  transferredFrom  DepartmentStaffHistory[] @relation("FromDepartmentTransfer")
  transferredTo    DepartmentStaffHistory[] @relation("ToDepartmentTransfer")
  offboardings     Offboarding[]            @relation("OffboardingDepartment")
  lineManagers     DepartmentLineManager[]

  designations             Designation[]
  competencyMappings       CompetencyDepartmentMapping[]
  templateAssignmentScopes TemplateAssignmentDepartmentScope[]
  appraisalCycleScopes     AppraisalCycleDepartmentScope[]
  appraisalParticipants    AppraisalCycleParticipant[]
  goals                    Goal[]
  orgObjectives            OrgObjective[]
  goalActivities           GoalActivity[]
  goalAiAnalyses           GoalAiAnalysis[]
  appraisalEscalations     AppraisalEscalation[]
  opsNotes                 PerformanceOpsNote[]
  calibrationSessions      CalibrationSession[]
  recognitions             Recognition[]
  pips                     Pip[]
  promotionRecommendations PromotionRecommendation[]
  fairnessSignals          FairnessSignal[]
  fairnessCases            FairnessCase[]

  @@unique([companyId, code])
  // Case-insensitive name uniqueness per company is enforced by a functional
  // unique index on (companyId, lower(name)) — see migration
  // 20260711020000_department_unique_name. Prisma can't express expression
  // indexes in the schema, so it lives in the migration and app-level checks
  // compare with mode: 'insensitive'. Stored names keep their original casing.
  @@index([companyId])
  @@index([status])
  @@index([businessUnitId])
  @@map("departments")
}

// A Business Unit groups departments under a common cost centre / leadership.
// Company-scoped (multi-tenant). Departments link via Department.businessUnitId
// (canonical) while Department.businessUnit keeps the denormalised name.
model BusinessUnit {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  code            String?
  costCenter      String?
  description     String?  @db.Text
  headId          String?
  assistantHeadId String?
  status          String   @default("Active") // Active | Inactive
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  archived        Int?     @default(0)

  company       Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  head          StaffRecord?           @relation("BusinessUnitHead", fields: [headId], references: [id])
  assistantHead StaffRecord?           @relation("BusinessUnitAssistantHead", fields: [assistantHeadId], references: [id])
  departments   Department[]
  auditLogs     BusinessUnitAuditLog[]

  @@index([companyId, status])
  @@index([companyId, archived])
  @@map("business_units")
}

model BusinessUnitAuditLog {
  id              String   @id @default(cuid())
  businessUnitId  String
  companyId       String
  action          String
  performedBy     String?
  performedByName String?
  details         String?  @db.Text
  createdAt       DateTime @default(now())

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@index([businessUnitId, createdAt])
  @@index([companyId])
  @@map("business_unit_audit_logs")
}

// A temporary elevation of a staff member's access role within a company (e.g. a
// developer given HR access to sit on an interview panel). It's an OVERLAY: the
// staff's base role is never mutated. While ACTIVE (and not past expiresAt) the
// auth layer resolves the elevated role; on revoke/expiry it falls back to base.
model RoleElevation {
  id            String    @id @default(cuid())
  companyId     String
  staffId       String // StaffRecord being elevated
  fromRole      String // base role captured at grant time (display only)
  toRole        String // elevated role: ADMIN | HR
  reason        String    @db.Text
  status        String    @default("ACTIVE") // ACTIVE | REVOKED | EXPIRED
  grantedBy     String // StaffRecord id of the granter
  grantedByName String?
  grantedByRole String?
  revokedBy     String?
  revokedByName String?
  revokedAt     DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff   StaffRecord @relation("StaffRoleElevations", fields: [staffId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([staffId, status])
  @@map("role_elevations")
}

// Add DepartmentStaffHistory model for tracking staff movements
model DepartmentStaffHistory {
  id               String   @id @default(cuid())
  staffId          String
  departmentId     String
  companyId        String
  action           String
  fromDepartmentId String?
  toDepartmentId   String?
  oldPosition      String?
  newPosition      String?
  reason           String?
  effectiveDate    DateTime @default(now())
  performedBy      String
  createdAt        DateTime @default(now())

  staff          StaffRecord @relation(fields: [staffId], references: [id], onDelete: Cascade)
  department     Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromDepartment Department? @relation("FromDepartmentTransfer", fields: [fromDepartmentId], references: [id])
  toDepartment   Department? @relation("ToDepartmentTransfer", fields: [toDepartmentId], references: [id])

  @@index([staffId, effectiveDate])
  @@index([departmentId, effectiveDate])
  @@index([companyId])
  @@map("department_staff_history")
}

model DepartmentAuditLog {
  id           String   @id @default(cuid())
  departmentId String
  companyId    String
  action       String
  userId       String?
  userName     String?
  type         String?
  details      Json?
  timestamp    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([departmentId, timestamp])
  @@index([companyId, timestamp])
  @@index([type])
  @@map("department_audit_logs")
}

// ==================== LOANS & BENEFITS MODULE (REBUILT) ====================
// Ground-up rebuild: multi-step configurable approval chains (role, dynamic
// line-manager, or Designation-based steps — see ApprovalStepConfig in
// backend/src/app/lib/staff-loans-benefits/types.ts), a persisted
// installment-level repayment schedule (replaces the old on-the-fly
// DeductionEntry summation, which couldn't distinguish concurrent loans for
// the same staff member), and policy versioning (every request/allocation/
// claim snapshots its policy's terms + approvalWorkflow at submission time,
// so republishing a policy never rewrites an in-flight request).

enum LoanRequestStatus {
  PENDING_GUARANTOR
  PENDING_APPROVAL
  APPROVED
  REJECTED
  DISBURSED
  REPAID
  DEFAULTED
  CANCELLED
}

enum LoanInstallmentStatus {
  SCHEDULED
  DUE
  PARTIALLY_PAID
  PAID
  MISSED
  WAIVED
}

enum GuarantorStatus {
  NOT_REQUIRED
  PENDING
  ACCEPTED
  DECLINED
}

enum BenefitRequestStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum BenefitAllocationStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum ClaimStatus {
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum ApprovableRequestType {
  LOAN_REQUEST
  BENEFIT_REQUEST
  BENEFIT_CLAIM
}

enum ApprovalActionType {
  APPROVED
  REJECTED
}

model LoanRequest {
  id                     String            @id @default(cuid())
  companyId              String
  staffId                String
  loanPolicyId           String
  loanPolicyVersion      Int
  loanType               String // denormalized policy name at submission time
  requestedAmount        Decimal           @db.Decimal(18, 2)
  approvedAmount         Decimal?          @db.Decimal(18, 2)
  tenureMonths           Int
  purpose                String?
  currencyCode           String            @db.VarChar(3) // snapshot of Company.baseCurrency
  interestRatePercent    Decimal           @db.Decimal(5, 2) // snapshot (matrix-resolved if applicable)
  processingFeePercent   Decimal           @default(0) @db.Decimal(5, 2)
  processingFeeAmount    Decimal           @default(0) @db.Decimal(18, 2)
  monthlyRepayment       Decimal?          @db.Decimal(18, 2)
  totalRepayable         Decimal?          @db.Decimal(18, 2)
  remainingBalance       Decimal?          @db.Decimal(18, 2) // actively maintained, unlike the old dead field
  status                 LoanRequestStatus @default(PENDING_GUARANTOR)
  approvalWorkflow       Json // snapshot: ApprovalStepConfig[]
  currentStepOrder       Int? // null once terminal
  currentApproverRole    String? // denormalized for index-friendly Approvals Dashboard queries
  currentApproverStaffId String? // populated once a LINE_MANAGER/DESIGNATION step is resolved
  rejectionReason        String?
  rejectedAtStep         Int?
  rejectedByRole         String?
  approvedAt             DateTime?
  disbursedAt            DateTime?
  disbursedBy            String?
  expectedRepaymentDate  DateTime?
  signature              String?           @db.Text
  signatureType          String?           @db.VarChar(20)
  signedAt               DateTime?
  documentUrls           Json? // uploaded supporting documents
  guarantorStaffId       String?
  guarantorStatus        GuarantorStatus   @default(NOT_REQUIRED)
  guarantorToken         String?           @unique
  guarantorTokenExpiry   DateTime?
  guarantorRespondedAt   DateTime?
  guarantorDeclineReason String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  createdBy              String

  company      Company           @relation("CompanyLoanRequests", fields: [companyId], references: [id], onDelete: Cascade)
  staff        StaffRecord       @relation("StaffLoanRequests", fields: [staffId], references: [id], onDelete: Cascade)
  guarantor    StaffRecord?      @relation("LoanGuarantor", fields: [guarantorStaffId], references: [id])
  policy       LoanPolicy        @relation(fields: [loanPolicyId], references: [id])
  installments LoanInstallment[]

  @@index([companyId, status])
  @@index([staffId])
  @@index([guarantorStaffId])
  @@index([companyId, status, currentApproverRole])
  @@map("loan_requests")
}

model LoanInstallment {
  id                     String                @id @default(cuid())
  loanRequestId          String
  companyId              String // denormalized for scoped queries
  installmentNumber      Int
  dueDate                DateTime
  principalDue           Decimal               @db.Decimal(18, 2)
  interestDue            Decimal               @db.Decimal(18, 2)
  totalDue               Decimal               @db.Decimal(18, 2)
  amountPaid             Decimal               @default(0) @db.Decimal(18, 2)
  status                 LoanInstallmentStatus @default(SCHEDULED)
  paidAt                 DateTime?
  recoveryMethod         String? // SALARY_DEDUCTION | GUARANTOR_COVERAGE | MANUAL_PAYMENT | TERMINAL_BENEFITS
  recoveryNote           String? // required for Force Recovery audit trail
  recordedBy             String?
  payrollGenerationRunId String? // set when auto-deducted via Payroll Generation
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  loanRequest LoanRequest @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)

  @@unique([loanRequestId, installmentNumber])
  @@index([companyId, status, dueDate])
  @@map("loan_installments")
}

model BenefitRequest {
  id                     String               @id @default(cuid())
  companyId              String
  staffId                String
  benefitPolicyId        String
  benefitPolicyVersion   Int
  benefitName            String
  requestedAmount        Decimal?             @db.Decimal(18, 2) // Financial-category conditional amount
  currencyCode           String               @db.VarChar(3)
  expectedStartDate      DateTime?
  reason                 String?
  status                 BenefitRequestStatus @default(PENDING_APPROVAL)
  approvalWorkflow       Json
  currentStepOrder       Int?
  currentApproverRole    String?
  currentApproverStaffId String?
  rejectionReason        String?
  approvedAt             DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  createdBy              String

  company Company       @relation("CompanyBenefitRequests", fields: [companyId], references: [id], onDelete: Cascade)
  staff   StaffRecord   @relation("StaffBenefitRequests", fields: [staffId], references: [id], onDelete: Cascade)
  policy  BenefitPolicy @relation(fields: [benefitPolicyId], references: [id])

  @@index([companyId, status, currentApproverRole])
  @@map("benefit_requests")
}

model BenefitAllocation {
  id                   String                  @id @default(cuid())
  companyId            String
  staffId              String
  benefitPolicyId      String
  benefitPolicyVersion Int
  benefitName          String
  sourceRequestId      String? // app-level link back to the originating BenefitRequest, if any
  allocationAmount     Decimal                 @db.Decimal(18, 2)
  currencyCode         String                  @db.VarChar(3)
  amountUsed           Decimal                 @default(0) @db.Decimal(18, 2)
  status               BenefitAllocationStatus @default(ACTIVE)
  effectiveDate        DateTime                @default(now())
  expiryDate           DateTime?
  allocatedBy          String?
  note                 String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  company   Company        @relation("CompanyBenefitAllocations", fields: [companyId], references: [id], onDelete: Cascade)
  staff     StaffRecord    @relation("StaffBenefitAllocations", fields: [staffId], references: [id], onDelete: Cascade)
  allocator StaffRecord?   @relation("BenefitAllocator", fields: [allocatedBy], references: [id])
  policy    BenefitPolicy  @relation(fields: [benefitPolicyId], references: [id])
  claims    BenefitClaim[]

  @@index([staffId, companyId])
  @@index([companyId, createdAt])
  @@map("benefit_allocations")
}

model BenefitClaim {
  id                     String      @id @default(cuid())
  companyId              String
  staffId                String
  benefitAllocationId    String?
  benefitPolicyId        String
  benefitPolicyVersion   Int
  benefitName            String
  amount                 Decimal     @db.Decimal(18, 2)
  currencyCode           String      @db.VarChar(3)
  expenseDate            DateTime
  description            String?     @db.Text
  attachmentUrls         Json?
  status                 ClaimStatus @default(SUBMITTED)
  approvalWorkflow       Json
  currentStepOrder       Int?
  currentApproverRole    String?
  currentApproverStaffId String?
  rejectionReason        String?
  paidAt                 DateTime?
  paidAmount             Decimal?    @db.Decimal(18, 2)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  createdBy              String

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff      StaffRecord        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  allocation BenefitAllocation? @relation(fields: [benefitAllocationId], references: [id])
  policy     BenefitPolicy      @relation(fields: [benefitPolicyId], references: [id])

  @@index([companyId, status, currentApproverRole])
  @@map("benefit_claims")
}

// Per-company, per-page department/designation allow-list for the Staff
// Loans & Benefits admin pages (Financial Dashboard, Loan Management, Loan
// Policy Config, Benefit Policy Config, Benefit Allocation). A page with no
// row here is SUPER_ADMIN-only ("locked down until configured"); once a row
// exists, access = SUPER_ADMIN OR staff.departmentId in departmentIds OR
// staff.designationId in designationIds — platform role no longer matters
// for these five pages. See backend/src/app/lib/staff-loans-benefits/page-access.ts.
model LoansBenefitsPageAccess {
  id             String   @id @default(cuid())
  companyId      String
  pageKey        String // FINANCIAL_DASHBOARD | LOAN_MANAGEMENT | LOAN_POLICY_CONFIG | BENEFIT_POLICY_CONFIG | BENEFIT_ALLOCATION
  departmentIds  Json     @default("[]") // string[] of Department.id
  designationIds Json     @default("[]") // string[] of Designation.id
  updatedAt      DateTime @updatedAt
  updatedBy      String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, pageKey])
  @@map("staff_loans_benefits_page_access")
}

// Append-only audit trail for the multi-step approval engine — mirrors the
// existing, production-proven PhedApprovalStamp pattern (denormalized actor
// snapshot so history survives even if the actor's profile later changes).
// Never used for routing — routing state lives on the request row itself.
model ApprovalActionLog {
  id           String                @id @default(cuid())
  companyId    String
  requestType  ApprovableRequestType
  requestId    String // app-level FK into LoanRequest/BenefitRequest/BenefitClaim.id — no Prisma relation
  stepOrder    Int
  stepRole     String // snapshot of the resolved role/designation label for this step
  action       ApprovalActionType
  actorStaffId String
  actorName    String
  actorRole    String
  comment      String?
  createdAt    DateTime              @default(now())

  @@index([companyId, requestType, requestId])
  @@map("approval_action_logs")
}

enum FilingStatus {
  PENDING
  GENERATED
  FILED
  CONFIRMED
}

enum SeniorityBand {
  ENTRY
  JUNIOR
  MID
  SENIOR
  LEAD
  EXECUTIVE
  DIRECTOR
}

enum BasePayFrequency {
  Yearly
  Monthly
  BiWeekly
}

// Designation model
model Designation {
  id               String                  @id @default(cuid())
  companyId        String?
  title            String
  code             String
  departmentId     String?
  department       Department?             @relation(fields: [departmentId], references: [id])
  roleMappings     CompetencyRoleMapping[]
  description      String?                 @db.Text
  status           String                  @default("Active")
  staffCount       Int                     @default(0)

  // Seniority & hierarchy (Workaround A: embeds seniority & pay bands, replaces standalone GradeLevel)
  rank             Int                     @default(1)
  seniorityBand    SeniorityBand           @default(MID)
  minSalary        Decimal?                @db.Decimal(18, 2)
  maxSalary        Decimal?                @db.Decimal(18, 2)
  basePay          Float?
  basePayFrequency BasePayFrequency?       @default(Monthly)
  benefits         Json?
  staffRecords     StaffRecord[]
  jobs             Job[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  company               Company?                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  promotionsFrom        PromotionRecommendation[] @relation("PromotionCurrentDesignation")
  promotionsTo          PromotionRecommendation[] @relation("PromotionTargetDesignation")
  careerHistoryOld      StaffCareerHistory[]      @relation("CareerOldDesignation")
  careerHistoryNew      StaffCareerHistory[]      @relation("CareerNewDesignation")
  appraisalParticipants AppraisalCycleParticipant[]
  pips                  Pip[]
  criticalRoles         CriticalRole[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, rank])
  @@index([companyId, seniorityBand])
}

// Workaround A: Tracks designation and seniority transitions over time (replaces StaffGradeHistory)
model StaffCareerHistory {
  id                    String       @id @default(cuid())
  companyId             String
  staffId               String
  previousDesignationId String?
  newDesignationId      String
  effectiveDate         DateTime
  reason                String?      // e.g. "Performance Promotion", "Role Reassignment"
  promotionRecId        String?      // Optional link to PromotionRecommendation

  company               Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff                 StaffRecord  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  previousDesignation   Designation? @relation("CareerOldDesignation", fields: [previousDesignationId], references: [id])
  newDesignation        Designation  @relation("CareerNewDesignation", fields: [newDesignationId], references: [id])

  createdAt             DateTime     @default(now())

  @@index([companyId, staffId, effectiveDate])
  @@index([previousDesignationId])
  @@index([newDesignationId])
  @@map("staff_career_histories")
}

model Benefit {
  id          String   @id @default(cuid())
  label       String   @unique
  type        String
  description String?
  companyId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
}

// Company-wide salary calculation formulas
model CompanySalaryFormula {
  id                String   @id @default(cuid())
  companyId         String   @unique
  name              String
  description       String?
  baseFormula       Json // JSON formula definition
  allowancesFormula Json // JSON allowances calculation rules
  deductionsFormula Json // JSON deductions calculation rules
  isActive          Boolean  @default(true)
  version           Int      @default(1)
  createdBy         String
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_salary_formulas")
}

// ─── Staff Loans & Benefits ───
// Every request/allocation/claim snapshots its policy's terms + workflow at
// submission time (loanPolicyVersion / benefitPolicyVersion), so publishing
// a new policy version never retroactively rewrites an in-flight request.

model LoanPolicy {
  id                             String   @id @default(cuid())
  companyId                      String
  name                           String
  isActive                       Boolean  @default(true)
  version                        Int      @default(1)
  status                         String   @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED
  minServiceMonths               Int      @default(3)
  maxDebtRatioPercent            Decimal  @default(40) @db.Decimal(5, 2)
  eligibilityRules               Json? // EligibilityRule[]
  maxAmount                      Decimal  @default(500000) @db.Decimal(18, 2)
  salaryMultiplier               Decimal  @default(1.0) @db.Decimal(5, 2)
  maxDurationMonths              Int      @default(12)
  interestRatePercent            Decimal  @default(5) @db.Decimal(5, 2)
  interestByDuration             Json? // { "3": 2.5, "6": 4, "12": 5 } optional matrix override
  processingFeePercent           Decimal  @default(0) @db.Decimal(5, 2)
  autoDeductionEnabled           Boolean  @default(true) // gates Payroll Generation linkage
  gracePeriodDays                Int      @default(0)
  requiresGuarantor              Boolean  @default(false)
  guarantorThresholdAmount       Decimal? @db.Decimal(18, 2)
  guarantorMustBeActiveInCompany Boolean  @default(true)
  guarantorMustNotHaveActiveLoan Boolean  @default(true)
  maxGuarantorExposure           Decimal? @db.Decimal(18, 2)
  maxActiveLoansPerStaff         Int      @default(1)
  approvalWorkflow               Json // ApprovalStepConfig[], >=1 step, validated at save
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
  createdBy                      String
  updatedBy                      String?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  loanRequests LoanRequest[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("loan_policies")
}

model BenefitPolicy {
  id                      String   @id @default(cuid())
  companyId               String
  name                    String
  category                String
  benefitType             String   @default("FIXED_AMOUNT") // FIXED_AMOUNT | REIMBURSEMENT | NON_MONETARY
  description             String?  @db.Text
  monetaryValue           Decimal? @db.Decimal(18, 2)
  keyValue                String?
  isActive                Boolean  @default(true)
  version                 Int      @default(1)
  status                  String   @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED
  eligibilityRules        Json? // EligibilityRule[]
  // Optional job/designation scope. FKs enforced in SQL only (no Prisma
  // relation) so the generated client is not required to read/write these —
  // same deliberate convention as before.
  jobId                   String?
  designationId           String?
  usageLimitAmount        Decimal? @db.Decimal(18, 2)
  usageFrequency          String? // MONTHLY | QUARTERLY | ANNUAL | ONE_TIME
  rollingValidityMonths   Int?
  maxUsagePerEmployee     Decimal? @db.Decimal(18, 2)
  maxClaimAmount          Decimal? @db.Decimal(18, 2)
  carryOverAllowed        Boolean  @default(false)
  requiresClaimSubmission Boolean  @default(false)
  requiresClaimApproval   Boolean  @default(true)
  requestApprovalWorkflow Json // ApprovalStepConfig[] — for the Request/Enroll flow
  claimApprovalWorkflow   Json? // ApprovalStepConfig[] — for claims, e.g. HR Review -> Finance Processing
  totalAllocatedBudget    Decimal? @db.Decimal(18, 2)
  perEmployeeCap          Decimal? @db.Decimal(18, 2)
  departmentalCaps        Json? // { [departmentId]: amount }
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  createdBy               String
  updatedBy               String?

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  benefitRequests    BenefitRequest[]
  benefitAllocations BenefitAllocation[]
  benefitClaims      BenefitClaim[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@index([companyId, jobId])
  @@index([companyId, designationId])
  @@map("benefit_policies")
}

// Required onboarding documents uploaded by a new hire (STAFF). One row per
// category per staff (re-upload replaces). Bytes are stored in the DB.
model StaffOnboardingDocument {
  id         String   @id @default(cuid())
  companyId  String
  staffId    String
  category   String // MEANS_OF_ID | GUARANTOR_FORM | SIGNED_OFFER
  fileName   String
  mimeType   String
  sizeBytes  Int
  data       Bytes
  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([staffId, category])
  @@index([companyId, staffId])
  @@map("staff_onboarding_documents")
}

// Add to schema.prisma

enum OffboardingType {
  RESIGNATION
  TERMINATION
  RETIREMENT
}

enum OffboardingStatus {
  PENDING_REVIEW
  NOTICE_PERIOD
  HANDOVER_REQUESTED
  HANDOVER_SUBMITTED
  COMPLETED
  REJECTED
}

enum InitiatedBy {
  STAFF
  HR
}

model Offboarding {
  id           String  @id @default(cuid())
  companyId    String
  staffId      String
  departmentId String?

  type        OffboardingType
  status      OffboardingStatus @default(PENDING_REVIEW)
  initiatedBy InitiatedBy

  // Resignation specific
  resignationLetter  String? // File URL/path
  resignationComment String?

  // Handover
  handoverRequired    Boolean   @default(true)
  handoverDocument    String? // File URL/path
  handoverSubmittedAt DateTime?

  // Review
  reviewComment String?
  reviewedBy    String?
  reviewedAt    DateTime?

  // Timestamps
  createdAt   DateTime  @default(now())
  submittedAt DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Staff who is being offboarded
  staff StaffRecord @relation("StaffOffboardings", fields: [staffId], references: [id], onDelete: Cascade)

  // Staff who reviewed this offboarding (HR/Admin)
  reviewer   StaffRecord? @relation("OffboardingReviewer", fields: [reviewedBy], references: [id])
  department Department?  @relation("OffboardingDepartment", fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([companyId, staffId, status])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([staffId])
  @@index([departmentId])
  @@index([createdAt])
  @@map("offboardings")
}

// Performance and Appraisal
// Competency Frameworks

enum CompetencyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CompetencyCategory {
  CORE
  LEADERSHIP
  TECHNICAL
  BEHAVIORAL
  COMPLIANCE
  OTHER
}

enum CompetencyReviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum CompetencyReviewOutcome {
  CONFIRMED // reviewed, no changes needed
  UPDATED // reviewed, changes made
  RETIRED // reviewed, archived
}

model Competency {
  id             String             @id @default(cuid())
  companyId      String
  name           String
  description    String?
  category       CompetencyCategory
  customCategory String?
  tags           String? // comma-separated, matches frontend's single text input (e.g. "core, executive")
  ownerId        String
  status         CompetencyStatus   @default(DRAFT)
  usageCount     Int                @default(0)

  // Optional override — if null, resolve to the company's isDefault ProficiencyScale
  scaleId String?

  isLeadership Boolean @default(false)

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner   StaffRecord       @relation("CompetencyOwner", fields: [ownerId], references: [id])
  scale   ProficiencyScale? @relation(fields: [scaleId], references: [id])

  benchmarks                  CompetencyBenchmark[]
  roleMappings                CompetencyRoleMapping[]
  departmentMappings          CompetencyDepartmentMapping[]
  history                     CompetencyHistory[]
  templateQuestions           TemplateQuestion[]
  questionBankItems           QuestionBankItem[]
  selfAppraisalRatings        SelfAppraisalCompetencyRating[]
  developmentPlans            DevelopmentPlan[]
  developmentCoachingRequests DevelopmentCoachingRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lastReviewedAt DateTime? // set when a governance review is signed off

  reviews              CompetencyReview[]
  duplicateDismissalsA CompetencyDuplicateDismissal[]  @relation("DismissalCompetencyA")
  duplicateDismissalsB CompetencyDuplicateDismissal[]  @relation("DismissalCompetencyB")
  managerReviewRatings ManagerReviewCompetencyRating[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, category])
  @@index([ownerId])
  @@index([scaleId])
}

model CompetencyBenchmark {
  id           String   @id @default(cuid())
  competencyId String
  level        String? // LEGACY — old free-text level, kept temporarily for backfill reference
  levelId      String? // FK into ProficiencyLevel — nullable until backfill runs
  description  String?
  behaviors    String[] @default([]) // matches frontend's array of behavioral indicator strings
  displayOrder Int      @default(0)

  competency Competency        @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  level_rel  ProficiencyLevel? @relation(fields: [levelId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([competencyId])
  @@index([levelId])
}

model CompetencyRoleMapping {
  id            String @id @default(cuid())
  competencyId  String
  designationId String
  requiredLevel Int?

  competency  Competency  @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  designation Designation @relation(fields: [designationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competencyId, designationId])
  @@index([designationId])
}

model CompetencyDepartmentMapping {
  id            String @id @default(cuid())
  competencyId  String
  departmentId  String
  requiredLevel Int?

  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competencyId, departmentId])
  @@index([departmentId])
}

model CompetencyHistory {
  id           String  @id @default(cuid())
  competencyId String
  companyId    String? // denormalized for direct company-scoped querying/indexing
  action       String
  actorId      String
  previousData Json?
  newData      Json?

  competency Competency  @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  actor      StaffRecord @relation("CompetencyHistoryActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([competencyId])
  @@index([actorId])
  @@index([createdAt])
  @@index([companyId, createdAt])
  @@index([competencyId, createdAt])
}

model CompetencyReview {
  id                    String                   @id @default(cuid())
  competencyId          String
  companyId             String // denormalized for company-scoped queries
  scheduledFor          DateTime
  assigneeId            String
  status                CompetencyReviewStatus   @default(SCHEDULED)
  outcome               CompetencyReviewOutcome?
  notes                 String?
  scheduledById         String
  completedById         String?
  completedAt           DateTime?
  dueSoonNotifiedAt     DateTime?
  lastOverdueNotifiedAt DateTime?

  competency  Competency   @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  assignee    StaffRecord  @relation("CompetencyReviewAssignee", fields: [assigneeId], references: [id])
  scheduledBy StaffRecord  @relation("CompetencyReviewScheduler", fields: [scheduledById], references: [id])
  completedBy StaffRecord? @relation("CompetencyReviewCompleter", fields: [completedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([competencyId])
  @@index([companyId, status, scheduledFor])
  @@index([assigneeId])
}

model CompetencyDuplicateDismissal {
  id            String @id @default(cuid())
  companyId     String
  competencyAId String // always the lexicographically smaller id of the pair
  competencyBId String
  dismissedById String

  competencyA Competency  @relation("DismissalCompetencyA", fields: [competencyAId], references: [id], onDelete: Cascade)
  competencyB Competency  @relation("DismissalCompetencyB", fields: [competencyBId], references: [id], onDelete: Cascade)
  dismissedBy StaffRecord @relation("DuplicateDismissedBy", fields: [dismissedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([competencyAId, competencyBId])
  @@index([companyId])
}

// Company-scoped, reusable proficiency scale (e.g. "Global Proficiency Scale")
model ProficiencyScale {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  description String?
  isDefault   Boolean @default(false)
  isActive    Boolean @default(true)

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  levels            ProficiencyLevel[]
  competencies      Competency[] // competencies explicitly overriding to this scale
  templateQuestions TemplateQuestion[]
  questionBankItems QuestionBankItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, isDefault])
}

// A single rung on a scale (e.g. "Novice" = level 1)
model ProficiencyLevel {
  id           String  @id @default(cuid())
  scaleId      String
  level        Int // semantic rank/score, used for comparisons (requiredLevel, etc.)
  name         String // "Novice", "Proficient", etc.
  description  String? // generic description shown in the scale editor modal
  displayOrder Int // position shown in UI; defaults to match `level` unless reordered

  scale      ProficiencyScale      @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  benchmarks CompetencyBenchmark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scaleId, level])
  @@index([scaleId])
}

enum TemplateType {
  PERFORMANCE_REVIEW
  FEEDBACK_360
  SELF_ASSESSMENT
  MANAGER_CHECKIN
  OTHER
}

enum TemplateVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  SUPERSEDED
}

enum QuestionType {
  RATING_SCALE
  TEXT
  MULTIPLE_CHOICE
  COMPETENCY_RATING
  GOAL_ASSESSMENT
}

enum AudienceType {
  SELF
  MANAGER
  PEER
  SKIP_LEVEL
  DIRECT_REPORT
}

// Deployment-time scope, distinct from AudienceType (who fills it out)
enum AssignmentScopeType {
  ALL_DEPARTMENTS
  SPECIFIC_DEPARTMENTS
  CUSTOM_GROUP
}

enum AssignmentStatus {
  ACTIVE
  UNASSIGNED
}

model ReviewTemplate {
  id          String       @id @default(cuid())
  companyId   String
  name        String
  description String?
  type        TemplateType
  customType  String?
  ownerId     String

  currentVersionId String?                @unique
  currentVersion   ReviewTemplateVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner   StaffRecord @relation("ReviewTemplateOwner", fields: [ownerId], references: [id])

  versions    ReviewTemplateVersion[] @relation("TemplateVersions")
  assignments TemplateAssignment[]
  history     TemplateHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, type])
  @@index([ownerId])
}

model ReviewTemplateVersion {
  id            String                @id @default(cuid())
  templateId    String
  versionNumber Int // sequential (v1, v2...); display-only "v2.4" formatting is a UI concern, not a data one
  status        TemplateVersionStatus @default(DRAFT)
  description   String? // shown as the changelog line in Version History

  template   ReviewTemplate  @relation("TemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  currentFor ReviewTemplate? @relation("CurrentVersion")

  sections       TemplateSection[]
  audienceScopes TemplateAudienceScope[] // who fills it out (Self/Manager/Peer) — structural to the form
  assignments    TemplateAssignment[]
  selfAppraisals SelfAppraisal[]
  managerReviews ManagerReview[]

  publishedAt DateTime?
  publishedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, versionNumber])
  @@index([status])
}

model TemplateSection {
  id           String  @id @default(cuid())
  versionId    String
  title        String
  description  String?
  weight       Int? // percentage contribution to overall score; sum across a version's sections should equal 100, enforced at service layer
  displayOrder Int

  version   ReviewTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  questions TemplateQuestion[]

  @@index([versionId])
}

model TemplateQuestion {
  id           String       @id @default(cuid())
  sectionId    String
  prompt       String
  questionType QuestionType
  required     Boolean      @default(true)
  displayOrder Int

  competencyId       String? // set only when questionType = COMPETENCY_RATING
  proficiencyScaleId String?
  config             Json?
  helpText           String?
  bankItemId         String?
  bankItem           QuestionBankItem? @relation(fields: [bankItemId], references: [id], onDelete: SetNull)

  section    TemplateSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  competency Competency?       @relation(fields: [competencyId], references: [id])
  scale      ProficiencyScale? @relation(fields: [proficiencyScaleId], references: [id])
  options    QuestionOption[]

  @@index([sectionId])
  @@index([competencyId])
}

model QuestionOption {
  id           String @id @default(cuid())
  questionId   String
  label        String
  value        String
  displayOrder Int

  question TemplateQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuestionBankItem {
  id           String       @id @default(cuid())
  companyId    String
  prompt       String
  questionType QuestionType
  category     String? // free-text grouping, e.g. "Leadership", "Goals" — for filtering in the sidebar
  isActive     Boolean      @default(true)

  competencyId       String?
  proficiencyScaleId String?
  config             Json?
  helpText           String?

  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  competency        Competency?          @relation(fields: [competencyId], references: [id])
  scale             ProficiencyScale?    @relation(fields: [proficiencyScaleId], references: [id])
  options           QuestionBankOption[]
  templateQuestions TemplateQuestion[]

  usageCount Int @default(0) // incremented when inserted into a template, mirrors Competency.usageCount

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, questionType])
  @@index([companyId, category])
}

model QuestionBankOption {
  id           String @id @default(cuid())
  bankItemId   String
  label        String
  value        String
  displayOrder Int

  bankItem QuestionBankItem @relation(fields: [bankItemId], references: [id], onDelete: Cascade)

  @@index([bankItemId])
}

model TemplateAudienceScope {
  id           String       @id @default(cuid())
  versionId    String
  audienceType AudienceType

  version ReviewTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, audienceType])
}

model TemplateAssignment {
  id           String              @id @default(cuid())
  templateId   String
  versionId    String
  cycleId      String // no FK yet — AppraisalCycle module not built
  scopeType    AssignmentScopeType @default(ALL_DEPARTMENTS)
  status       AssignmentStatus    @default(ACTIVE) // soft "unassign" instead of deleting the row
  assignedBy   String
  assignedAt   DateTime            @default(now())
  unassignedBy String?
  unassignedAt DateTime?
  phaseType    ReviewPhaseType?

  template ReviewTemplate        @relation(fields: [templateId], references: [id])
  version  ReviewTemplateVersion @relation(fields: [versionId], references: [id])
  cycle    AppraisalCycle        @relation(fields: [cycleId], references: [id])

  departmentScopes TemplateAssignmentDepartmentScope[]
  jobLevelScopes   TemplateAssignmentJobLevelScope[]

  @@index([cycleId])
  @@index([templateId])
  @@index([templateId, status])
  @@index([cycleId, phaseType, status])
}

// Only populated when scopeType = SPECIFIC_DEPARTMENTS
model TemplateAssignmentDepartmentScope {
  id           String @id @default(cuid())
  assignmentId String
  departmentId String // references existing HRMS Department

  assignment TemplateAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  department Department         @relation(fields: [departmentId], references: [id])

  @@unique([assignmentId, departmentId])
  @@index([departmentId])
}

// From the "Job Levels" checkboxes (Seniority Bands: Entry / Junior / Mid / Senior / Lead / Executive / Director)
model TemplateAssignmentJobLevelScope {
  id            String         @id @default(cuid())
  assignmentId  String
  seniorityBand SeniorityBand?

  assignment    TemplateAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, seniorityBand])
  @@index([assignmentId])
  @@index([seniorityBand])
}

model TemplateHistory {
  id           String  @id @default(cuid())
  templateId   String
  companyId    String?
  versionId    String?
  action       String
  actorId      String
  previousData Json?
  newData      Json?

  template ReviewTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  actor    StaffRecord    @relation("ReviewTemplateHistoryActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([templateId])
  @@index([actorId])
  @@index([createdAt])
  @@index([companyId, createdAt])
}

// Appraisal Cycles
enum AppraisalCycleType {
  ANNUAL
  BI_ANNUAL
  QUARTERLY
  PROJECT_BASED
  OTHER
}

enum AppraisalCycleStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  ESCALATED
  COMPLETED
  ARCHIVED
}

enum AppraisalCycleScopeType {
  ALL_DEPARTMENTS
  SPECIFIC_DEPARTMENTS
}

enum ReviewPhaseType {
  SELF_APPRAISAL
  MANAGER_REVIEW
  PEER_REVIEW
  LEADERSHIP_CALIBRATION
  HR_VALIDATION
}

enum ApprovalRoutingType {
  MANAGER_SKIPLEVEL_HR // "Direct Manager → Skip-Level Manager → HR"
  MANAGER_HR // "Direct Manager → HR Only"
  MANAGER_DEPTHEAD_HR // "Direct Manager → Department Head → HR"
}

enum ParticipantPhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum AppraisalReminderRecipient {
  EMPLOYEE
  DIRECT_MANAGER
  DEPARTMENT_HEAD
}

enum PeerAssignmentSource {
  AUTO // generated from org chart
  MANUAL
}

enum ParticipantEnrollment {
  ACTIVATION
  SYNC
}

enum ParticipantExclusionReason {
  MANUAL
  LEFT_COMPANY
}

model AppraisalCycle {
  id                  String                @id @default(cuid())
  companyId           String
  name                String
  type                AppraisalCycleType
  customType          String? // mirrors ReviewTemplate's OTHER + customType pattern
  status              AppraisalCycleStatus  @default(DRAFT)
  activatedAt         DateTime?
  pausedAt            DateTime?
  completedAt         DateTime?
  archivedAt          DateTime?
  statusBeforeArchive AppraisalCycleStatus?
  ownerId             String

  scopeType AppraisalCycleScopeType @default(ALL_DEPARTMENTS)

  startDate DateTime?
  endDate   DateTime?

  remindersEnabled         Boolean             @default(true)
  escalationEnabled        Boolean             @default(true)
  escalationThresholdHours Int?                @default(48) // "escalated if delayed more than 48 hours"
  approvalRouting          ApprovalRoutingType @default(MANAGER_SKIPLEVEL_HR)

  company         Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner           StaffRecord               @relation("AppraisalCycleOwner", fields: [ownerId], references: [id])
  minTenureMonths Int                       @default(0) // not enrolled if hired fewer than this many months before the start date
  exclusions      AppraisalCycleExclusion[]

  departmentScopes    AppraisalCycleDepartmentScope[]
  phases              AppraisalCyclePhase[]
  assignments         TemplateAssignment[] // now a REAL back-relation — was unvalidated cycleId before
  history             AppraisalCycleHistory[]
  participants        AppraisalCycleParticipant[]
  calibrationRecords  CalibrationRecord[]
  calibrationSessions CalibrationSession[]

  reminderLeadHours    Int                          @default(72)
  reminderRecipients   AppraisalReminderRecipient[] @default([EMPLOYEE, DIRECT_MANAGER, DEPARTMENT_HEAD])
  requireHrSignoff     Boolean                      @default(true)
  autoAdvanceApprovals Boolean                      @default(false)
  peersPerEmployee     Int                          @default(2)

  peerAssignments          AppraisalPeerAssignment[]
  selfAppraisals           SelfAppraisal[]
  goals                    Goal[]
  orgObjectives            OrgObjective[]
  managerReviews           ManagerReview[]
  escalations              AppraisalEscalation[]
  opsNotes                 PerformanceOpsNote[]
  bulkOperations           AppraisalBulkOperation[]
  policyExceptions         AppraisalPolicyException[]
  pips                     Pip[]
  promotionRecommendations PromotionRecommendation[]
  comparisonReports        ComparisonReport[]
  intelligenceReports      IntelligenceReport[]
  fairnessSignals          FairnessSignal[]
  fairnessDetectionRuns    FairnessDetectionRun[]
  fairnessCases            FairnessCase[]

  createdBy          String
  updatedBy          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  performanceActions PerformanceAction[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([ownerId])
}

model AppraisalCycleDepartmentScope {
  id           String @id @default(cuid())
  cycleId      String
  departmentId String // only populated when scopeType = SPECIFIC_DEPARTMENTS

  cycle      AppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  department Department     @relation(fields: [departmentId], references: [id])

  @@unique([cycleId, departmentId])
  @@index([departmentId])
}

model AppraisalCyclePhase {
  id           String          @id @default(cuid())
  cycleId      String
  phaseType    ReviewPhaseType
  enabled      Boolean         @default(true)
  deadline     DateTime?
  displayOrder Int

  cycle AppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cycleId, phaseType])
  @@index([cycleId])
}

model AppraisalCycleHistory {
  id           String  @id @default(cuid())
  cycleId      String
  companyId    String? // denormalized, same convention as TemplateHistory
  action       String // CREATED, ACTIVATED, SCHEDULED, PAUSED, RESUMED, ESCALATED, REMINDER_SENT, EDITED, ARCHIVED
  actorId      String
  previousData Json?
  newData      Json?

  cycle AppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  actor StaffRecord    @relation("AppraisalCycleHistoryActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([cycleId])
  @@index([actorId])
  @@index([createdAt])
  @@index([companyId, createdAt])
}

model AppraisalCycleParticipant {
  id                 String                @id @default(cuid())
  cycleId            String
  companyId          String
  staffRecordId      String
  departmentId       String? // snapshot of StaffRecord.departmentId at activation
  locationId         String? // snapshot of StaffRecord.locationId at activation (replaces the old `region` string)
  managerId          String? // snapshot of StaffRecord.managerId, needed later by Manager Review
  managerReview      ManagerReview?
  cycle              AppraisalCycle        @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  staffRecord        StaffRecord           @relation("AppraisalParticipantStaff", fields: [staffRecordId], references: [id])
  department         Department?           @relation(fields: [departmentId], references: [id])
  location           Location?             @relation(fields: [locationId], references: [id])
  selfAppraisal      SelfAppraisal?
  designationId      String? // snapshot of StaffRecord.designationId at activation
  seniorityBand      SeniorityBand? // snapshot of Designation.seniorityBand at activation
  designation        Designation?          @relation(fields: [designationId], references: [id])
  skipLevelManagerId String? // the manager's manager at enrolment
  departmentHeadId   String? // Department head at enrolment
  enrolledVia        ParticipantEnrollment @default(ACTIVATION)

  phases            AppraisalParticipantPhase[]
  peerAssignments   AppraisalPeerAssignment[]
  policyExceptions  AppraisalPolicyExceptionParticipant[]
  calibrationRecord CalibrationRecord?
  manager           StaffRecord?                          @relation("AppraisalParticipantManager", fields: [managerId], references: [id]) // lets the table show and search manager names

  createdAt DateTime @default(now())

  @@unique([cycleId, staffRecordId])
  @@index([cycleId])
  @@index([cycleId, departmentId])
  @@index([cycleId, locationId])
  @@index([designationId])
  @@index([companyId])
  @@index([staffRecordId])
  @@index([cycleId, managerId])
  @@index([departmentHeadId])
}

// One row per participant per ENABLED phase on the cycle.
model AppraisalParticipantPhase {
  id               String                 @id @default(cuid())
  participantId    String
  cycleId          String // denormalized so aggregates skip a join
  phaseType        ReviewPhaseType
  status           ParticipantPhaseStatus @default(NOT_STARTED)
  startedAt        DateTime?
  completedAt      DateTime?
  deadlineOverride DateTime?
  assignmentId     String?

  participant AppraisalCycleParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([participantId, phaseType])
  @@index([cycleId, phaseType, status])
  @@index([participantId])
  @@index([assignmentId])
}

// One row per company. Created lazily on first save (upsert), not at company creation.
model AppraisalWorkflowSettings {
  id        String @id @default(cuid())
  companyId String @unique

  // ApprovalRoutingModal
  approvalRouting      ApprovalRoutingType @default(MANAGER_SKIPLEVEL_HR)
  requireHrSignoff     Boolean             @default(true)
  autoAdvanceApprovals Boolean             @default(false)

  // DeadlineReminderModal
  remindersEnabled         Boolean                      @default(true)
  reminderLeadHours        Int                          @default(72) // 24 = "24 Hours", 72 = "3 Days", 168 = "1 Week"; any other value = "Custom Schedule"
  escalationEnabled        Boolean                      @default(true)
  escalationThresholdHours Int                          @default(48) // modal offers 24 or 48
  reminderRecipients       AppraisalReminderRecipient[] @default([EMPLOYEE, DIRECT_MANAGER, DEPARTMENT_HEAD])

  // ReviewerAssignmentModal
  peersPerEmployee Int @default(2)

  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// Settings changes aren't tied to a cycle, so AppraisalCycleHistory (cycleId required) can't hold them.
model AppraisalSettingsHistory {
  id           String   @id @default(cuid())
  companyId    String
  action       String // APPROVAL_ROUTING_UPDATED, REMINDERS_UPDATED, PEER_REVIEW_UPDATED
  actorId      String
  previousData Json?
  newData      Json?
  createdAt    DateTime @default(now())

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor   StaffRecord @relation("AppraisalSettingsActor", fields: [actorId], references: [id])

  @@index([companyId, createdAt])
  @@index([actorId])
}

// The peer matrix: one row per (employee being reviewed, peer reviewer) per cycle.
model AppraisalPeerAssignment {
  id              String               @id @default(cuid())
  cycleId         String
  companyId       String
  participantId   String // the employee being reviewed
  reviewerStaffId String // the peer
  source          PeerAssignmentSource @default(AUTO)
  assignedBy      String?
  createdAt       DateTime             @default(now())

  cycle       AppraisalCycle            @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  participant AppraisalCycleParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  reviewer    StaffRecord               @relation("AppraisalPeerReviewer", fields: [reviewerStaffId], references: [id])

  @@unique([participantId, reviewerStaffId])
  @@index([cycleId])
  @@index([reviewerStaffId])
}

model AppraisalCycleExclusion {
  id            String                     @id @default(cuid())
  cycleId       String
  companyId     String
  staffRecordId String
  reason        ParticipantExclusionReason @default(MANUAL)
  note          String?
  excludedBy    String
  createdAt     DateTime                   @default(now())

  cycle AppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, staffRecordId])
  @@index([cycleId])
  @@index([companyId])
}

// Claims "this reminder was already sent", so runs triggered by different people can never double-send.
model AppraisalAutomationLog {
  id        String   @id @default(cuid())
  companyId String
  cycleId   String
  kind      String // STARTED, DUE_SOON, OVERDUE, ESCALATION, DEPT_ESCALATION, AUTO_START_FAILED, MANUAL
  dedupeKey String   @unique
  createdAt DateTime @default(now())

  @@index([cycleId])
  @@index([companyId, createdAt])
}

// Goal and KPI Management
enum GoalPriority {
  HIGH
  MEDIUM
  LOW
}

// Health/trajectory indicator, distinct from isArchived. BLOCKED and COMPLETED
// were added for Team Goal Alignment (hero stats show blocked / completed
// counts). Overdue is NOT a status: it is computed from dueDate + progress.
enum GoalStatus {
  ON_TRACK
  AT_RISK
  NEARING_COMPLETION
  BLOCKED
  COMPLETED
}

// Where a goal sits in the alignment hierarchy (hierarchy view "level").
enum GoalLevel {
  COMPANY
  DEPARTMENT
  TEAM
  INDIVIDUAL
}

enum GoalAlignmentType {
  COMPANY_OKR
  DEPARTMENT_OBJECTIVE
  TEAM_INITIATIVE
}

enum KpiImpact {
  HIGH_IMPACT
  MEDIUM_IMPACT
  LOW_IMPACT
}

enum MilestoneStatus {
  PENDING
  ACTIVE
  COMPLETED
}

enum GoalPerformanceCategory {
  PRODUCTIVITY
  QUALITY
  COLLABORATION
  TIMELINESS
  INNOVATION
  LEADERSHIP
}

enum GoalCommentType {
  MANAGER_ACKNOWLEDGEMENT
  GENERAL
}

model Goal {
  id                  String                   @id @default(cuid())
  companyId           String
  staffRecordId       String // the employee who owns this goal
  departmentId        String? // snapshot at creation, same pattern as AppraisalCycleParticipant
  cycleId             String? // OPTIONAL forward link — see assumption below
  cycle               AppraisalCycle?          @relation(fields: [cycleId], references: [id])
  title               String
  description         String?
  category            String? // free text for now, e.g. "HR Operations" — no category management UI exists yet, see note below
  priority            GoalPriority             @default(MEDIUM)
  status              GoalStatus               @default(ON_TRACK)
  isArchived          Boolean                  @default(false)
  kpiImpact           KpiImpact                @default(MEDIUM_IMPACT)
  alignmentType       GoalAlignmentType        @default(DEPARTMENT_OBJECTIVE)
  performanceCategory GoalPerformanceCategory?

  // Team Goal Alignment
  level          GoalLevel @default(INDIVIDUAL)
  weight         Int       @default(0) // relative weight toward parentGoal; 0 = unweighted, API falls back to equal weighting among siblings
  assignedToId   String? // who the goal is assigned to; null => the owner (staffRecordId)
  assignedById   String? // manager who assigned it
  orgObjectiveId String? // company/department objective this goal rolls up to

  parentGoalId String? // "Select Parent OKR" — modeled but not yet wired in NewGoalDrawer
  parentGoal   Goal?   @relation("GoalHierarchy", fields: [parentGoalId], references: [id])
  childGoals   Goal[]  @relation("GoalHierarchy")

  progress Int @default(0) // 0-100, set directly by the slider; NOT derived from milestone completion, since UpdateProgressModal lets these move independently

  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staffRecord StaffRecord @relation("GoalOwner", fields: [staffRecordId], references: [id])
  department  Department? @relation(fields: [departmentId], references: [id])

  milestones               GoalMilestone[]
  progressUpdates          GoalProgressUpdate[]
  evidence                 GoalEvidence[]
  history                  GoalHistory[]
  comments                 GoalComment[]
  selfAppraisalReflections SelfAppraisalGoalReflection[]

  // Team Goal Alignment
  assignedTo   StaffRecord?  @relation("GoalAssignee", fields: [assignedToId], references: [id])
  assignedBy   StaffRecord?  @relation("GoalAssigner", fields: [assignedById], references: [id])
  orgObjective OrgObjective? @relation(fields: [orgObjectiveId], references: [id])

  kpis             Kpi[]
  dependencies     GoalDependency[] @relation("GoalDependent") // goals this goal depends on
  dependents       GoalDependency[] @relation("GoalDependsOn") // goals that depend on this goal
  conflictsAsGoalA GoalConflict[]   @relation("GoalConflictA")
  conflictsAsGoalB GoalConflict[]   @relation("GoalConflictB")
  activities       GoalActivity[]
  aiAnalyses       GoalAiAnalysis[]
  recognitions     Recognition[]

  createdBy String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, isArchived])
  @@index([staffRecordId])
  @@index([departmentId])
  @@index([parentGoalId])
  @@index([cycleId])
  @@index([companyId, departmentId, level])
  @@index([assignedToId])
  @@index([assignedById])
  @@index([orgObjectiveId])
  @@index([companyId, completedAt])
}

model GoalMilestone {
  id           String          @id @default(cuid())
  goalId       String
  title        String
  status       MilestoneStatus @default(PENDING)
  displayOrder Int
  dueDate      DateTime? // NEW — drives "overdue"/"upcoming" timeline entries
  completedAt  DateTime?

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([goalId])
  @@index([goalId, dueDate])
}

// One row per "Update Progress" submission — preserves the achievement-notes
// history instead of overwriting Goal.progress silently. Goal.progress is
// updated to match the latest entry's value.
model GoalProgressUpdate {
  id       String  @id @default(cuid())
  goalId   String
  progress Int // snapshot of progress at this update
  notes    String?
  actorId  String

  goal     Goal           @relation(fields: [goalId], references: [id], onDelete: Cascade)
  actor    StaffRecord    @relation("GoalProgressActor", fields: [actorId], references: [id])
  evidence GoalEvidence[]

  createdAt DateTime @default(now())

  @@index([goalId])
  @@index([actorId])
  @@index([createdAt])
}

// Decoupled from GoalProgressUpdate — UploadEvidenceModal can attach evidence
// to a goal directly (via the card's standalone "Evidence" quick action),
// while UpdateProgressModal's drag-drop attaches it to a specific update.
model GoalEvidence {
  id               String  @id @default(cuid())
  goalId           String
  progressUpdateId String? // null when uploaded standalone, not during an update
  fileName         String
  fileUrl          String? // optional for legacy disk-stored records
  mimeType         String? // e.g. "application/pdf"
  sizeBytes        Int? // file size in bytes
  data             Bytes? // raw binary data stored directly in PostgreSQL bytea
  note             String?
  uploadedBy       String

  goal           Goal                @relation(fields: [goalId], references: [id], onDelete: Cascade)
  progressUpdate GoalProgressUpdate? @relation(fields: [progressUpdateId], references: [id])
  uploader       StaffRecord         @relation("GoalEvidenceUploader", fields: [uploadedBy], references: [id])

  createdAt DateTime @default(now())

  @@index([goalId])
  @@index([progressUpdateId])
}

model GoalHistory {
  id           String  @id @default(cuid())
  goalId       String
  companyId    String?
  action       String // CREATED, PROGRESS_UPDATED, MILESTONE_COMPLETED, ARCHIVED, EDITED, REASSIGNED, REPARENTED, KPI_ASSIGNED, DEPENDENCY_ADDED, CONFLICT_RESOLVED
  actorId      String
  previousData Json?
  newData      Json?

  goal  Goal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  actor StaffRecord @relation("GoalHistoryActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([goalId])
  @@index([actorId])
  @@index([createdAt])
  @@index([companyId, createdAt])
}

model GoalComment {
  id       String          @id @default(cuid())
  goalId   String
  authorId String
  type     GoalCommentType @default(GENERAL)
  message  String

  goal   Goal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  author StaffRecord @relation("GoalCommentAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([goalId])
  @@index([authorId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Team Goal Alignment
//
// Derived values are intentionally NOT stored: goal alignment score, parent
// contribution (weight / sum of sibling weights), KPI progress
// (currentValue / targetValue), and rolled-up parent progress are computed by
// the API on read so they can never go stale.
// ─────────────────────────────────────────────────────────────────────────────

// Company / department level OKRs that team and individual goals roll up to
// ("orgObjectiveId" in the create-goal modal). Can itself nest
// (company objective -> department objective).
model OrgObjective {
  id                String    @id @default(cuid())
  companyId         String
  departmentId      String? // null for company-wide objectives
  level             GoalLevel @default(COMPANY) // COMPANY or DEPARTMENT only; enforced in the API
  title             String
  description       String?
  ownerId           String?
  parentObjectiveId String?
  cycleId           String?
  startDate         DateTime?
  dueDate           DateTime?
  isArchived        Boolean   @default(false)

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department      Department?     @relation(fields: [departmentId], references: [id])
  owner           StaffRecord?    @relation("OrgObjectiveOwner", fields: [ownerId], references: [id])
  cycle           AppraisalCycle? @relation(fields: [cycleId], references: [id])
  parentObjective OrgObjective?   @relation("OrgObjectiveHierarchy", fields: [parentObjectiveId], references: [id])
  childObjectives OrgObjective[]  @relation("OrgObjectiveHierarchy")
  goals           Goal[]

  createdBy String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, level])
  @@index([departmentId])
  @@index([parentObjectiveId])
  @@index([cycleId])
}

enum KpiMeasurementMethod {
  MANUAL // owner enters currentValue
  AUTOMATED // pulled from integrationSource
}

// Measurable results attached to a goal (KPIAssignmentModal). Progress is
// computed from currentValue / targetValue, not stored.
model Kpi {
  id                String               @id @default(cuid())
  companyId         String
  goalId            String
  ownerId           String? // assignee responsible for this KPI
  name              String
  description       String?
  targetValue       Float
  currentValue      Float                @default(0)
  unit              String? // e.g. "%", "NGN", "tickets"
  weight            Int                  @default(0) // relative weight within the goal; 0 = unweighted
  impact            KpiImpact            @default(MEDIUM_IMPACT)
  deadline          DateTime?
  measurementMethod KpiMeasurementMethod @default(MANUAL)
  automatedTracking Boolean              @default(false)
  integrationSource String? // e.g. "Salesforce", "Jira"; only meaningful when automatedTracking
  lastSyncedAt      DateTime?
  isArchived        Boolean              @default(false)

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  goal    Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  owner   StaffRecord? @relation("KpiOwner", fields: [ownerId], references: [id])

  createdBy String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([goalId])
  @@index([ownerId])
  @@index([goalId, isArchived])
}

// "goal depends on dependsOnGoal". Self-dependency and cycles are rejected in
// the API.
model GoalDependency {
  id              String  @id @default(cuid())
  goalId          String // the dependent goal
  dependsOnGoalId String // the prerequisite goal
  isBlocking      Boolean @default(true)

  goal          Goal @relation("GoalDependent", fields: [goalId], references: [id], onDelete: Cascade)
  dependsOnGoal Goal @relation("GoalDependsOn", fields: [dependsOnGoalId], references: [id], onDelete: Cascade)

  createdBy String
  createdAt DateTime @default(now())

  @@unique([goalId, dependsOnGoalId])
  @@index([goalId])
  @@index([dependsOnGoalId])
}

enum GoalConflictStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// Two goals competing for the same assignee's capacity. goalAId / goalBId are
// stored in sorted order by the API so the unique pair cannot be duplicated.
model GoalConflict {
  id                   String             @id @default(cuid())
  companyId            String
  goalAId              String
  goalBId              String
  assigneeId           String? // the person whose capacity is overcommitted
  capacityA            Float // snapshot: hours/week demanded by goal A
  capacityB            Float // snapshot: hours/week demanded by goal B
  deficit              Float // snapshot: demand minus available capacity
  workloadAnalysisText String?
  status               GoalConflictStatus @default(OPEN)
  detectedAt           DateTime           @default(now())
  resolvedById         String?
  resolvedAt           DateTime?
  resolutionNote       String?

  company     Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  goalA       Goal                     @relation("GoalConflictA", fields: [goalAId], references: [id], onDelete: Cascade)
  goalB       Goal                     @relation("GoalConflictB", fields: [goalBId], references: [id], onDelete: Cascade)
  assignee    StaffRecord?             @relation("GoalConflictAssignee", fields: [assigneeId], references: [id])
  resolvedBy  StaffRecord?             @relation("GoalConflictResolver", fields: [resolvedById], references: [id])
  resolutions GoalConflictResolution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([goalAId, goalBId])
  @@index([companyId, status])
  @@index([goalAId])
  @@index([goalBId])
  @@index([assigneeId])
}

enum GoalConflictResolutionAction {
  EXTEND_DEADLINE
  REASSIGN
  REPRIORITIZE
  DESCOPE
  OTHER
}

// Resolution options offered in ConflictResolutionModal; exactly one is marked
// isChosen when the conflict is resolved.
model GoalConflictResolution {
  id            String                       @id @default(cuid())
  conflictId    String
  action        GoalConflictResolutionAction @default(OTHER)
  title         String
  description   String?
  payload       Json? // action parameters, e.g. { newDueDate } or { newAssigneeId }
  isRecommended Boolean                      @default(false)
  isChosen      Boolean                      @default(false)
  displayOrder  Int                          @default(0)

  conflict GoalConflict @relation(fields: [conflictId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conflictId])
}

enum GoalActivityType {
  UPDATE
  MILESTONE
  BLOCKER
  ANNOUNCEMENT
  RECOGNITION
  ALERT
  MENTION
}

// Team collaboration feed (TeamCollaborationFeed). Separate from GoalComment:
// posts can be team-wide (goalId null) and carry badge / action metadata.
model GoalActivity {
  id           String           @id @default(cuid())
  companyId    String
  goalId       String? // null = team-wide post
  departmentId String? // team scope for the feed
  authorId     String
  type         GoalActivityType @default(UPDATE)
  title        String?
  content      String
  badgeLabel   String?
  actionLabel  String?
  isResolved   Boolean          @default(false) // meaningful for BLOCKER posts
  resolvedAt   DateTime?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  goal       Goal?       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id])
  author     StaffRecord @relation("GoalActivityAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([departmentId, createdAt])
  @@index([goalId])
  @@index([authorId])
}

// Cached AI insight (GoalAIInsights / goal detail "aiAnalysis") so it is not
// regenerated on every request. Scoped to one goal, or to a department/team when
// goalId is null.
model GoalAiAnalysis {
  id              String    @id @default(cuid())
  companyId       String
  goalId          String?
  departmentId    String?
  summary         String
  riskFlags       Json?
  recommendations Json?
  model           String?
  generatedAt     DateTime  @default(now())
  expiresAt       DateTime?
  generatedBy     String?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  goal       Goal?       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id])

  @@index([companyId])
  @@index([goalId, generatedAt])
  @@index([departmentId, generatedAt])
}

// Per-person capacity used by conflict detection. One row per staff record;
// absent row => API assumes the 40h default.
model StaffWorkloadCapacity {
  id                  String @id @default(cuid())
  companyId           String
  staffRecordId       String @unique
  weeklyCapacityHours Float  @default(40)

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staffRecord StaffRecord @relation("StaffWorkloadCapacityOwner", fields: [staffRecordId], references: [id], onDelete: Cascade)

  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// Self Appraisal
enum SelfAppraisalStatus {
  DRAFT
  SUBMITTED
  // RETURNED can be added when Manager Review is built (send-back-for-revision)
}

enum SelfAppraisalEvidenceType {
  UPLOAD // file uploaded via POST /api/goals/uploads
  LINK // external URL entered in AttachEvidenceDialog's "file name / link" field
}

// One row per participant per cycle. Created lazily (get-or-create) the first
// time the employee opens the flow for a cycle.
model SelfAppraisal {
  id                String  @id @default(cuid())
  companyId         String
  cycleId           String // REAL FK — replaces the hardcoded "Q3 Cycle 2026"
  participantId     String // AppraisalCycleParticipant — also gives us the SELF_APPRAISAL phase row
  staffRecordId     String // denormalized from participant for self-service scoping
  templateVersionId String? // the assigned SELF_ASSESSMENT template version that supplied the competency list

  status SelfAppraisalStatus @default(DRAFT)

  // Step 4 — Challenges & Learnings
  challenges String?
  learnings  String?

  // Step 5 — Career Growth. careerSkills is comma-separated free text,
  // matching the single text input (same convention as Competency.tags).
  careerAspiration String?
  careerSkills     String?
  careerSupport    String?

  // Step 6 — declaration checkbox is toggled while still in DRAFT, so it needs
  // its own column; submittedAt is the moment it became binding.
  declarationAgreed Boolean   @default(false)
  submittedAt       DateTime?

  company         Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cycle           AppraisalCycle            @relation(fields: [cycleId], references: [id])
  participant     AppraisalCycleParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  staffRecord     StaffRecord               @relation("SelfAppraisalOwner", fields: [staffRecordId], references: [id])
  templateVersion ReviewTemplateVersion?    @relation(fields: [templateVersionId], references: [id])

  goalReflections   SelfAppraisalGoalReflection[]
  competencyRatings SelfAppraisalCompetencyRating[]
  history           SelfAppraisalHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // doubles as "last saved" for the Save Draft button

  @@unique([participantId]) // one self-appraisal per participant per cycle
  @@index([companyId])
  @@index([cycleId, status])
  @@index([staffRecordId])
  @@index([templateVersionId])
}

// Step 2 — one row per goal the employee reflects on.
// goalTitle / goalProgress / goalStatus are snapshots: refreshed from Goal while
// the appraisal is DRAFT, frozen at submit, so a submitted appraisal never
// changes when the underlying goal is edited later.
model SelfAppraisalGoalReflection {
  id              String     @id @default(cuid())
  selfAppraisalId String
  goalId          String
  goalTitle       String
  goalProgress    Int
  goalStatus      GoalStatus
  reflection      String?
  confidence      Int        @default(3) // 1-5, "Achievement Confidence"
  displayOrder    Int

  selfAppraisal SelfAppraisal           @relation(fields: [selfAppraisalId], references: [id], onDelete: Cascade)
  goal          Goal                    @relation(fields: [goalId], references: [id])
  evidence      SelfAppraisalEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([selfAppraisalId, goalId])
  @@index([goalId])
}

// Step 3 — one row per competency being rated.
// Name/description are snapshotted so renaming or archiving a Competency later
// doesn't rewrite a submitted appraisal.
// rating is nullable until the employee actually rates; submit validation
// requires it to be non-null and within the resolved ProficiencyScale range.
// The radar chart is derived from these rows — it is never persisted.
model SelfAppraisalCompetencyRating {
  id                    String  @id @default(cuid())
  selfAppraisalId       String
  competencyId          String
  competencyName        String
  competencyDescription String?
  rating                Int?
  comment               String?
  displayOrder          Int

  selfAppraisal SelfAppraisal @relation(fields: [selfAppraisalId], references: [id], onDelete: Cascade)
  competency    Competency    @relation(fields: [competencyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([selfAppraisalId, competencyId])
  @@index([competencyId])
}

// Evidence attached to a specific goal reflection. Separate from GoalEvidence on
// purpose: that table is keyed to a Goal, this one to a reflection inside one
// appraisal. File storage is shared via the existing /api/goals/uploads endpoint.
// Soft-removed (removedAt) to honor the never-hard-delete convention.
model SelfAppraisalEvidence {
  id               String                    @id @default(cuid())
  goalReflectionId String
  sourceType       SelfAppraisalEvidenceType @default(UPLOAD)
  fileName         String
  fileUrl          String? // external URL for links, or optional legacy path for uploads
  mimeType         String? // e.g. "application/pdf"
  sizeBytes        Int? // file size in bytes
  data             Bytes? // raw binary data stored directly in PostgreSQL bytea
  uploadedBy       String
  removedAt        DateTime?

  goalReflection SelfAppraisalGoalReflection @relation(fields: [goalReflectionId], references: [id], onDelete: Cascade)
  uploader       StaffRecord                 @relation("SelfAppraisalEvidenceUploader", fields: [uploadedBy], references: [id])

  createdAt DateTime @default(now())

  @@index([goalReflectionId])
  @@index([uploadedBy])
}

model SelfAppraisalHistory {
  id              String  @id @default(cuid())
  selfAppraisalId String
  companyId       String?
  action          String // CREATED, DRAFT_SAVED, EVIDENCE_ADDED, EVIDENCE_REMOVED, SUBMITTED
  actorId         String
  previousData    Json? // for DRAFT_SAVED store only { sections: [...] } (what changed), not full text
  newData         Json? // for SUBMITTED store the full submitted snapshot

  selfAppraisal SelfAppraisal @relation(fields: [selfAppraisalId], references: [id], onDelete: Cascade)
  actor         StaffRecord   @relation("SelfAppraisalHistoryActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([selfAppraisalId])
  @@index([actorId])
  @@index([createdAt])
  @@index([companyId, createdAt])
}

// Employee Review Workspace

enum ManagerReviewStatus {
  DRAFT
  SUBMITTED
  // RETURNED can be added when Calibration / HR Validation can send a review back
}

// Mirrors the modal's dropdown: No Action Needed, Recommend Promotion,
// Recommend Salary Increase, Assign Training, Initiate PIP
enum ManagerReviewRecommendation {
  NO_ACTION
  PROMOTION
  SALARY_INCREASE
  TRAINING
  PIP
}

enum PerformanceActionType {
  FEEDBACK
  COACHING
  PIP
  REVIEW
  ONE_ON_ONE
}

enum PerformanceActionPriority {
  NORMAL
  HIGH
  URGENT
}

enum PerformanceActionStatus {
  DRAFT
  ASSIGNED
  COMPLETED
}

// One row per participant per cycle. Created lazily when the manager first
// opens the review, and only once the employee's self appraisal is SUBMITTED.
model ManagerReview {
  id                String  @id @default(cuid())
  companyId         String
  cycleId           String
  participantId     String
  staffRecordId     String // the employee being reviewed
  reviewerId        String? // manager of record (participant.managerId snapshot); null if the employee has no manager
  templateVersionId String? // template version that supplied the competency list

  status         ManagerReviewStatus         @default(DRAFT)
  finalComments  String? // "Final Manager Comments"
  recommendation ManagerReviewRecommendation @default(NO_ACTION)
  acknowledged   Boolean                     @default(false) // the "discussed with the employee" checkbox, toggled while DRAFT
  submittedAt    DateTime?

  // Score snapshots, all stored as 0-100 percentages. Recomputed by the service
  // on every draft save and frozen at submit. Display scales (8.5/10, 3.8/5,
  // 90/100) are a UI conversion, never stored. Stored (not just derived) so the
  // board can filter and sort on them in SQL.
  kpiScore               Float? // from the employee's goals
  competencyScore        Float? // from competencyRatings below
  overallScore           Float?
  calibratedOverallScore Float?
  pip                    Pip?

  company                         Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cycle                           AppraisalCycle            @relation(fields: [cycleId], references: [id])
  participant                     AppraisalCycleParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  staffRecord                     StaffRecord               @relation("ManagerReviewSubject", fields: [staffRecordId], references: [id])
  reviewer                        StaffRecord?              @relation("ManagerReviewReviewer", fields: [reviewerId], references: [id])
  templateVersion                 ReviewTemplateVersion?    @relation(fields: [templateVersionId], references: [id])
  promotionRecommendationsAsBasis PromotionRecommendation[] @relation("PromotionBasisReview")

  competencyRatings ManagerReviewCompetencyRating[]
  history           ManagerReviewHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([participantId]) // one manager review per participant per cycle
  @@index([companyId])
  @@index([cycleId, status])
  @@index([cycleId, reviewerId])
  @@index([cycleId, overallScore])
  @@index([staffRecordId])
  @@index([templateVersionId])
}

// Same shape as SelfAppraisalCompetencyRating, so the drawer can show self vs
// manager rating side by side by joining on competencyId. Name and description
// are snapshotted. rating is null until the manager rates; submit requires it.
model ManagerReviewCompetencyRating {
  id                    String  @id @default(cuid())
  managerReviewId       String
  competencyId          String
  competencyName        String
  competencyDescription String?
  rating                Int?
  comment               String?
  displayOrder          Int

  calibrationNote  String?
  calibratedRating Int?

  managerReview ManagerReview @relation(fields: [managerReviewId], references: [id], onDelete: Cascade)
  competency    Competency    @relation(fields: [competencyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([managerReviewId, competencyId])
  @@index([competencyId])
}

model ManagerReviewHistory {
  id              String  @id @default(cuid())
  managerReviewId String
  companyId       String?
  action          String // CREATED, DRAFT_SAVED, SUBMITTED
  actorId         String // may differ from reviewerId when HR/ADMIN acts on a manager's behalf
  previousData    Json? // DRAFT_SAVED: only which fields changed, not the full text
  newData         Json? // SUBMITTED: the full submitted snapshot

  managerReview ManagerReview @relation(fields: [managerReviewId], references: [id], onDelete: Cascade)
  actor         StaffRecord   @relation("ManagerReviewHistoryActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([managerReviewId])
  @@index([actorId])
  @@index([createdAt])
  @@index([companyId, createdAt])
}

model PerformanceAction {
  id            String  @id @default(cuid())
  companyId     String
  cycleId       String? // set when launched from the review workspace
  staffRecordId String // the team member the action is for
  createdById   String // the manager / HR user who created it

  type       PerformanceActionType
  priority   PerformanceActionPriority @default(NORMAL)
  status     PerformanceActionStatus   @default(DRAFT)
  notes      String? // "Details & Notes"
  dueDate    DateTime?
  assignedAt DateTime? // set when "Assign Action" is used; null while DRAFT
  pip        Pip?

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cycle       AppraisalCycle? @relation(fields: [cycleId], references: [id])
  staffRecord StaffRecord     @relation("PerformanceActionSubject", fields: [staffRecordId], references: [id])
  createdBy   StaffRecord     @relation("PerformanceActionCreator", fields: [createdById], references: [id])

  attachments PerformanceActionAttachment[]
  history     PerformanceActionHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([staffRecordId])
  @@index([cycleId])
  @@index([createdById])
  @@index([dueDate])
}

// Files for the "Add Files" button. Reuses POST /api/goals/uploads. Soft-removed.
model PerformanceActionAttachment {
  id         String    @id @default(cuid())
  actionId   String
  fileName   String
  fileUrl    String? // optional for legacy disk-stored records
  mimeType   String? // e.g. "application/pdf"
  sizeBytes  Int? // file size in bytes
  data       Bytes? // raw binary data stored directly in PostgreSQL bytea
  uploadedBy String
  removedAt  DateTime?

  action   PerformanceAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  uploader StaffRecord       @relation("PerformanceActionAttachmentUploader", fields: [uploadedBy], references: [id])

  createdAt DateTime @default(now())

  @@index([actionId])
  @@index([uploadedBy])
}

model PerformanceActionHistory {
  id           String  @id @default(cuid())
  actionId     String
  companyId    String?
  action       String // CREATED, UPDATED, ASSIGNED, ATTACHMENT_ADDED, ATTACHMENT_REMOVED
  actorId      String
  previousData Json?
  newData      Json?

  performanceAction PerformanceAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  actor             StaffRecord       @relation("PerformanceActionHistoryActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([actionId])
  @@index([actorId])
  @@index([createdAt])
  @@index([companyId, createdAt])
}

// Performance Operations

enum AppraisalEscalationCategory {
  OVERDUE_APPRAISAL
  PERFORMANCE_DISPUTE
  POLICY_VIOLATION
  SYSTEM_EXCEPTION
  PIP_ESCALATION
}

enum EscalationSeverity {
  MEDIUM
  HIGH
  LOW
}

enum AppraisalEscalationStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum OpsNoteType {
  COMMENT // written by an HR/Admin user
  SYSTEM // written by the platform, e.g. "Automated reminder sent to..."
}

enum AppraisalBulkAction {
  MASS_REMINDER
  EXTEND_DUE_DATE
  REASSIGN_REVIEWER
  EXPORT_SUMMARY
}

enum PolicyExceptionStatus {
  PENDING
  APPROVED
  DENIED
}

model AppraisalEscalation {
  id        String @id @default(cuid())
  companyId String

  // Target entity = (cycle, department).
  //   both null                  -> general governance escalation (modal's `target` is optional)
  //   cycleId set, deptId null   -> that cycle's "Unassigned" department bucket
  cycleId        String?
  departmentId   String?
  resolutionNote String?

  category AppraisalEscalationCategory
  severity EscalationSeverity          @default(HIGH) // modal defaults to High
  status   AppraisalEscalationStatus   @default(OPEN)
  notes    String? // "Supporting Notes & Action Plan"

  assignedReviewerId String? // HR/Admin StaffRecord; modal default is the acting admin
  raisedBy           String
  resolvedBy         String?
  resolvedAt         DateTime?

  pipId                String? // set for PIP escalations; cycleId and departmentId stay null (decision 35)
  pipOpenKey           String? @unique // = pipId while OPEN or IN_REVIEW, null once RESOLVED; one open escalation per PIP
  reason               String? // "Escalation Reason & Unresolved Concerns"
  recommendedNextSteps String? // "Recommended Next Steps"

  company          Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cycle            AppraisalCycle?                 @relation(fields: [cycleId], references: [id])
  department       Department?                     @relation(fields: [departmentId], references: [id])
  assignedReviewer StaffRecord?                    @relation("EscalationAssignee", fields: [assignedReviewerId], references: [id])
  raiser           StaffRecord                     @relation("EscalationRaiser", fields: [raisedBy], references: [id])
  resolver         StaffRecord?                    @relation("EscalationResolver", fields: [resolvedBy], references: [id])
  pip              Pip?                            @relation(fields: [pipId], references: [id])
  comments         AppraisalEscalationComment[]
  attachments      AppraisalEscalationAttachment[]

  history AppraisalEscalationHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([cycleId, departmentId])
  @@index([assignedReviewerId, status])
  @@index([raisedBy])
  @@index([pipId])
}

model AppraisalEscalationHistory {
  id           String  @id @default(cuid())
  escalationId String
  companyId    String?
  action       String // CREATED, REASSIGNED, STATUS_CHANGED
  actorId      String
  previousData Json?
  newData      Json?

  escalation AppraisalEscalation @relation(fields: [escalationId], references: [id], onDelete: Cascade)
  actor      StaffRecord         @relation("EscalationHistoryActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([escalationId])
  @@index([actorId])
  @@index([createdAt])
  @@index([companyId, createdAt])
}

// Immutable notes feed for one entity. No updatedAt and no edit/delete routes,
// so the compliance trail can't be rewritten.
model PerformanceOpsNote {
  id           String      @id @default(cuid())
  companyId    String
  cycleId      String
  departmentId String? // null = the cycle's "Unassigned" bucket
  type         OpsNoteType @default(COMMENT)
  authorId     String? // null for SYSTEM notes
  message      String

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cycle      AppraisalCycle @relation(fields: [cycleId], references: [id])
  department Department?    @relation(fields: [departmentId], references: [id])
  author     StaffRecord?   @relation("OpsNoteAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([cycleId, departmentId, createdAt])
  @@index([companyId])
  @@index([authorId])
}

model AppraisalBulkOperation {
  id             String              @id @default(cuid())
  companyId      String
  cycleId        String
  action         AppraisalBulkAction
  departmentKeys String[] // department ids, or "unassigned"
  message        String?
  params         Json? // EXTEND_DUE_DATE: { newDueDate } | REASSIGN_REVIEWER: { newReviewerId }
  affectedCount  Int                 @default(0)
  details        Json? // REASSIGN_REVIEWER: [{ participantId, from, to }]
  performedBy    String

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cycle     AppraisalCycle @relation(fields: [cycleId], references: [id])
  performer StaffRecord    @relation("BulkOperationPerformer", fields: [performedBy], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([cycleId])
  @@index([performedBy])
}

// "Request to delay review cycle for 3 employees on extended leave."
// The row is its own audit trail (one-step approve/deny), so no history table.
model AppraisalPolicyException {
  id               String                @id @default(cuid())
  companyId        String
  cycleId          String
  reason           String
  requestedDueDate DateTime // approved: becomes deadlineOverride on the participants' open phases
  status           PolicyExceptionStatus @default(PENDING)
  requestedBy      String
  decidedBy        String?
  decidedAt        DateTime?
  decisionNote     String?

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cycle     AppraisalCycle @relation(fields: [cycleId], references: [id])
  requester StaffRecord    @relation("PolicyExceptionRequester", fields: [requestedBy], references: [id])
  decider   StaffRecord?   @relation("PolicyExceptionDecider", fields: [decidedBy], references: [id])

  participants AppraisalPolicyExceptionParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([cycleId, status])
}

model AppraisalPolicyExceptionParticipant {
  id            String @id @default(cuid())
  exceptionId   String
  participantId String

  exception   AppraisalPolicyException  @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  participant AppraisalCycleParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([exceptionId, participantId])
  @@index([participantId])
}

// Callibration
enum OverallRating {
  UNSATISFACTORY
  NEEDS_IMPROVEMENT
  MEETS_EXPECTATIONS
  EXCEEDS_EXPECTATIONS
  OUTSTANDING
}

enum CalibrationStatus {
  PENDING
  UNDER_REVIEW
  ADJUSTED
  APPROVED
  ESCALATED // needs an executive decision
  FINALIZED
}

enum CalibrationAdjustmentReason {
  INFLATION_CORRECTION
  DEFLATION_CORRECTION
  DEPARTMENT_NORMALIZATION
  PEER_ALIGNMENT
  PROMOTION_REVIEW
  OTHER
}

enum PotentialLevel {
  LOW
  MEDIUM
  HIGH
}

enum CalibrationSessionStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

// One row per participant per cycle, created when the manager review is submitted.
model CalibrationRecord {
  id            String @id @default(cuid())
  companyId     String
  cycleId       String
  participantId String
  staffRecordId String

  originalRating   OverallRating // manager's rating at creation (from the review score); never changes
  proposedRating   OverallRating // starts equal to originalRating; the current calibrated rating
  status           CalibrationStatus            @default(PENDING)
  adjustmentReason CalibrationAdjustmentReason?
  justification    String?
  potential        PotentialLevel? // feeds the 9-box; null = not assessed
  approvedAt       DateTime?
  finalizedAt      DateTime?

  company     Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cycle       AppraisalCycle            @relation(fields: [cycleId], references: [id])
  participant AppraisalCycleParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  staffRecord StaffRecord               @relation("CalibrationSubject", fields: [staffRecordId], references: [id])
  history     CalibrationHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([participantId])
  @@index([companyId, cycleId, status])
  @@index([cycleId, proposedRating])
  @@index([staffRecordId])
}

model CalibrationSession {
  id           String                   @id @default(cuid())
  companyId    String
  cycleId      String
  departmentId String? // "Target Department"
  name         String
  notes        String?
  startsAt     DateTime? // UTC instant; null = "TBD"
  status       CalibrationSessionStatus @default(UPCOMING)
  startedAt    DateTime?
  endedAt      DateTime?
  createdById  String

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cycle      AppraisalCycle @relation(fields: [cycleId], references: [id])
  department Department?    @relation(fields: [departmentId], references: [id])
  createdBy  StaffRecord    @relation("CalibrationSessionCreator", fields: [createdById], references: [id])

  attendees CalibrationSessionAttendee[]
  history   CalibrationHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, cycleId, status])
  @@index([departmentId])
  @@index([createdById])
}

// Creator is added on creation; others are added when they click "Join Session".
model CalibrationSessionAttendee {
  id            String   @id @default(cuid())
  sessionId     String
  staffRecordId String
  joinedAt      DateTime @default(now())

  session     CalibrationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  staffRecord StaffRecord        @relation("CalibrationSessionAttendee", fields: [staffRecordId], references: [id])

  @@unique([sessionId, staffRecordId])
  @@index([staffRecordId])
}

// One table for both: recordId for rating/status changes, sessionId for session events.
model CalibrationHistory {
  id           String  @id @default(cuid())
  recordId     String?
  sessionId    String?
  companyId    String?
  action       String // ADJUSTED, STATUS_CHANGED, APPROVED, ESCALATED, FINALIZED, SESSION_CREATED, SESSION_STARTED, SESSION_JOINED, SESSION_COMPLETED
  actorId      String
  previousData Json?
  newData      Json?

  record  CalibrationRecord?  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  session CalibrationSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  actor   StaffRecord         @relation("CalibrationHistoryActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([recordId])
  @@index([sessionId])
  @@index([actorId])
  @@index([createdAt])
  @@index([companyId, createdAt])
}

// Feedback and Recognition
enum FeedbackCategory {
  RECOGNITION
  COACHING
  PERFORMANCE
  COLLABORATION
}

enum FeedbackSentiment {
  POSITIVE
  CONSTRUCTIVE
}

enum RecognitionCategory {
  PERFORMANCE
  LEADERSHIP
  COLLABORATION
  INNOVATION
}

enum RecognitionVisibility {
  COMPANY // "Public to Company"
  TEAM // "Team Only"
  PRIVATE // "Private to Recipient"
}

enum FeedbackRequestStatus {
  PENDING
  COMPLETED
  DECLINED
}

enum FeedbackReportStatus {
  OPEN
  RESOLVED
}

// A feed item: feedback received by recipientId. category and sentiment are optional
// because the UI falls back to a plain "Feedback" label when they are missing.
// aiSummary is mocked AI and is not stored.
model Feedback {
  id          String  @id @default(cuid())
  companyId   String
  authorId    String
  recipientId String
  requestId   String? @unique // set when this feedback answers a FeedbackRequest

  category       FeedbackCategory?
  sentiment      FeedbackSentiment?
  content        String
  tags           String[]           @default([]) // free-text "KPI tags", stored lowercase
  acknowledgedAt DateTime? // the recipient's "Acknowledge" click; one-way

  recognitionId String?      @unique // set when this feed item was created from a received recognition
  recognition   Recognition? @relation(fields: [recognitionId], references: [id])

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author    StaffRecord      @relation("FeedbackAuthor", fields: [authorId], references: [id])
  recipient StaffRecord      @relation("FeedbackRecipient", fields: [recipientId], references: [id])
  request   FeedbackRequest? @relation(fields: [requestId], references: [id])

  // like and comment counts are derived (relation _count), never denormalized
  likes     FeedbackLike[]
  bookmarks FeedbackBookmark[]
  comments  FeedbackComment[]
  reports   FeedbackReport[]
  history   FeedbackHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([recipientId, createdAt])
  @@index([authorId])
  @@index([companyId, category])
}

model FeedbackLike {
  id            String   @id @default(cuid())
  feedbackId    String
  staffRecordId String
  createdAt     DateTime @default(now())

  feedback    Feedback    @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  staffRecord StaffRecord @relation("FeedbackLiker", fields: [staffRecordId], references: [id])

  @@unique([feedbackId, staffRecordId])
  @@index([staffRecordId])
}

model FeedbackBookmark {
  id            String   @id @default(cuid())
  feedbackId    String
  staffRecordId String
  createdAt     DateTime @default(now())

  feedback    Feedback    @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  staffRecord StaffRecord @relation("FeedbackBookmarker", fields: [staffRecordId], references: [id])

  @@unique([feedbackId, staffRecordId])
  @@index([staffRecordId])
}

// The "Respond" action and the thread count. PROVISIONAL until RespondModal is seen.
model FeedbackComment {
  id         String   @id @default(cuid())
  feedbackId String
  authorId   String
  message    String? // optional, so an emoji-only response is possible
  emoji      String? // one of 👍 🙏 🎉 💡 🚀; the service requires a message or an emoji
  createdAt  DateTime @default(now())

  feedback Feedback    @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  author   StaffRecord @relation("FeedbackCommenter", fields: [authorId], references: [id])

  @@index([feedbackId, createdAt])
  @@index([authorId])
}

// The "Report" menu item ("reported to HR"). reason is not collected by the UI yet.
model FeedbackReport {
  id         String               @id @default(cuid())
  feedbackId String
  reporterId String
  reason     String?
  status     FeedbackReportStatus @default(OPEN)
  createdAt  DateTime             @default(now())

  feedback Feedback    @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  reporter StaffRecord @relation("FeedbackReporter", fields: [reporterId], references: [id])

  @@unique([feedbackId, reporterId])
  @@index([status])
}

// One row per reviewer asked. PROVISIONAL until RequestFeedbackModal is seen.
model FeedbackRequest {
  id          String                @id @default(cuid())
  companyId   String
  requesterId String // who wants feedback
  reviewerId  String // who was asked
  message     String?
  status      FeedbackRequestStatus @default(PENDING)
  respondedAt DateTime?
  focusAreas  String[]              @default([])

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requester StaffRecord       @relation("FeedbackRequester", fields: [requesterId], references: [id])
  reviewer  StaffRecord       @relation("FeedbackReviewer", fields: [reviewerId], references: [id])
  feedback  Feedback?
  history   FeedbackHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([reviewerId, status])
  @@index([requesterId])
}

// A wall item. title is set by the service (e.g. "Performance Recognition"); iconKey and
// color are derived from category at read time and not stored.
model Recognition {
  id           String  @id @default(cuid())
  companyId    String
  giverId      String
  recipientId  String
  departmentId String? // snapshot of the recipient's department, used for TEAM visibility

  category       RecognitionCategory
  title          String
  message        String
  coreValues     String[]              @default([]) // e.g. Communication, Teamwork, Ownership
  visibility     RecognitionVisibility @default(COMPANY)
  points         Int                   @default(0) // the "+250" chip
  attachmentName String? // the single "Attach Evidence" file, uploaded via /api/goals/uploads
  attachmentUrl  String?
  attachmentMime String? // e.g. "application/pdf"
  attachmentSize Int? // file size in bytes
  attachmentData Bytes? // raw binary data stored directly in PostgreSQL bytea

  goalId       String? // the optional "Linked Items" goal in the detail drawer
  goal         Goal?                 @relation(fields: [goalId], references: [id])
  feedbackItem Feedback? // the recipient's feed item
  reactions    RecognitionReaction[]

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  giver      StaffRecord       @relation("RecognitionGiver", fields: [giverId], references: [id])
  recipient  StaffRecord       @relation("RecognitionRecipient", fields: [recipientId], references: [id])
  department Department?       @relation(fields: [departmentId], references: [id])
  history    FeedbackHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([recipientId, createdAt])
  @@index([giverId, createdAt])
  @@index([companyId, visibility, departmentId])
  @@index([goalId])
}

// One audit table for feedback, requests and recognitions. Likes and bookmarks are
// per-user toggles with their own rows, so they are not logged here.
model FeedbackHistory {
  id            String  @id @default(cuid())
  feedbackId    String?
  requestId     String?
  recognitionId String?
  companyId     String?
  action        String // FEEDBACK_CREATED, ACKNOWLEDGED, COMMENTED, REPORTED, REQUEST_CREATED, REQUEST_COMPLETED, REQUEST_DECLINED, RECOGNITION_GIVEN
  actorId       String
  previousData  Json?
  newData       Json?

  feedback    Feedback?        @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  request     FeedbackRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  recognition Recognition?     @relation(fields: [recognitionId], references: [id], onDelete: Cascade)
  actor       StaffRecord      @relation("FeedbackHistoryActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([feedbackId])
  @@index([requestId])
  @@index([recognitionId])
  @@index([actorId])
  @@index([companyId, createdAt])
}

enum RecognitionReactionType {
  LIKE
  CELEBRATE
}

// The recognition drawer's Like and Celebrate toggles. One row per user per type.
model RecognitionReaction {
  id            String                  @id @default(cuid())
  recognitionId String
  staffRecordId String
  type          RecognitionReactionType
  createdAt     DateTime                @default(now())

  recognition Recognition @relation(fields: [recognitionId], references: [id], onDelete: Cascade)
  staffRecord StaffRecord @relation("RecognitionReactor", fields: [staffRecordId], references: [id])

  @@unique([recognitionId, staffRecordId, type])
  @@index([staffRecordId])
}

// ---------------------------------------------------------------------------
// Development Plans
// ---------------------------------------------------------------------------

enum DevelopmentPlanStatus {
  ACTIVE
  COMPLETED
  ARCHIVED // soft delete: the UI "Delete" action; hidden from lists, kept for audit
}
// "Overdue" is NOT stored: it is ACTIVE with targetDate in the past (derived at read time).

enum DevelopmentActivityType {
  COURSE
  COACHING
  CERTIFICATION
  PROJECT
  READING
  OTHER
}

enum DevelopmentActivityStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum CoachingRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

enum CoachingFrequency {
  WEEKLY
  BI_WEEKLY
  MONTHLY
}

model DevelopmentPlan {
  id        String @id @default(cuid())
  companyId String

  staffRecordId    String // the employee who owns the plan
  title            String // "Development Objective"
  description      String? // optional longer objective text for the drawer
  competencyId     String? // API requires it on create; the card falls back to "General" when null
  careerAlignment  String? // free text, e.g. "Senior Engineering Manager"
  mentorId         String? // defaults to the employee's manager when not chosen
  careerAssignment CareerDevelopmentAssignment?

  status      DevelopmentPlanStatus @default(ACTIVE)
  progress    Int                   @default(0) // 0-100; derived from milestones when any exist, manual otherwise
  startDate   DateTime              @default(now())
  targetDate  DateTime? // UI shows "TBD" when null
  completedAt DateTime? // set when progress reaches 100, cleared if reopened
  archivedAt  DateTime?

  createdById String // the employee (HR/manager creating on someone's behalf is a later option)

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staffRecord StaffRecord  @relation("DevelopmentPlanOwner", fields: [staffRecordId], references: [id])
  competency  Competency?  @relation(fields: [competencyId], references: [id])
  mentor      StaffRecord? @relation("DevelopmentPlanMentor", fields: [mentorId], references: [id])
  createdBy   StaffRecord  @relation("DevelopmentPlanCreator", fields: [createdById], references: [id])

  milestones       DevelopmentMilestone[]
  activities       DevelopmentPlanActivity[]
  evidence         DevelopmentPlanEvidence[]
  coachingRequests DevelopmentCoachingRequest[]
  history          DevelopmentPlanHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, staffRecordId, status])
  @@index([companyId, status, targetDate])
  @@index([staffRecordId])
  @@index([competencyId])
  @@index([mentorId])
}

// Checklist items (drawer + UpdateProgressModal). May be hard-deleted
// (same exception as goal milestones).
model DevelopmentMilestone {
  id           String    @id @default(cuid())
  planId       String
  title        String
  dueDate      DateTime? // drives "Next Checkpoint" on the card
  isDone       Boolean   @default(false)
  completedAt  DateTime?
  displayOrder Int       @default(0)

  plan DevelopmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId, displayOrder])
  @@index([planId, isDone])
  @@index([dueDate])
}

// The icon chips on each plan card (course, coaching, certification, ...)
model DevelopmentPlanActivity {
  id                  String                    @id @default(cuid())
  planId              String
  type                DevelopmentActivityType
  title               String // tooltip label on the card
  status              DevelopmentActivityStatus @default(PLANNED)
  dueDate             DateTime?
  completedAt         DateTime?
  displayOrder        Int                       @default(0)
  trainingProgramId   String? // optional link into the Training module
  certificationTypeId String? // optional link into Certifications
  coachingRequestId   String?                   @unique // set when an accepted coaching request creates this activity

  plan              DevelopmentPlan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  trainingProgram   TrainingProgram?            @relation(fields: [trainingProgramId], references: [id])
  certificationType CertificationType?          @relation(fields: [certificationTypeId], references: [id])
  coachingRequest   DevelopmentCoachingRequest? @relation(fields: [coachingRequestId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([trainingProgramId])
  @@index([certificationTypeId])
}

// "Evidence & Documentation". Stored directly in PostgreSQL bytea, with optional fileUrl for legacy paths.
model DevelopmentPlanEvidence {
  id           String  @id @default(cuid())
  planId       String
  fileName     String
  fileUrl      String? // optional for legacy disk-stored records
  mimeType     String? // informational, e.g. "application/pdf"
  sizeBytes    Int? // informational, shown as "1.2 MB" in the drawer
  data         Bytes? // raw binary data stored directly in PostgreSQL bytea
  uploadedById String
  isArchived   Boolean @default(false) // "Remove" in the UI: soft delete

  plan       DevelopmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  uploadedBy StaffRecord     @relation("DevelopmentEvidenceUploader", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([planId])
  @@index([uploadedById])
}

// "Request Coaching". Fields mirror RequestCoachingModal: coach, competency
// focus, preferred schedule, message. The respond* columns are for a coach-side
// action that has no UI yet.
model DevelopmentCoachingRequest {
  id                String                @id @default(cuid())
  companyId         String
  planId            String
  requesterId       String // the employee
  coachId           String? // chosen coach; the modal preselects the plan mentor
  focusCompetencyId String? // "Competency Focus"; defaults to the plan's competency
  frequency         CoachingFrequency     @default(BI_WEEKLY)
  message           String // required by the modal
  status            CoachingRequestStatus @default(PENDING)
  respondedById     String?
  respondedAt       DateTime?
  responseNote      String?

  company         Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan            DevelopmentPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  requester       StaffRecord              @relation("CoachingRequester", fields: [requesterId], references: [id])
  coach           StaffRecord?             @relation("CoachingCoach", fields: [coachId], references: [id])
  responder       StaffRecord?             @relation("CoachingResponder", fields: [respondedById], references: [id])
  focusCompetency Competency?              @relation(fields: [focusCompetencyId], references: [id])
  activity        DevelopmentPlanActivity?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([companyId, status])
  @@index([coachId, status])
  @@index([requesterId])
}

// Audit trail and the data source for the Timeline. `note` carries the notes from
// "Update Progress"; previousData/newData carry { progress, milestonesDone, milestonesTotal }.
model DevelopmentPlanHistory {
  id           String  @id @default(cuid())
  planId       String
  companyId    String? // denormalized, same convention as the other history tables
  action       String // CREATED, UPDATED, PROGRESS_UPDATED, MILESTONE_ADDED, MILESTONE_COMPLETED, MILESTONE_REOPENED, EVIDENCE_ADDED, EVIDENCE_REMOVED, COACHING_REQUESTED, COMPLETED, REOPENED, ARCHIVED, DUPLICATED
  actorId      String
  note         String?
  previousData Json?
  newData      Json?

  plan  DevelopmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  actor StaffRecord     @relation("DevelopmentHistoryActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([planId])
  @@index([actorId])
  @@index([createdAt])
  @@index([companyId, createdAt])
}

// PIP Manager Workspace
enum PipStatus {
  DRAFT
  ACTIVE
  ESCALATED // set when an escalation is raised (modeled with the EscalationModal batch)
  COMPLETED // closed normally; see outcome
  CANCELLED // withdrawn before completion; the soft alternative to deleting a draft
}

enum PipOutcome {
  SUCCESSFUL
  UNSUCCESSFUL
}

// Mirrors the modal's four checkboxes
enum PipIssueCategory {
  PRODUCTIVITY_OUTPUT // "Productivity / Output"
  BEHAVIOR_CONDUCT // "Behavior & Conduct"
  SKILL_GAP // "Skill Gap / Technical"
  ATTENDANCE_POLICY // "Attendance / Policy"
}

enum PipMilestoneStatus {
  PENDING
  COMPLETED
  // "Overdue" is derived: PENDING and dueDate in the past
}

enum PipSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  // "Upcoming" and "Overdue" are derived: SCHEDULED with scheduledAt in the future or past
}

enum PipActionItemStatus {
  OPEN
  DONE
  CANCELLED
}
enum PipKpiSnapshotKind {
  BASELINE // written at activation
  CHECKPOINT // written when progress changes (see decision 42)
  FINAL // written at close
}

// The real plan. PerformanceAction type PIP stays the lightweight "intent" record.
model Pip {
  id            String  @id @default(cuid())
  companyId     String
  number        Int // shown as PIP-001; allocated as max+1 per company inside the create transaction
  staffRecordId String // the employee on the plan
  managerId     String? // manager of record, snapshotted at creation; null if the employee has no manager
  createdById   String // may differ from managerId when HR/ADMIN creates it

  // Optional origin links (a PIP is not cycle-bound)
  cycleId             String?
  managerReviewId     String? @unique // the review whose recommendation was PIP
  performanceActionId String? @unique // the PIP-type action it was launched from

  status     PipStatus          @default(DRAFT)
  outcome    PipOutcome? // only when COMPLETED
  openKey    String?            @unique // = staffRecordId while DRAFT/ACTIVE/ESCALATED, null once closed; enforces one open PIP per employee
  categories PipIssueCategory[]
  objectives String? // "Objectives & Success Criteria"; required to activate, optional for a draft

  startDate   DateTime // date-only, stored at UTC midnight
  targetDate  DateTime
  activatedAt DateTime?
  closedAt    DateTime?

  issueSummary       String? // "Issue Summary" in the drawer; new optional field in the create/edit modal
  originalTargetDate DateTime? // set at activation; differs from targetDate once the plan is extended
  closureNote        String? // required when COMPLETED, or when an activated PIP is CANCELLED

  // Frozen at creation so the card and history don't change if the profile does
  roleTitle      String? // snapshot of designation.title, else staffRecord.position
  designationId  String? // snapshot of staffRecord.designationId; null if the employee has none
  departmentId   String?
  departmentName String?
  acknowledgedAt DateTime?
  targetScore    Int       @default(75)

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staffRecord       StaffRecord        @relation("PipSubject", fields: [staffRecordId], references: [id])
  manager           StaffRecord?       @relation("PipManager", fields: [managerId], references: [id])
  createdBy         StaffRecord        @relation("PipCreator", fields: [createdById], references: [id])
  cycle             AppraisalCycle?    @relation(fields: [cycleId], references: [id])
  managerReview     ManagerReview?     @relation(fields: [managerReviewId], references: [id])
  performanceAction PerformanceAction? @relation(fields: [performanceActionId], references: [id])
  department        Department?        @relation(fields: [departmentId], references: [id])
  designation       Designation?       @relation(fields: [designationId], references: [id])

  milestones            PipMilestone[]
  history               PipHistory[]
  sessions              PipCoachingSession[]
  actionItems           PipActionItem[]
  escalations           AppraisalEscalation[]
  kpiSnapshots          PipKpiSnapshot[]
  improvementObjectives PipImprovementObjective[]
  trainings             PipTraining[]
  weeklyCheckIns        PipWeeklyCheckIn[]
  supportRequests       PipSupportRequest[]
  evidence              PipEvidence[]
  progressDrafts        PipProgressDraft[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([managerId, status])
  @@index([staffRecordId])
  @@index([cycleId])
  @@index([targetDate])
  @@index([companyId, closedAt])
  @@index([companyId, departmentId])
  @@index([companyId, designationId])
}

// Drives "6 of 8 milestones completed", progress, overdue and next review.
// Created and edited from the detail drawer and timeline (refined in the next batch).
model PipMilestone {
  id             String             @id @default(cuid())
  pipId          String
  title          String
  description    String?
  dueDate        DateTime
  status         PipMilestoneStatus @default(PENDING)
  completedAt    DateTime?
  displayOrder   Int
  removedAt      DateTime? // soft remove, excluded from counts
  completionNote String?

  improvementObjectiveId String? // employee "tasks" on an objective card
  employeeReflection     String? // employee's "Add Reflection"; never overwrites description
  reflectionAt           DateTime?

  improvementObjective PipImprovementObjective? @relation(fields: [improvementObjectiveId], references: [id])

  pip Pip @relation(fields: [pipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pipId, status])
  @@index([dueDate])
  @@index([improvementObjectiveId])
}

model PipHistory {
  id           String  @id @default(cuid())
  pipId        String
  companyId    String?
  action       String // ...as before, plus SESSION_SCHEDULED, SESSION_LOGGED, SESSION_UPDATED, SESSION_COMPLETED, SESSION_CANCELLED, ACTION_ITEM_ADDED, ACTION_ITEM_RESOLVED, ACTION_ITEM_REMOVED (more to follow)
  actorId      String
  previousData Json? // only the changed fields
  newData      Json?

  pip   Pip         @relation(fields: [pipId], references: [id], onDelete: Cascade)
  actor StaffRecord @relation("PipHistoryActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([pipId])
  @@index([actorId])
  @@index([createdAt])
  @@index([companyId, createdAt])
}

// One row per coaching or review meeting. The same modal both schedules a future
// session and logs a past one.
model PipCoachingSession {
  id          String           @id @default(cuid())
  pipId       String
  createdById String // the manager or HR user who logged it; shown as the note author
  scheduledAt DateTime // a UTC instant, combined from the modal's date and time
  objectives  String // "Session Objectives"; shown as the focus line
  notes       String? // "Discussion Notes"; required when COMPLETED
  status      PipSessionStatus @default(SCHEDULED)
  completedAt DateTime?
  cancelledAt DateTime?

  improvementObjectiveId String?
  sharedWithEmployee     Boolean   @default(false) // notes hidden from the employee until the manager shares them
  employeeReflection     String?
  reflectionAt           DateTime?

  pip                  Pip                      @relation(fields: [pipId], references: [id], onDelete: Cascade)
  createdBy            StaffRecord              @relation("PipSessionCreator", fields: [createdById], references: [id])
  improvementObjective PipImprovementObjective? @relation(fields: [improvementObjectiveId], references: [id])

  actionItems PipActionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pipId, status])
  @@index([status, scheduledAt])
  @@index([createdById])
  @@index([improvementObjectiveId])
}

// Follow-ups from the modal's "action items", and the source of the hero's
// "Unresolved Blockers". Not tied to PerformanceAction, which stays the
// manager-level intent record.
model PipActionItem {
  id          String              @id @default(cuid())
  pipId       String
  sessionId   String? // null when added from the drawer
  createdById String
  title       String
  isBlocker   Boolean             @default(false)
  dueDate     DateTime? // date-only, UTC midnight
  status      PipActionItemStatus @default(OPEN)
  resolvedAt  DateTime?

  pip       Pip                 @relation(fields: [pipId], references: [id], onDelete: Cascade)
  session   PipCoachingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdBy StaffRecord         @relation("PipActionItemCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pipId, status])
  @@index([sessionId])
  @@index([createdById])
}

// Feeds the "Average KPI Improvement Trend". Historical KPI can't be rebuilt reliably
// at read time, so it is captured at the moments a PIP is touched. Immutable.
model PipKpiSnapshot {
  id         String             @id @default(cuid())
  pipId      String
  kind       PipKpiSnapshotKind
  kpiScore   Float // 0-100, same formula as ManagerReview.kpiScore
  goalCount  Int // goals behind the score
  capturedAt DateTime           @default(now())

  pip Pip @relation(fields: [pipId], references: [id], onDelete: Cascade)

  @@index([pipId, capturedAt])
  @@index([capturedAt])
}

// Escalation thread. Immutable, with no updatedAt and no edit or delete routes,
// like PerformanceOpsNote. The modal's "Initial HR Comments" becomes the first row.
model AppraisalEscalationComment {
  id           String @id @default(cuid())
  escalationId String
  authorId     String
  message      String

  escalation AppraisalEscalation @relation(fields: [escalationId], references: [id], onDelete: Cascade)
  author     StaffRecord         @relation("EscalationCommentAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([escalationId, createdAt])
  @@index([authorId])
}

// "Supporting Documentation". Stored directly in PostgreSQL bytea. Soft-removed.
model AppraisalEscalationAttachment {
  id           String    @id @default(cuid())
  escalationId String
  fileName     String
  fileUrl      String? // optional for legacy disk-stored records
  mimeType     String? // e.g. "application/pdf"
  sizeBytes    Int? // file size in bytes
  data         Bytes? // raw binary data stored directly in PostgreSQL bytea
  uploadedBy   String
  removedAt    DateTime?

  escalation AppraisalEscalation @relation(fields: [escalationId], references: [id], onDelete: Cascade)
  uploader   StaffRecord         @relation("EscalationAttachmentUploader", fields: [uploadedBy], references: [id])

  createdAt DateTime @default(now())

  @@index([escalationId])
  @@index([uploadedBy])
}

// PIP View
enum PipSeverity {
  CRITICAL
  HIGH
  MEDIUM
}

enum PipSupportType {
  COACHING_SESSION // "1:1 Coaching Session"
  TECHNICAL_MENTORSHIP // "Technical Mentorship"
  TRAINING_MATERIALS // "Additional Training Materials"
  HR_CONSULTATION // "HR Consultation"
}

enum PipSupportStatus {
  OPEN
  ACCEPTED
  DECLINED
  RESOLVED
}

enum PipSupportSchedule {
  THIS_WEEK
  NEXT_WEEK
  WITHIN_TWO_WEEKS
}

model PipImprovementObjective {
  id           String      @id @default(cuid())
  pipId        String
  title        String
  competency   String? // free text, shown on the card
  kpi          String? // KPI / metric name
  baseline     String? // e.g. "48 hrs"
  target       String? // e.g. "12 hrs"
  severity     PipSeverity @default(MEDIUM)
  progress     Int         @default(0) // 0-100, set by the employee
  dueDate      DateTime? // date-only, UTC midnight
  completedAt  DateTime?
  displayOrder Int         @default(0)
  removedAt    DateTime?

  pip              Pip                  @relation(fields: [pipId], references: [id], onDelete: Cascade)
  progressUpdates  PipProgressUpdate[]
  milestones       PipMilestone[]
  trainings        PipTraining[]
  coachingSessions PipCoachingSession[]
  expectations     String? // the manager's "Manager Expectations" quote
  evidence         PipEvidence[]
  progressDrafts   PipProgressDraft[]
  supportRequests  PipSupportRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pipId])
}

// Immutable log behind "Update progress" and its reflection note.
model PipProgressUpdate {
  id                     String   @id @default(cuid())
  pipId                  String
  improvementObjectiveId String
  previousProgress       Int
  progress               Int
  note                   String?
  createdById            String
  createdAt              DateTime @default(now())

  improvementObjective PipImprovementObjective @relation(fields: [improvementObjectiveId], references: [id], onDelete: Cascade)

  evidence PipEvidence[]

  @@index([improvementObjectiveId, createdAt])
  @@index([pipId, createdAt])
}

model PipTraining {
  id                     String             @id @default(cuid())
  pipId                  String
  improvementObjectiveId String?
  trainingProgramId      String?
  certificationTypeId    String?
  title                  String
  status                 PipMilestoneStatus @default(PENDING)
  dueDate                DateTime?
  completedAt            DateTime?
  assignedById           String
  removedAt              DateTime?

  pip                  Pip                      @relation(fields: [pipId], references: [id], onDelete: Cascade)
  improvementObjective PipImprovementObjective? @relation(fields: [improvementObjectiveId], references: [id])
  trainingProgram      TrainingProgram?         @relation(fields: [trainingProgramId], references: [id])
  certificationType    CertificationType?       @relation(fields: [certificationTypeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pipId])
  @@index([improvementObjectiveId])
  @@index([trainingProgramId])
  @@index([certificationTypeId])
}

// Manager-entered weekly metrics for the employee's recovery chart.
// Separate from PipKpiSnapshot, which is the goal-derived KPI score for manager analytics.
model PipWeeklyCheckIn {
  id                String   @id @default(cuid())
  pipId             String
  weekStart         DateTime @db.Date
  productivityScore Int // 0-100
  qualityScore      Int // 0-100
  recoveryScore     Int // 0-100, frozen at record time
  note              String?
  recordedById      String

  pip Pip @relation(fields: [pipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pipId, weekStart])
}

// Employee's "Request support" dialog (shape inferred; PipModals not seen).
model PipSupportRequest {
  id            String           @id @default(cuid())
  pipId         String
  staffRecordId String
  type          PipSupportType   @default(COACHING_SESSION)
  message       String
  status        PipSupportStatus @default(OPEN)
  response      String?
  respondedById String?
  respondedAt   DateTime?

  preferredSchedule      PipSupportSchedule       @default(THIS_WEEK)
  improvementObjectiveId String? // set when requested from an objective's drawer
  improvementObjective   PipImprovementObjective? @relation(fields: [improvementObjectiveId], references: [id])

  pip         Pip         @relation(fields: [pipId], references: [id], onDelete: Cascade)
  staffRecord StaffRecord @relation("PipSupportRequester", fields: [staffRecordId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pipId, status])
  @@index([staffRecordId])
  @@index([improvementObjectiveId])
}

// Files on an objective: uploaded from the drawer, or attached to a progress update.
// Stored directly in PostgreSQL bytea, with optional fileUrl for legacy paths.
model PipEvidence {
  id                     String    @id @default(cuid())
  pipId                  String
  improvementObjectiveId String
  progressUpdateId       String? // set when attached through "Submit Update"
  uploadedById           String
  fileName               String
  fileUrl                String? // optional for legacy disk-stored records
  mimeType               String? // e.g. "application/pdf"
  sizeBytes              Int? // file size in bytes
  data                   Bytes? // raw binary data stored directly in PostgreSQL bytea
  removedAt              DateTime? // soft remove; no route yet because the UI has no remove button

  pip                  Pip                     @relation(fields: [pipId], references: [id], onDelete: Cascade)
  improvementObjective PipImprovementObjective @relation(fields: [improvementObjectiveId], references: [id], onDelete: Cascade)
  progressUpdate       PipProgressUpdate?      @relation(fields: [progressUpdateId], references: [id], onDelete: SetNull)
  uploadedBy           StaffRecord             @relation("PipEvidenceUploader", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([pipId])
  @@index([improvementObjectiveId, createdAt])
  @@index([progressUpdateId])
  @@index([uploadedById])
}

// "Save Draft" in the update dialog. One per objective per employee, overwritten on save,
// deleted on submit.
model PipProgressDraft {
  id                     String   @id @default(cuid())
  pipId                  String
  improvementObjectiveId String
  staffRecordId          String
  progress               Int
  note                   String?
  completedTaskIds       String[] // checklist items ticked but not yet submitted
  evidence               Json? // [{ fileName, fileUrl }] uploaded but not yet submitted

  pip                  Pip                     @relation(fields: [pipId], references: [id], onDelete: Cascade)
  improvementObjective PipImprovementObjective @relation(fields: [improvementObjectiveId], references: [id], onDelete: Cascade)
  staffRecord          StaffRecord             @relation("PipProgressDraftOwner", fields: [staffRecordId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([improvementObjectiveId, staffRecordId])
  @@index([pipId])
}

// Promotion Recommendation Workspace
enum PromotionStatus {
  DRAFT
  SUBMITTED // "Submit to HR"; waiting for an HR decision
  APPROVED
  REJECTED
  WITHDRAWN // pulled back by the recommender; the soft alternative to deleting
}

// Snapshot label only. Live readiness is derived at read time (decision 4).
enum PromotionReadiness {
  READY // "Promotion Ready"
  HIGH_POTENTIAL
  UNDER_OBSERVATION
}

enum CareerActionType {
  LEADERSHIP_PROGRAM
  TECHNICAL_TRAINING
  MENTORSHIP
  STRETCH_ASSIGNMENT
}

enum CriticalRoleStatus {
  ACTIVE
  ARCHIVED
}

enum SuccessionReadiness {
  READY_NOW // "Ready Now (1-6 Months)"
  READY_1_2_YEARS
  READY_3_5_YEARS
}
model PromotionRecommendation {
  id            String @id @default(cuid())
  companyId     String
  staffRecordId String // the candidate
  createdById   String // the manager or HR user who wrote it

  // Optional origin links (a recommendation is not cycle-bound)
  cycleId       String? // cycle whose results were the basis
  basisReviewId String? // the submitted ManagerReview the scores came from

  status  PromotionStatus @default(DRAFT)
  openKey String?         @unique // = staffRecordId while DRAFT or SUBMITTED, null once decided or withdrawn

  // Frozen at creation, so history doesn't change if the profile does
  currentDesignationId String?
  currentRoleTitle     String? // designation.title, else staffRecord.position
  departmentId         String?
  departmentName       String?

  // The ask
  targetDesignationId   String
  targetRoleTitle       String // snapshot of the target designation's title
  effectiveDate         DateTime // date-only, UTC midnight
  justification         String? // "Promotion Justification & Business Impact"; required to submit
  projectedSalaryChange Decimal? @db.Decimal(18, 2) // estimated compensation impact

  // Frozen at submit (0-100, like every other score)
  overallScore    Float?
  kpiScore        Float?
  leadershipScore Float?
  potential       PotentialLevel?
  readiness       PromotionReadiness?

  submittedAt  DateTime?
  decidedAt    DateTime?
  decidedById  String?
  decisionNote String? // required on reject
  withdrawnAt  DateTime?

  company            Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staffRecord        StaffRecord     @relation("PromotionSubject", fields: [staffRecordId], references: [id])
  createdBy          StaffRecord     @relation("PromotionCreator", fields: [createdById], references: [id])
  decidedBy          StaffRecord?    @relation("PromotionDecider", fields: [decidedById], references: [id])
  cycle              AppraisalCycle? @relation(fields: [cycleId], references: [id])
  basisReview        ManagerReview?  @relation("PromotionBasisReview", fields: [basisReviewId], references: [id])
  currentDesignation Designation?    @relation("PromotionCurrentDesignation", fields: [currentDesignationId], references: [id])
  targetDesignation  Designation     @relation("PromotionTargetDesignation", fields: [targetDesignationId], references: [id])
  department         Department?     @relation(fields: [departmentId], references: [id])

  attachments PromotionAttachment[]
  history     PromotionHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([staffRecordId, status])
  @@index([createdById])
  @@index([cycleId])
  @@index([companyId, departmentId])
  @@index([targetDesignationId])
  @@index([companyId, decidedAt])
}

// "Supporting Documentation". Stored directly in PostgreSQL bytea. Soft-removed.
model PromotionAttachment {
  id               String    @id @default(cuid())
  recommendationId String
  fileName         String
  fileUrl          String? // optional for legacy disk-stored records
  mimeType         String? // e.g. "application/pdf"
  sizeBytes        Int? // file size in bytes
  data             Bytes? // raw binary data stored directly in PostgreSQL bytea
  uploadedBy       String
  removedAt        DateTime?

  recommendation PromotionRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  uploader       StaffRecord             @relation("PromotionAttachmentUploader", fields: [uploadedBy], references: [id])

  createdAt DateTime @default(now())

  @@index([recommendationId])
  @@index([uploadedBy])
}

model PromotionHistory {
  id               String  @id @default(cuid())
  recommendationId String
  companyId        String?
  action           String // CREATED, UPDATED, SUBMITTED, APPROVED, REJECTED, WITHDRAWN, ATTACHMENT_ADDED, ATTACHMENT_REMOVED (more to follow)
  actorId          String
  previousData     Json? // only the changed fields; justification logged as "changed", never full text
  newData          Json?

  recommendation PromotionRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  actor          StaffRecord             @relation("PromotionHistoryActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([recommendationId])
  @@index([actorId])
  @@index([createdAt])
  @@index([companyId, createdAt])
}

// Marks a manager-assigned DevelopmentPlan. The plan and its activity hold the
// real content; this row keeps what they can't (who assigned it, the action type, the follow-up).
model CareerDevelopmentAssignment {
  id            String           @id @default(cuid())
  companyId     String
  staffRecordId String // the employee
  assignedById  String // the manager or HR user
  planId        String           @unique
  actionType    CareerActionType
  followUpDate  DateTime? // date-only, UTC midnight; informational

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staffRecord StaffRecord     @relation("CareerAssignmentSubject", fields: [staffRecordId], references: [id])
  assignedBy  StaffRecord     @relation("CareerAssignmentAssigner", fields: [assignedById], references: [id])
  plan        DevelopmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([companyId, staffRecordId])
  @@index([assignedById])
}

// A role HR has designated as critical. Title and department come from the designation.
model CriticalRole {
  id            String             @id @default(cuid())
  companyId     String
  designationId String
  status        CriticalRoleStatus @default(ACTIVE)
  createdById   String // HR/Admin who designated it
  archivedAt    DateTime?
  tier          CriticalRoleTier?

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  designation Designation @relation(fields: [designationId], references: [id])
  createdBy   StaffRecord @relation("CriticalRoleCreator", fields: [createdById], references: [id])

  candidates SuccessionCandidate[]
  history    SuccessionHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, designationId]) // archiving and restoring flips status; no duplicates
  @@index([companyId, status])
  @@index([companyId, tier])
}

model SuccessionCandidate {
  id                 String              @id @default(cuid())
  companyId          String
  criticalRoleId     String
  staffRecordId      String // the successor
  nominatedById      String
  readiness          SuccessionReadiness
  developmentActions String? // "Required Development Actions"
  activeKey          String?             @unique // `${criticalRoleId}:${staffRecordId}` while active, null once removed
  removedAt          DateTime? // soft remove

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  criticalRole CriticalRole @relation(fields: [criticalRoleId], references: [id])
  staffRecord  StaffRecord  @relation("SuccessionSubject", fields: [staffRecordId], references: [id])
  nominatedBy  StaffRecord  @relation("SuccessionNominator", fields: [nominatedById], references: [id])

  history SuccessionHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, staffRecordId])
  @@index([criticalRoleId, readiness])
  @@index([nominatedById])
}

model SuccessionHistory {
  id             String  @id @default(cuid())
  companyId      String?
  criticalRoleId String
  candidateId    String?
  action         String // ROLE_DESIGNATED, ROLE_ARCHIVED, ROLE_RESTORED, CANDIDATE_ADDED, CANDIDATE_UPDATED, CANDIDATE_REMOVED
  actorId        String
  previousData   Json? // only the changed fields; development actions logged as "changed", never full text
  newData        Json?

  criticalRole CriticalRole         @relation(fields: [criticalRoleId], references: [id], onDelete: Cascade)
  candidate    SuccessionCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  actor        StaffRecord          @relation("SuccessionHistoryActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([criticalRoleId])
  @@index([candidateId])
  @@index([actorId])
  @@index([createdAt])
  @@index([companyId, createdAt])
}

// Performance Comparison
enum ComparisonReportType {
  DEPARTMENT_BENCHMARK
  PEER_COMPARISON
  EMPLOYEE_PROFILE
}

enum ComparisonReportStatus {
  DRAFT // saved config, no snapshot yet
  GENERATED // snapshot frozen
  SHARED // shared with HR
  ARCHIVED // soft removal
}

// A saved comparison report. The config is the definition; the snapshot is
// the frozen result, so a shared report never changes after the fact.
model ComparisonReport {
  id          String                 @id @default(cuid())
  companyId   String
  createdById String
  cycleId     String // the basis cycle
  type        ComparisonReportType
  title       String
  status      ComparisonReportStatus @default(GENERATED)

  // What was asked for (the filters, picks and metrics at the time)
  config Json // { filters, competencyIds, staffRecordIds?, departmentIds?, metrics[], timeframe }

  // What was produced. Frozen at generation. Null while DRAFT.
  snapshot    Json?
  generatedAt DateTime?
  sharedAt    DateTime?
  sharedNote  String?
  archivedAt  DateTime?

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy StaffRecord    @relation("ComparisonReportCreator", fields: [createdById], references: [id])
  cycle     AppraisalCycle @relation(fields: [cycleId], references: [id])

  history ComparisonReportHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([createdById, status])
  @@index([cycleId])
  @@index([companyId, generatedAt])
}

model ComparisonReportHistory {
  id           String  @id @default(cuid())
  reportId     String
  companyId    String?
  action       String // CREATED, GENERATED, SHARED, EXPORTED, ARCHIVED (more to follow)
  actorId      String
  previousData Json?
  newData      Json?

  report ComparisonReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actor  StaffRecord      @relation("ComparisonReportHistoryActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([actorId])
  @@index([createdAt])
  @@index([companyId, createdAt])
}

// =============================================================================
// AUDIT & COMPLIANCE LOG (Performance & Appraisal)
// Backs frontend/src/components/performance-appraisal/audit/*
// =============================================================================

enum AuditRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// UI statuses: Verified | Approved | Pending Review | Warning | Compliance Issue | Escalated | Resolved
enum AuditEventStatus {
  VERIFIED
  APPROVED
  PENDING_REVIEW
  WARNING
  COMPLIANCE_ISSUE
  ESCALATED
  RESOLVED
}

// UI entity filter: Calibration | Review | Promotion | Competency | Goal | Template ...
enum AuditEntityType {
  CALIBRATION
  REVIEW
  PROMOTION
  COMPETENCY
  GOAL
  TEMPLATE
  APPRAISAL_CYCLE
  PIP
  FEEDBACK
  RULE
  FAIRNESS
  OTHER
}

enum AuditCaseStatus {
  REVIEWING
  IN_PROGRESS
  ESCALATED
  RESOLVED
}

// Verdict select in ComplianceInvestigationModal
enum AuditCaseVerdict {
  PENDING_VERIFICATION
  VIOLATION_CONFIRMED
  CLEARED_FALSE_ALARM
  REQUIRES_HR_ESCALATION
}

enum AuditAnomalyStatus {
  OPEN
  INVESTIGATING
  DISMISSED
  RESOLVED
}

enum AuditExportKind {
  COMPLIANCE_REPORT // Export Report modal (PDF/CSV/XLSX, optional weekly schedule)
  AUDIT_PACKAGE // Generate Package modal (.zip, optionally sent to auditor)
  RECORD_EVIDENCE // single-record signed PDF
}

enum AuditExportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  SCHEDULED
}

// Append-only forensic ledger. Rows are never updated except the review-state
// fields (status/risk/flagged/resolved*). Hash chain makes tampering detectable.
model PerformanceAuditEvent {
  id         String   @id @default(cuid())
  companyId  String
  eventRef   String // human id, e.g. EVT-2026-9081 (unique per company)
  occurredAt DateTime @default(now())
  timezone   String? // e.g. "UTC+1"

  // Actor (snapshot columns so the ledger survives staff edits/deletion)
  actorId   String?
  actorName String
  actorRole String?
  actorDept String?
  actorRef  String? // staff number, or SYS-001 for system

  action       String // e.g. "Calibration Score Adjusted"
  entityType   AuditEntityType  @default(OTHER)
  entityId     String? // id of the affected record
  status       AuditEventStatus @default(VERIFIED)
  risk         AuditRiskLevel   @default(LOW)
  sourceSystem String? // Web Application | Mobile App | Scheduler | API
  ipAddress    String?

  beforeValue      String?
  afterValue       String?
  reason           String?
  relatedObjects   Json? // [{ label, value }]
  approvalChain    Json? // [{ step, actor, when }]
  validationResult String?
  auditNote        String?

  flagged      Boolean   @default(false)
  resolvedAt   DateTime?
  resolvedById String?

  prevHash String? // hash of previous event in this company's chain
  hash     String? // sha256(prevHash + canonical payload)

  company    Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor      StaffRecord?             @relation("PerfAuditEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  resolvedBy StaffRecord?             @relation("PerfAuditEventResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  cases      AuditInvestigationCase[]
  anomalies  AuditAnomaly[]

  createdAt DateTime @default(now())

  @@unique([companyId, eventRef])
  @@index([companyId, occurredAt])
  @@index([companyId, entityType, entityId])
  @@index([companyId, risk, status])
  @@index([companyId, actorId])
  @@index([companyId, actorDept])
  @@map("performance_audit_events")
}

model AuditInvestigationCase {
  id             String           @id @default(cuid())
  companyId      String
  caseRef        String // INV-902 (unique per company)
  title          String
  summary        String?
  status         AuditCaseStatus  @default(REVIEWING)
  risk           AuditRiskLevel   @default(MEDIUM)
  verdict        AuditCaseVerdict @default(PENDING_VERIFICATION)
  findings       String?
  assignedToId   String?
  openedById     String?
  relatedEventId String?
  anomalyId      String?          @unique
  escalatedAt    DateTime?
  resolvedAt     DateTime?
  openedAt       DateTime         @default(now())

  company      Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTo   StaffRecord?                 @relation("AuditCaseAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  openedBy     StaffRecord?                 @relation("AuditCaseOpener", fields: [openedById], references: [id], onDelete: SetNull)
  relatedEvent PerformanceAuditEvent?       @relation(fields: [relatedEventId], references: [id], onDelete: SetNull)
  anomaly      AuditAnomaly?                @relation("AuditAnomalyCase", fields: [anomalyId], references: [id], onDelete: SetNull)
  notes        AuditInvestigationCaseNote[]

  updatedAt DateTime @updatedAt

  @@unique([companyId, caseRef])
  @@index([companyId, status])
  @@index([companyId, assignedToId])
  @@index([relatedEventId])
  @@map("audit_investigation_cases")
}

model AuditInvestigationCaseNote {
  id        String   @id @default(cuid())
  caseId    String
  authorId  String?
  action    String // NOTE | STATUS_CHANGE | VERDICT | ESCALATION
  content   String
  metadata  Json?
  createdAt DateTime @default(now())

  case   AuditInvestigationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author StaffRecord?           @relation("AuditCaseNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@map("audit_investigation_case_notes")
}

// System-detected suspicious activity ("Suspicious Activity Panel")
model AuditAnomaly {
  id             String             @id @default(cuid())
  companyId      String
  anomalyRef     String // ANOM-01
  ruleKey        String? // detector, e.g. REPEATED_RATING_CHANGES | BACKDATED_SUBMISSION
  severity       AuditRiskLevel     @default(HIGH)
  title          String
  detail         String
  affectedUserId String?
  affectedRecord String?
  recommendation String?
  status         AuditAnomalyStatus @default(OPEN)
  sourceEventId  String?
  detectedAt     DateTime           @default(now())
  resolvedAt     DateTime?

  company      Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  affectedUser StaffRecord?            @relation("AuditAnomalySubject", fields: [affectedUserId], references: [id], onDelete: SetNull)
  sourceEvent  PerformanceAuditEvent?  @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)
  case         AuditInvestigationCase? @relation("AuditAnomalyCase")

  @@unique([companyId, anomalyRef])
  @@index([companyId, status, severity])
  @@index([companyId, detectedAt])
  @@map("audit_anomalies")
}

// Export Report / Generate Audit Package / single-record evidence
model AuditExportJob {
  id             String            @id @default(cuid())
  companyId      String
  kind           AuditExportKind
  status         AuditExportStatus @default(QUEUED)
  format         String? // PDF | CSV | XLSX | ZIP
  dateRange      String? // This Quarter | Year to Date | custom
  rangeFrom      DateTime?
  rangeTo        DateTime?
  filters        Json? // snapshot of ledger filters applied
  includedItems  Json? // package record sets
  eventId        String? // for RECORD_EVIDENCE
  recipientEmail String? // auditor, when "send"
  isScheduled    Boolean           @default(false)
  scheduleCron   String? // e.g. weekly
  fileUrl        String?
  requestedById  String?
  completedAt    DateTime?
  errorMessage   String?

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestedBy StaffRecord? @relation("AuditExportRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, kind, createdAt])
  @@index([companyId, isScheduled])
  @@map("audit_export_jobs")
}

// Periodic metric snapshot: Compliance Monitoring trackers + KPI trend/archival
// (Policy Adherence, Audit Readiness, Documentation Completeness, violation counts)
model AuditComplianceSnapshot {
  id                  String   @id @default(cuid())
  companyId           String
  snapshotDate        DateTime
  policyAdherencePct  Float    @default(0)
  auditReadinessPct   Float    @default(0)
  documentationPct    Float    @default(0)
  complianceHealthPct Float    @default(0)
  totalEvents         Int      @default(0)
  overdueReviews      Int      @default(0)
  policyViolations    Int      @default(0)
  unauthorizedMods    Int      @default(0)
  openCases           Int      @default(0)
  deptRisk            Json? // [{ dept, risk, value }] heatmap
  createdAt           DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, snapshotDate])
  @@map("audit_compliance_snapshots")
}

// Promotion and Succession
// "Leadership Level" in the report modal. Set by HR when a role is designated; null = unclassified.
enum CriticalRoleTier {
  EXECUTIVE // "C-Suite & SVP"
  DIRECTOR // "Director"
  MANAGER // "Manager"
}

// One row per company per day, written lazily the first time the dashboard is read that day.
// Counts only: every percentage is computed from them. Immutable, so there is no updatedAt.
// Always computed company-wide, whoever triggers it. Mobility is not stored, since StaffCareerHistory,
// DepartmentStaffHistory and Offboarding already carry dates.
model SuccessionMetricSnapshot {
  id           String   @id @default(cuid())
  companyId    String
  capturedOn   DateTime // date-only, UTC midnight
  basisCycleId String? // the cycle the promotion counts were computed on (descriptive only)

  // Succession (from CriticalRole and SuccessionCandidate)
  criticalRoles        Int // active critical roles
  readyRoles           Int // LOW risk: a Ready Now successor
  coveredRoles         Int // not HIGH risk: a successor within 2 years
  vacantRoles          Int // no active holder
  singleIncumbentRoles Int // exactly one active holder
  successors           Int // active nominations

  // Promotion (from the candidate pool and PromotionRecommendation)
  poolSize           Int
  readyCount         Int // READY
  highPotentialCount Int // HIGH_POTENTIAL
  observationCount   Int // UNDER_OBSERVATION
  hipoCount          Int // pool members with HIGH potential
  emergingCount      Int // pool members with MEDIUM potential and a score above 75
  pendingRequests    Int // SUBMITTED recommendations

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([companyId, capturedOn])
  @@index([companyId, capturedOn])
}

enum SuccessionReportType {
  SUCCESSION_REPORT // "Generate Succession Report"
  BOARD_PACK // "Board Export"
}

enum SuccessionReportStatus {
  GENERATED
  SHARED // shared in-app with named users
  ARCHIVED // soft removal
}

// A saved report or board pack. The snapshot is frozen at generation, so a shared pack never changes.
// Separate from ComparisonReport on purpose: that model requires a cycle and its routes read cycle.name.
model SuccessionReport {
  id          String                 @id @default(cuid())
  companyId   String
  createdById String
  type        SuccessionReportType
  title       String
  status      SuccessionReportStatus @default(GENERATED)

  config   Json // { departmentId?, tier?, modules[] }
  snapshot Json // frozen { sections[], cycle, generatedFor }

  generatedAt   DateTime  @default(now())
  sharedWithIds String[]  @default([]) // company-wide staff who can open it in the app
  sharedAt      DateTime?
  sharedNote    String?
  archivedAt    DateTime?

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy StaffRecord @relation("SuccessionReportCreator", fields: [createdById], references: [id])

  history SuccessionReportHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([createdById, status])
  @@index([companyId, generatedAt])
}

model SuccessionReportHistory {
  id           String  @id @default(cuid())
  reportId     String
  companyId    String?
  action       String // CREATED, EXPORTED, SHARED, ARCHIVED
  actorId      String
  previousData Json?
  newData      Json? // EXPORTED: { format }; SHARED: { recipientIds }

  report SuccessionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actor  StaffRecord      @relation("SuccessionReportHistoryActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([actorId])
  @@index([createdAt])
  @@index([companyId, createdAt])
}

// ---------------------------------------------------------------------------
// Performance Intelligence
// ---------------------------------------------------------------------------

enum IntelligenceReportType {
  EXECUTIVE // "Executive Report Generator"
  BOARD // "Export Board Report"
}

enum IntelligenceReportFormat {
  PDF
  PPTX // needs a pptx library; hidden in the UI until one is added
  XLSX
}

enum IntelligenceReportStatus {
  GENERATING
  READY
  FAILED
  PURGED // file and snapshot deleted after retention; the row stays as the audit record
}

// One row per company, created lazily on first use (same pattern as AppraisalWorkflowSettings).
model IntelligenceSettings {
  id        String @id @default(cuid())
  companyId String @unique

  strategicTargetScore Int     @default(80) // the "Strategic Target" line on the trend chart (0-100)
  minGroupSize         Int     @default(3) // departments / units / teams with fewer scored employees are suppressed; 1 disables
  leadershipWeights    Json? // { teamScore, teamGoals, timeliness, development, calibration }: integers summing to 100; null = code defaults (40/25/15/10/10)
  reportRetentionDays  Int     @default(90) // how long generated files and snapshots are kept
  updatedById          String?
  chronicLowCycles     Int     @default(2)

  company   Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  updatedBy StaffRecord?                  @relation("IntelligenceSettingsUpdater", fields: [updatedById], references: [id])
  history   IntelligenceSettingsHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IntelligenceSettingsHistory {
  id           String  @id @default(cuid())
  settingsId   String
  companyId    String?
  action       String // UPDATED
  actorId      String
  previousData Json?
  newData      Json?

  settings IntelligenceSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  actor    StaffRecord          @relation("IntelligenceSettingsActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([settingsId])
  @@index([actorId])
  @@index([companyId, createdAt])
}

// A generated report (both modals). The numbers are frozen in `snapshot`, so a
// re-download or a shared link always shows what the board saw.
model IntelligenceReport {
  id        String                   @id @default(cuid())
  companyId String
  type      IntelligenceReportType
  format    IntelligenceReportFormat @default(PDF)
  title     String

  // What it covers
  cycleId       String? // the dashboard's selected cycle at generation time
  cycleIds      String[] // every cycle included (a date range can span several)
  rangeKey      String? // LAST_QUARTER | YTD | LAST_12_MONTHS | CUSTOM, as picked in the modal
  periodStart   DateTime?
  periodEnd     DateTime?
  departmentIds String[] // empty = all departments
  sections      String[] // BOARD: SUMMARY, TALENT, PROMOTION, RISK; EXECUTIVE: all

  status      IntelligenceReportStatus @default(GENERATING)
  error       String?
  snapshot    Json?
  storagePath String? // under the report storage root; served only through an authenticated route
  fileName    String?
  sizeBytes   Int?
  generatedAt DateTime?
  expiresAt   DateTime? // generatedAt + retention; a clean-up job purges the file and snapshot
  purgedAt    DateTime?
  createdById String

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cycle     AppraisalCycle? @relation(fields: [cycleId], references: [id])
  createdBy StaffRecord     @relation("IntelligenceReportCreator", fields: [createdById], references: [id])

  shares IntelligenceReportShare[]
  events IntelligenceReportEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([companyId, type, status])
  @@index([cycleId])
  @@index([createdById])
  @@index([expiresAt])
}

// "Share Link": a time-limited, revocable download link. Only a hash of the token
// is stored; the raw token is shown once, when the link is created.
model IntelligenceReportShare {
  id             String    @id @default(cuid())
  reportId       String
  companyId      String
  tokenHash      String    @unique // sha256 of the random token
  label          String? // who it was for, e.g. "Board pack Q2"
  expiresAt      DateTime
  maxDownloads   Int?
  downloadCount  Int       @default(0)
  lastAccessedAt DateTime?
  revokedAt      DateTime?
  revokedById    String?
  createdById    String

  report    IntelligenceReport        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdBy StaffRecord               @relation("IntelligenceShareCreator", fields: [createdById], references: [id])
  revokedBy StaffRecord?              @relation("IntelligenceShareRevoker", fields: [revokedById], references: [id])
  events    IntelligenceReportEvent[]

  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([companyId, expiresAt])
}

// Audit trail for reports and shares (actorId is null for anonymous access through a link).
model IntelligenceReportEvent {
  id        String  @id @default(cuid())
  reportId  String
  shareId   String?
  companyId String
  action    String // GENERATED, GENERATION_FAILED, DOWNLOADED, SHARE_CREATED, SHARE_REVOKED, SHARE_DOWNLOADED, SHARE_DENIED, PURGED
  actorId   String?
  ipAddress String?
  metadata  Json?

  report IntelligenceReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  share  IntelligenceReportShare? @relation(fields: [shareId], references: [id], onDelete: SetNull)
  actor  StaffRecord?             @relation("IntelligenceReportActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([reportId, createdAt])
  @@index([shareId])
  @@index([actorId])
  @@index([companyId, createdAt])
}

// Rules Engine & Automation
enum AutomationRuleCategory {
  APPRAISAL
  GOALS
  COMPETENCIES
  PIP
  PROMOTION
  DEVELOPMENT_PLAN
  NOTIFICATIONS
  COMPLIANCE
}

enum AutomationRuleStatus {
  DRAFT
  ACTIVE
  DISABLED
  // "Error" and "Scheduled" are derived (decision 4)
}

enum AutomationTrigger {
  // Employee actions
  GOAL_CREATED
  GOAL_UPDATED
  APPRAISAL_SUBMITTED
  // Manager actions
  REVIEW_COMPLETED // manager review submitted ("Review Completed" and "Rating Submitted")
  RATING_FINALIZED // calibration applied
  PIP_ACTIVATED // "PIP Approved"; there is no approval gate
  // System events
  CYCLE_CREATED
  REVIEW_OVERDUE
  DEADLINE_REACHED
  KPI_MISSED
  KPI_THRESHOLD_HIT
}

enum AutomationAction {
  SEND_REMINDER
  ASSIGN_MANAGER
  CREATE_PIP
  ESCALATE_APPROVAL
  NOTIFY_HR
}

enum AutomationGovernanceType {
  ESCALATION
  APPROVAL
  AUDIT
  POLICY
}

enum AutomationRunMode {
  TEST
  LIVE
}

enum AutomationRunStatus {
  RUNNING
  SUCCESS
  FAILED
  SKIPPED // conditions not met
}

enum AutomationChannel {
  EMAIL_APP
  EMAIL
  APP
  SMS
}

enum AutomationTiming {
  IMMEDIATE
  DAILY
  WEEKLY
  T_MINUS_3_DAYS
}

enum AutomationAudience {
  ALL_EMPLOYEES
  REVIEWING_MANAGERS
  PIP_PARTICIPANTS
  HR_ADMINS
}

enum AutomationEntityType {
  RULE
  NOTIFICATION
}

model AutomationRule {
  id             String                    @id @default(cuid())
  companyId      String
  name           String
  description    String?
  category       AutomationRuleCategory
  trigger        AutomationTrigger
  action         AutomationAction
  governanceType AutomationGovernanceType? // feeds the Compliance Automation panel
  conditions     Json? // [{ field, operator, value }]; null or empty means "always"

  status      AutomationRuleStatus @default(DRAFT)
  startsAt    DateTime? // an ACTIVE rule with a future startsAt shows as "Scheduled"
  activatedAt DateTime?
  version     Int                  @default(1) // +1 on every edit, shown as v1.4 style in the drawer
  removedAt   DateTime? // soft delete

  createdById String
  updatedById String

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy StaffRecord @relation("AutomationRuleCreator", fields: [createdById], references: [id])
  updatedBy StaffRecord @relation("AutomationRuleUpdater", fields: [updatedById], references: [id])

  runs AutomationRuleRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, removedAt])
  @@index([companyId, status])
  @@index([companyId, category])
  @@index([companyId, trigger])
  @@index([companyId, governanceType])
}

// Execution log: the source of "runs", "last run" and "success rate".
// TEST rows come from the "Test Rule" dry run; LIVE rows are written by an executor (decision 6).
model AutomationRuleRun {
  id                  String              @id @default(cuid())
  companyId           String
  ruleId              String
  mode                AutomationRunMode
  status              AutomationRunStatus
  triggeredById       String? // user who ran a test; null for live runs
  targetStaffRecordId String?
  entityType          String? // GOAL, REVIEW, CYCLE, PIP ...
  entityId            String?
  conditionsMet       Boolean?
  result              Json? // evaluated steps: trigger check, conditions, what the action would do
  errorMessage        String?
  dedupeKey           String?
  eventId             String?
  startedAt           DateTime            @default(now())
  finishedAt          DateTime?

  rule        AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  targetStaff StaffRecord?   @relation("AutomationRunTarget", fields: [targetStaffRecordId], references: [id])

  @@unique([ruleId, dedupeKey])
  @@index([ruleId, mode, startedAt])
  @@index([companyId, mode, startedAt])
  @@index([targetStaffRecordId])
}

// Notification templates (the Automated Notification Center)
model AutomationNotification {
  id          String             @id @default(cuid())
  companyId   String
  name        String
  channel     AutomationChannel  @default(EMAIL_APP)
  timing      AutomationTiming   @default(IMMEDIATE)
  audience    AutomationAudience @default(ALL_EMPLOYEES)
  enabled     Boolean            @default(true)
  removedAt   DateTime?
  createdById String
  updatedById String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, removedAt])
  @@index([companyId, enabled])
}

// One audit table for rules and notification templates. Every mutation writes a row in the same transaction.
model AutomationHistory {
  id           String               @id @default(cuid())
  companyId    String
  entityType   AutomationEntityType
  entityId     String
  action       String // CREATED, UPDATED, ACTIVATED, DISABLED, DUPLICATED, REMOVED, TESTED, NOTIFICATION_PAUSED ...
  actorId      String
  previousData Json? // only the changed fields
  newData      Json?

  actor StaffRecord @relation("AutomationHistoryActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorId])
}

model AutomationEvent {
  id                   String            @id @default(cuid())
  companyId            String
  trigger              AutomationTrigger
  eventKey             String // deterministic per occurrence, see section 4
  entityType           String // GOAL | SELF_APPRAISAL | MANAGER_REVIEW | PARTICIPANT | PIP | CYCLE
  entityId             String
  subjectStaffRecordId String? // null only for cycle-level events (fan-out)
  payload              Json? // ids and small scalars only, e.g. cycleId, participantId, phaseType, kpiScore
  occurredAt           DateTime          @default(now())
  claimToken           String?
  claimedAt            DateTime?
  processedAt          DateTime?
  attempts             Int               @default(0)
  lastError            String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, eventKey])
  @@index([companyId, processedAt, claimedAt, occurredAt])
}

model AutomationExecutorTick {
  id              String    @id @default(cuid())
  companyId       String
  slotKey         String // "sweep:{bucket}" | "manual:{bucket}" | "external:{bucket}"
  source          String // ACTIVITY | MANUAL | EXTERNAL
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  status          String // RUNNING | OK | PARTIAL | FAILED
  eventsEmitted   Int       @default(0)
  eventsProcessed Int       @default(0)
  runsCreated     Int       @default(0)
  errorCount      Int       @default(0)
  note            String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, slotKey])
  @@index([companyId, startedAt])
}

// Fraud & Bias Detection
enum FairnessSignalCategory {
  BIAS // statistical disparity: manager or department level
  FRAUD // process-integrity indicators (the "Fraud Indicators" KPI)
  GOVERNANCE // policy breaches (the "Violations" KPI)
}

// LOW is deliberately absent: "Low" risk is the absence of an open signal.
enum FairnessSeverity {
  MEDIUM
  HIGH
}

enum FairnessSignalStatus {
  OPEN
  UNDER_INVESTIGATION // set when a case is linked (batch 2); suppresses auto-clear
  DISMISSED // a person marked it a false positive, with a note
  CLEARED // the engine no longer detects it
}

// Fraud & Bias Detection: cases and reports
// Mirrors the report modal's "Risk Category" filter. A signal's ruleKey maps to one of these at read time.
enum FairnessRiskCategory {
  RATING_INFLATION
  PROMOTION_BIAS
  SUCCESSION_EXCLUSION
  SUPPRESSION // "Suppression & Retaliation"
  POLICY_VIOLATION
  OTHER
}

enum FairnessCaseStatus {
  OPEN
  INVESTIGATING
  ESCALATED
  RESOLVED
}

// Signals only carry MEDIUM/HIGH. A person can set any level, including CRITICAL, which is never automatic.
enum FairnessCaseSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FairnessCaseOutcome {
  SUBSTANTIATED
  PARTIALLY_SUBSTANTIATED
  NOT_SUBSTANTIATED
}

enum FairnessReportType {
  INVESTIGATION_REPORT // "Generate Investigation Report"
  GOVERNANCE_PACK // "Governance Export"
}

enum FairnessReportStatus {
  GENERATED
  ARCHIVED // soft removal
}

// A reviewable signal, never a verdict. Detected by the engine at read time and
// reconciled here (upsert by signalKey) so we keep first-seen, status, dismissal
// and the case link. Always computed company-wide. Scores are never stored.
model FairnessSignal {
  id        String @id @default(cuid())
  companyId String
  cycleId   String

  // `${ruleKey}:${cycleId}:${subjectKey}`; subjectKey is a managerId, departmentId or recommendationId
  signalKey String
  ruleKey   String // see decision 6
  category  FairnessSignalCategory
  severity  FairnessSeverity
  status    FairnessSignalStatus   @default(OPEN)

  managerId    String? // the responsible manager (reviewer, or recommender for promotion rules)
  departmentId String? // set for department rules; null otherwise
  subjectRef   String? // non-person target, e.g. a PromotionRecommendation id

  title         String // snapshot, e.g. "Rating inflation"
  summary       String // one-line plain-language finding
  affectedCount Int    @default(0)
  // { metric, baseline, gap, n, thresholds, affectedStaffIds? }
  // Group rules store aggregates only. affectedStaffIds only for process rules (decision 11).
  evidence      Json

  firstDetectedAt DateTime  @default(now())
  lastDetectedAt  DateTime
  clearedAt       DateTime?

  dismissedAt       DateTime?
  dismissedByUserId String? // Super Admin user id; no StaffRecord required
  dismissedByName   String? // snapshot
  dismissalNote     String? // required to dismiss

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cycle      AppraisalCycle @relation(fields: [cycleId], references: [id])
  manager    StaffRecord?   @relation("FairnessSignalManager", fields: [managerId], references: [id])
  department Department?    @relation(fields: [departmentId], references: [id])

  history   FairnessSignalHistory[]
  caseLinks FairnessCaseSignal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, signalKey])
  @@index([companyId, cycleId, status])
  @@index([companyId, cycleId, category, status])
  @@index([companyId, managerId])
  @@index([departmentId])
  @@index([cycleId])
}

model FairnessSignalHistory {
  id           String  @id @default(cuid())
  signalId     String
  companyId    String?
  action       String // DETECTED, SEVERITY_CHANGED, CLEARED, REOPENED, DISMISSED (CASE_LINKED in batch 2)
  actorUserId  String? // null = system (the engine)
  actorName    String // snapshot; "System" for the engine
  previousData Json? // changed fields only
  newData      Json?

  signal FairnessSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([signalId])
  @@index([createdAt])
  @@index([companyId, createdAt])
}

// One row per (company, cycle): the latest scan. Drives the 10-minute throttle and "last scanned".
model FairnessDetectionRun {
  id             String   @id @default(cuid())
  companyId      String
  cycleId        String
  ranAt          DateTime
  trigger        String // READ, MANUAL, SCHEDULED
  reviewsScanned Int      @default(0)
  signalsOpen    Int      @default(0)
  signalsNew     Int      @default(0)
  signalsCleared Int      @default(0)

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cycle   AppraisalCycle @relation(fields: [cycleId], references: [id])

  @@unique([companyId, cycleId])
  @@index([companyId, ranAt])
}

// One row per company per day, written lazily the first time the dashboard is read that day.
// Counts only, immutable, always company-wide. Feeds the KPI deltas and (batch 2) the trend chart.
model FairnessMetricSnapshot {
  id                    String   @id @default(cuid())
  companyId             String
  capturedOn            DateTime // date-only, UTC midnight
  basisCycleId          String? // descriptive only
  reviewedCount         Int // reviewed reports in the basis cycle
  integrityScore        Float? // 0-100; null when there are no reviews
  biasAlerts            Int // open BIAS signals
  fraudIndicators       Int // open FRAUD signals
  governanceSignals     Int // open GOVERNANCE signals
  auditFlags            Int // flagged, unresolved performance audit events
  highSeveritySignals   Int
  atRiskManagers        Int
  openCases             Int      @default(0) // filled once cases exist (batch 2)
  appraisalFairness     Float? // null when under the minimum sample
  promotionFairness     Float?
  successionObjectivity Float?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([companyId, capturedOn])
  @@index([companyId, capturedOn])
}

// Always opened by a person, from a signal or from a manager row. Not bound to one cycle:
// cycleId is the basis cycle of the signals it was opened from. Separate from AppraisalEscalation
// and AuditInvestigationCase on purpose (decisions 19, 23).
model FairnessCase {
  id         String @id @default(cuid())
  companyId  String
  caseNumber Int // display ref "FB-<caseNumber>"; starts at 1001, unique per company

  riskCategory FairnessRiskCategory
  severity     FairnessCaseSeverity
  status       FairnessCaseStatus   @default(OPEN)
  // `${riskCategory}:${managerId ?? departmentId ?? "ORG"}:${cycleId ?? "ANY"}` while not RESOLVED,
  // null once resolved. One open case per category, subject and cycle.
  openKey      String?              @unique

  title   String // defaults to the category label
  summary String? // "Incident Details", written by the person opening it

  cycleId        String?
  managerId      String? // the manager the case is about
  managerName    String? // snapshot
  departmentId   String?
  departmentName String? // snapshot

  assignedToId String? // "Assigned Investigator"; required to move to INVESTIGATING
  startedAt    DateTime?

  escalatedToId  String? // the executive
  escalatedAt    DateTime?
  escalationNote String? // required to escalate

  outcome          FairnessCaseOutcome? // required to resolve
  resolutionNote   String? // required to resolve
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolvedByName   String?

  openedByUserId String // Super Admin user id; no StaffRecord required
  openedByName   String // snapshot
  lastActivityAt DateTime @default(now()) // drives "lastActive"

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cycle       AppraisalCycle? @relation(fields: [cycleId], references: [id])
  manager     StaffRecord?    @relation("FairnessCaseManager", fields: [managerId], references: [id])
  department  Department?     @relation(fields: [departmentId], references: [id])
  assignedTo  StaffRecord?    @relation("FairnessCaseAssignee", fields: [assignedToId], references: [id])
  escalatedTo StaffRecord?    @relation("FairnessCaseEscalatee", fields: [escalatedToId], references: [id])

  signals FairnessCaseSignal[]
  notes   FairnessCaseNote[]
  history FairnessCaseHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, caseNumber])
  @@index([companyId, status])
  @@index([companyId, managerId])
  @@index([companyId, departmentId])
  @@index([companyId, lastActivityAt])
  @@index([companyId, resolvedAt])
  @@index([assignedToId])
  @@index([escalatedToId])
  @@index([cycleId])
}

// A signal sits in at most one active case. Resolving the case clears activeKey; the row stays as history.
model FairnessCaseSignal {
  id           String  @id @default(cuid())
  caseId       String
  signalId     String
  activeKey    String? @unique // = signalId while the case is not RESOLVED
  linkedByName String // snapshot

  case   FairnessCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  signal FairnessSignal @relation(fields: [signalId], references: [id])

  createdAt DateTime @default(now())

  @@unique([caseId, signalId])
  @@index([signalId])
}

// Immutable, like PerformanceOpsNote: no updatedAt and no edit or delete routes.
model FairnessCaseNote {
  id           String @id @default(cuid())
  caseId       String
  authorUserId String
  authorName   String // snapshot
  message      String

  case FairnessCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
}

model FairnessCaseHistory {
  id           String  @id @default(cuid())
  caseId       String
  companyId    String?
  action       String // OPENED, SIGNAL_LINKED, SIGNAL_UNLINKED, ASSIGNED, SEVERITY_CHANGED, STATUS_CHANGED, ESCALATED, DEESCALATED, NOTE_ADDED, RESOLVED
  actorUserId  String
  actorName    String // snapshot
  previousData Json? // changed fields only; note text and summary logged as "changed", never full text
  newData      Json?

  case FairnessCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
  @@index([createdAt])
  @@index([companyId, createdAt])
}

// A saved report or governance pack. The snapshot is frozen at generation.
// No sharing and no schedule in v1 (decision 24).
model FairnessReport {
  id              String               @id @default(cuid())
  companyId       String
  createdByUserId String
  createdByName   String // snapshot
  type            FairnessReportType
  title           String
  status          FairnessReportStatus @default(GENERATED)

  config   Json // INVESTIGATION_REPORT: { riskCategory?, departmentId?, range: { label, from, to } }
  //              GOVERNANCE_PACK: { modules: ["RISK_SUMMARY","FAIRNESS_AUDIT","INVESTIGATIONS_LOG"], cycleId }
  snapshot Json // frozen { sections[], cycle, generatedFor }

  generatedAt DateTime  @default(now())
  archivedAt  DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  history FairnessReportHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([companyId, generatedAt])
}

model FairnessReportHistory {
  id           String  @id @default(cuid())
  reportId     String
  companyId    String?
  action       String // CREATED, EXPORTED, ARCHIVED
  actorUserId  String
  actorName    String // snapshot
  previousData Json?
  newData      Json? // EXPORTED: { format }

  report FairnessReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([createdAt])
  @@index([companyId, createdAt])
}

// Persisted Guided Setup journey state, per company.
//
// Records which guided-setup stages the company has completed and whether the
// journey has been started/exited. The live module counts remain the primary
// signal (a stage with records shows as complete), but this row lets a stage
// stay checked off even if its module's records are later deleted, and lets
// the UI restore "continue where you left off" without re-deriving it.
model GuidedSetupState {
  id              String  @id @default(cuid())
  companyId       String  @unique
  // Stage keys in completed order, e.g. ["company", "organization"].
  completedStages Json
  // True once the user has entered the guided journey at least once.
  started         Boolean @default(false)
  // True after the user exits the guided journey (they may return later).
  exited          Boolean @default(false)
  // Denormalized journey progress snapshot (0-100) written on each update so
  // dashboards can read progress without recomputing.
  progress        Int     @default(0)
  updatedBy       String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guided_setup_states")
}

// What an Admin changed on an automation rule (enabled/disabled, mode, scope, trigger...). One row per company and rule; the rule
// definitions themselves live in the front end, this table only holds the company's overrides.
model AutomationRuleSetting {
  id            String   @id @default(cuid())
  companyId     String
  ruleId        String
  overrides     Json // { status, mode, scope, name, description, trigger, escalation, conditions, cadence } (only the keys that were changed)
  updatedById   String?
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, ruleId])
  @@index([companyId])
  @@map("automation_rule_settings")
}

// The decision taken on an Action Center item: approved (and the changes applied), rejected or modified. The item key is the stable
// key the front end derives from the recommendation, so a decided item stays decided until the underlying data changes.
model ActionItemDecision {
  id            String   @id @default(cuid())
  companyId     String
  itemKey       String
  decision      String // approve | reject | modify
  reason        String?  @db.Text
  applied       Int      @default(0) // number of record changes that were applied with the approval
  value         String?
  signature     String?
  title         String?
  ruleId        String?
  decidedById   String?
  decidedByName String?
  decidedByRole String?
  decidedAt     DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, itemKey])
  @@index([companyId, decidedAt])
  @@map("action_item_decisions")
}

// One check an automation rule ran: on a schedule, on a record change (event) or manually (Run now).
model AutomationRun {
  id         String   @id @default(cuid())
  companyId  String
  ruleId     String
  trigger    String // schedule | event | manual
  detail     String?  @db.Text
  evaluated  Int      @default(0)
  exceptions Int      @default(0)
  status     String   @default("completed") // completed | failed
  error      String?  @db.Text
  actorId    String?
  actorName  String?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([companyId, ruleId])
  @@map("automation_runs")
}

// The Core Setup change feed (Activity Log): who changed what, with the values before and after. Rows are written in the same
// transaction as the change they describe (see lib/core-setup/audit.ts).
model CoreSetupAuditEvent {
  id             String   @id @default(cuid())
  companyId      String
  correlationId  String?
  kind           String // record | bulk | rule | decision
  area           String? // org | staff | ...
  via            String? // action_center | automation | (empty = made by hand)
  action         String
  changeType     String?
  source         String? // manual | approval | automation_rule
  object         String?
  summary        String?  @db.Text
  reason         String?  @db.Text
  status         String?
  result         String?
  actorId        String?
  actorName      String?
  actorRole      String?
  fieldChanges   Json?
  relatedRecords Json?
  details        Json?
  createdAt      DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([companyId, kind])
  @@map("core_setup_audit_events")
}

// ── Free trial (lib/trial) ───────────────────────────────────────────────────

// Lifetime counters for trial quotas (payslips sent, offer letters sent, payroll
// runs). Counted by unique recipient; deleting a record never gives a slot back.
model TrialUsageCounter {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  metric     String   @db.VarChar(40)
  // Unique key of the thing counted (e.g. staff id) so repeats don't use a slot.
  subjectKey String   @db.VarChar(120)
  createdAt  DateTime @default(now())

  @@unique([companyId, metric, subjectKey])
  @@index([companyId, metric])
}

// Hashed identity signals captured at sign-up (email domain, phone, RC number,
// device, IP, normalised name). Raw values are never stored.
model TrialSignal {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind      String   @db.VarChar(30)
  valueHash String   @db.VarChar(128)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([kind, valueHash])
  @@index([companyId])
}

// Super_Admin review queue and decision log for held / flagged trials.
model TrialReview {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  score      Int       @default(0)
  reasons    Json?
  status     String    @default("PENDING") @db.VarChar(20)
  decision   String?   @db.VarChar(30)
  note       String?   @db.Text
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, createdAt])
  @@index([companyId])
}

// Pending self sign-up state between /public/signup/start and the final phone
// check: hashed email/phone codes, expiries, attempts and the risk decision.
// One row per sign-up company. Only keyed hashes of codes, IP and device are kept.
model SignupVerification {
  id                 String    @id @default(cuid())
  companyId          String    @unique
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId             String
  email              String
  phone              String    @db.VarChar(20)
  emailCodeHash      String?   @db.VarChar(128)
  emailCodeExpiresAt DateTime?
  emailAttempts      Int       @default(0)
  phoneCodeHash      String?   @db.VarChar(128)
  phoneCodeExpiresAt DateTime?
  phoneAttempts      Int       @default(0)
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  riskScore          Int       @default(0)
  riskDecision       String    @db.VarChar(20)
  riskReasons        Json?
  ipHash             String?   @db.VarChar(128)
  deviceHash         String?   @db.VarChar(128)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([email])
}

// ===========================================================================
// AI Assistant (Ask 247HR) — settings, conversations, proposals, custom rules
// ===========================================================================

model AiAssistantSettings {
  id                String    @id @default(cuid())
  companyId         String    @unique
  enabled           Boolean   @default(false)
  provider          String    @default("anthropic")
  model             String    @default("claude-sonnet-5")
  apiKeyEncrypted   String?   @db.Text
  keyLast4          String?   @db.VarChar(4)
  lastTestedAt      DateTime?
  keyStatus         String    @default("none") // none | ok | rejected
  visibleCategories Json      @default("[\"employment\",\"leave\"]")
  monthlyWarning    Int?
  hourlyLimit       Int       @default(20) // requests per person per hour
  dailyLimit        Int       @default(500) // requests per company per day
  updatedById       String?
  updatedByName     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("ai_assistant_settings")
}

model AiAssistantPlatform {
  id      String  @id @default("global")
  enabled Boolean @default(true)

  @@map("ai_assistant_platform")
}

model AiConversation {
  id            String    @id @default(cuid())
  companyId     String
  userId        String
  title         String?
  lastMessageAt DateTime  @default(now())
  deletedAt     DateTime? // set when the person deletes it; its messages are removed at once, the shell row only counts toward usage until retention removes it
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages AiMessage[]
  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([lastMessageAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user | assistant | tool
  content        String   @db.Text
  toolCalls      Json?
  rating         Int?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("ai_messages")
}

// Phase 2: a change the assistant proposes. Nothing is applied until an Admin or HR approves it in the Action Center.
// conversationId is deliberately NOT a foreign key: the 90-day conversation sweep must not delete the record of a decision.
model AiProposal {
  id             String    @id @default(cuid())
  companyId      String
  conversationId String?
  type           String // staff_change | rule_setting | custom_rule
  title          String
  description    String    @db.Text
  plan           Json // { version, fingerprint, steps[], assumptions[] } (what is applied; after Modify, the edited plan)
  originalPlan   Json? // the plan as first proposed, kept when an approver edits it before approving
  status         String    @default("pending") // pending | approved | rejected | expired | stale | partly_applied
  createdById    String
  decidedById    String?
  decidedAt      DateTime?
  decisionReason String?   @db.Text
  result         Json? // { applied, failed } reported after the plan is applied
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([createdById])
  @@index([expiresAt])
  @@map("ai_proposals")
}

// Phase 3: rules a company builds itself in the rule builder (or that an Admin approved from an AI proposal). The evaluator only
// counts matches and sends notifications; anything that would change a record is raised in the Action Center for a person to approve.
model CustomAutomationRule {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  description    String?  @db.Text
  conditions     Json // [{ field, operator, value }], at most 5
  actions        Json // [{ type: notify | flag | assign_manager, managerId? }]
  enabled        Boolean  @default(true)
  createdById    String
  createdByName  String?
  aiOrigin       Boolean  @default(false)
  recordType     String   @default("staff") // staff | department | designation | business_unit | leave_request | payroll_template
  cadence        String   @default("daily") // event | hourly | daily | weekly
  source         String   @default("manual") // manual | ai_assistant
  proposalId     String?
  approvedById   String?
  approvedByName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, enabled])
  @@map("custom_automation_rules")
}
