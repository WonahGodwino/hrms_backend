// Tracks an async "publish + email an entire month's draft payslips" job,
// triggered from the Company Payslips page. Mirrors PayrollUpload's
// PENDING/PROCESSING/COMPLETED/FAILED lifecycle for the same reason: sending
// potentially thousands of emails sequentially can't happen inside a single
// HTTP request without risking a timeout.
model PayslipBulkSend {
  id            String                @id @default(cuid())
  companyId     String
  month         String
  year          Int
  totalPayslips Int                   @default(0)
  sent          Int                   @default(0)
  failed        Int                   @default(0)
  emailFailures Json?
  status        PayslipBulkSendStatus @default(PENDING)
  failureReason String?
  triggeredBy   String
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime              @default(now())
  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@map("payslip_bulk_sends")
}

enum PayslipBulkSendStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ==================== RECRUITMENT: ASSESSMENT PLANS ====================

model RecruitmentAssessmentPlan {
  id                String     @id @default(cuid())
  companyId         String
  name              String
  description       String?    @db.Text
  status            PlanStatus @default(DRAFT)
  totalDurationMins Int?
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  archived          Int?       @default(0)

  company              Company                          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rounds               RecruitmentAssessmentRound[]
  candidateAssessments RecruitmentCandidateAssessment[]

  @@index([companyId, status])
  @@index([companyId, archived])
  @@map("recruitment_assessment_plans")
}

model RecruitmentAssessmentRound {
  id                      String        @id @default(cuid())
  planId                  String
  order                   Int
  title                   String
  interviewType           InterviewType @default(VIDEO)
  duration                Int
  gradingMetric           String?
  questionBanks           Json?
  requiredInterviewers    Json?
  // Optional evaluation plan for the round (scoring rubric / what to assess /
  // guidance, or a link). Not required — a round can be saved without one.
  evaluationPlan          String?       @db.Text
  // Hours after scheduling before the evaluation deadline expires. When set,
  // panelists who haven't submitted within this window are automatically
  // bypassed and the round completes without their scorecard.
  evaluationDeadlineHours Int?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  plan       RecruitmentAssessmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  scorecards RecruitmentScorecard[]

  @@unique([planId, order])
  @@index([planId])
  @@map("recruitment_assessment_rounds")
}

// A re-use of a published assessment plan for a specific Job and/or Designation.
// The plan's rounds stay the reusable template; the instance carries the panel
// chosen for THIS job/designation (editable before finalising), keyed by round.
// FKs are enforced in SQL only (no Prisma relations) so the generated client is
// not required — access via (prisma as any). panelByRound shape:
//   { [roundId]: [{ staffId, name, email, role }] }
model AssessmentPlanInstance {
  id            String    @id @default(cuid())
  companyId     String
  planId        String
  jobId         String?
  designationId String?
  panelByRound  Json?
  status        String    @default("ACTIVE") // ACTIVE | ARCHIVED
  createdBy     String?
  createdByName String?
  notifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId, planId])
  @@index([companyId, jobId])
  @@index([companyId, designationId])
  @@map("assessment_plan_instances")
}

// ==================== VIRTUAL MEETINGS (video conferencing) ====================
// A generic video/audio meeting room — reusable by Recruitment interviews AND
// internal work meetings. The media itself is handled by an external SFU
// (LiveKit — managed now, self-hostable later); this row is our own record of
// the room + who's invited. Enum-like fields are Strings (no PG enums) to match
// the rest of the app. companyId/candidateAssessmentId are scalar (FKs in SQL).
model Meeting {
  id                    String    @id @default(cuid())
  companyId             String
  title                 String
  purpose               String    @default("WORK_MEETING") // INTERVIEW | WORK_MEETING
  provider              String    @default("livekit") // media provider key
  roomName              String    @unique // maps 1:1 to the SFU room
  scheduledAt           DateTime?
  durationMins          Int?
  status                String    @default("SCHEDULED") // SCHEDULED | LIVE | ENDED | CANCELLED
  createdBy             String?
  // Optional link back to the recruitment interview this meeting serves.
  candidateAssessmentId String?   @unique
  recordingUrl          String?
  // S3 object key the recording is (or will be) uploaded to — the source of
  // truth for generating signed playback URLs on demand (see provider.ts).
  recordingKey          String?
  // null (never recorded) | RECORDING | PROCESSING | READY | FAILED — set
  // authoritatively by the LiveKit egress webhook, not by the start/stop call.
  recordingStatus       String?
  recordingRequested    Boolean   @default(false)
  recordingEgressId     String?
  lobbyEnabled          Boolean   @default(false)
  recurrence            Json? // recurring schedule: { frequency, daysOfWeek, interval, endDate, occurrences }
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  participants MeetingParticipant[]

  @@index([companyId, status])
  @@index([scheduledAt])
  @@map("meetings")
}

// Who is invited to / attended a meeting. A participant is EITHER a known staff
// member (staffId) OR an external person captured by name+email (candidates,
// external interview panelists) — mirroring the existing panel-token pattern.
model MeetingParticipant {
  id            String    @id @default(cuid())
  meetingId     String
  staffId       String?
  externalName  String?
  externalEmail String?
  role          String    @default("ATTENDEE") // HOST | ATTENDEE
  // First email that redeemed this participant link. Enforces one-invite-per-person
  // when organisations invite external/non-staff participants.
  accessEmail   String?
  joinedAt      DateTime?
  leftAt        DateTime?
  createdAt     DateTime  @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_participants")
}

// ==================== RECRUITMENT: ASSESSMENT QUEUE ====================

model RecruitmentCandidateAssessment {
  id                String      @id @default(cuid())
  applicationId     String      @unique
  planId            String
  companyId         String
  currentRoundOrder Int         @default(1)
  roundStatus       RoundStatus @default(AWAITING_SCHEDULING)
  scheduledAt       DateTime?
  schedulingNotes   String?     @db.Text
  interviewerIds    Json?
  // Logistics captured at scheduling: { interviewType, platform, meetingUrl,
  // location, duration } — used in the candidate/panel invitation + reminders.
  meetingDetails    Json?
  panelAccessToken  String?     @unique // one-time access token for panelist dashboard link
  averageScore      Float?
  createdBy         String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  application JobApplication            @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  plan        RecruitmentAssessmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  company     Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scorecards  RecruitmentScorecard[]

  @@index([companyId, roundStatus])
  @@index([planId])
  @@map("recruitment_candidate_assessments")
}

model RecruitmentScorecard {
  id                    String                  @id @default(cuid())
  candidateAssessmentId String
  roundId               String
  interviewerId         String
  interviewerName       String?
  interviewerRole       String?
  scores                Json
  notes                 String?                 @db.Text
  recommendation        ScorecardRecommendation
  // Null while saved as a DRAFT (still editable by the panelist); set to the
  // actual submission time only when finalized. A row existing with a null
  // submittedAt must NOT count toward round completion or block re-submission.
  submittedAt           DateTime?

  candidateAssessment RecruitmentCandidateAssessment @relation(fields: [candidateAssessmentId], references: [id], onDelete: Cascade)
  round               RecruitmentAssessmentRound     @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([candidateAssessmentId, roundId, interviewerId])
  @@index([candidateAssessmentId])
  @@index([roundId])
  @@map("recruitment_scorecards")
}

// ==================== RECRUITMENT: OFFER APPROVAL WORKFLOW ====================

model RecruitmentOfferApproval {
  id           String              @id @default(cuid())
  offerId      String
  approverId   String
  approverName String?
  approverRole String?
  step         Int
  status       OfferApprovalStatus @default(PENDING)
  notes        String?             @db.Text
  actedAt      DateTime?
  createdAt    DateTime            @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId, approverId])
  @@index([offerId, step])
  @@map("recruitment_offer_approvals")
}

model JobApplication {
  id                  String                          @id @default(cuid())
  companyId           String
  jobId               String
  candidateId         String
  cvFilePath          String
  cvFileName          String?
  parsedCvContent     String?
  status              ApplicationStatus               @default(SUBMITTED)
  score               Int?
  notes               String?
  metadata            Json?
  reviewedBy          String?
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt
  reviewedAt          DateTime?
  cvFileId            String?                         @unique
  archived            Int?                            @default(0)
  stageHistory        ApplicationStageHistory[]
  files               CandidateFile[]                 @relation("ApplicationFiles")
  interviews          Interview[]
  candidate           Candidate                       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  company             Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cvFile              CandidateFile?                  @relation("ApplicationCVFile", fields: [cvFileId], references: [id])
  job                 Job                             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  offer               Offer?
  onboarding          Onboarding?
  candidateAssessment RecruitmentCandidateAssessment?
  referenceCode       String                          @unique @default(dbgenerated("upper(substr(md5(random()::text || clock_timestamp()::text), 1, 10))"))

  @@unique([jobId, candidateId])
  @@index([companyId, jobId, status])
  @@index([companyId, archived])
  @@index([cvFileId])
  @@map("job_applications")
}

model CandidateFile {
  id               String            @id @default(cuid())
  companyId        String
  candidateId      String
  applicationId    String?
  type             CandidateFileType @default(CV)
  fileName         String
  mimeType         String
  sizeBytes        Int
  data             Bytes
  createdBy        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  archived         Int?              @default(0)
  application      JobApplication?   @relation("ApplicationFiles", fields: [applicationId], references: [id])
  candidate        Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cvForApplication JobApplication?   @relation("ApplicationCVFile")

  @@index([companyId, candidateId])
  @@index([companyId, archived])
  @@index([applicationId])
  @@index([companyId, applicationId, type])
  @@map("candidate_files")
}

model Keyword {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  jobId       String
  updatedAt   DateTime @default(now()) @updatedAt
  archived    Int?     @default(0)
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, archived])
  @@map("keywords")
}

model Job {
  id             String    @id @default(cuid())
  title          String
  description    String    @db.Text
  department     String
  position       String
  companyId      String
  status         JobStatus @default(ACTIVE)
  expirationDate DateTime?

  // NEW FIELDS
  employmentType  String? // Full-time, Part-time, Contract, Intern, Temporary
  workplaceType   String? // Remote, Hybrid, On-site
  experienceLevel String? // Entry, Mid, Senior, Lead, Executive
  // Single advertised salary, in the owning company's base currency.
  salary          Decimal? @db.Decimal(18, 2)
  // Legacy free-text range, read-only fallback for jobs created before `salary`.
  salaryRange     String?
  benefits        Json? // Array of strings: ["health", "equity", "pto", "gym"]
  locations       Json? // Array of objects: [{"state": "Lagos", "lga": "Ikeja"}, ...]
  // Default employment terms for offers generated against this role. Per-offer
  // values may override these. e.g. { contractDuration, probationPeriod,
  // noticePeriod, weeklyHours, dailyHours, lunchBreak, jobLocation }
  offerDefaults   Json?

  createdBy String
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt
  archived  Int?     @default(0)

  publishedAt DateTime? // set when the job becomes ACTIVE; drives job alerts

  // The designation (from Core Setup) this vacancy recruits for. A job is tied
  // to one designation; many jobs/hires can map to the same designation. When a
  // candidate is hired, their staff record inherits this designation.
  designationId String?

  // The Core Setup department this vacancy belongs to. Nullable FK alongside the
  // denormalised `department` name (mirrors StaffRecord's name+id pairing) so
  // existing rows are unaffected and new/edited jobs gain referential integrity.
  departmentId String?

  // Relations
  applications      JobApplication[]
  company           Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  designation       Designation?          @relation(fields: [designationId], references: [id])
  departmentRef     Department?           @relation(fields: [departmentId], references: [id])
  keywords          Keyword[]
  boardDeliveryLogs JobBoardDeliveryLog[]
  savedBy           SavedJob[] // replaces the commented-out line
  alertDeliveries   JobAlertDelivery[]

  @@index([companyId, status])
  @@index([companyId, archived])
  @@index([designationId])
  @@index([departmentId])
  @@index([status, publishedAt])
  @@map("jobs")
}

// Audit trail for the external job-board distribution feed (LinkedIn Job
// Wrapping, Jobberman, Indeed, Jooble, Careerjet, Jora, Talent.com all ingest
// the same feed, see lib/recruitment/job-feed.ts) — one row per publish/close
// event and per crawler fetch, so HR can see when a job became available to
// the feed and when a platform last actually pulled it.
model JobBoardDeliveryLog {
  id        String   @id @default(cuid())
  companyId String
  jobId     String? // null for whole-feed crawler pulls, which aren't tied to one job
  channel   String // 'FEED_PULL' | 'LINKEDIN_WRAPPING' | 'WEBHOOK:<provider>' etc.
  event     String // 'PUBLISHED' | 'UPDATED' | 'CLOSED' | 'PULLED'
  status    String // 'SENT' | 'FAILED' | 'PULLED'
  error     String?
  metadata  Json?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job     Job?    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([jobId])
  @@map("job_board_delivery_logs")
}

// Department/designation access configuration for Recruitment admin pages.
// Unlike LoansBenefitsPageAccess, a pageKey with no row here is UNRESTRICTED
// (opt-in scoping, not locked-down-until-configured) — and once a row DOES
// exist, SUPER_ADMIN is checked against it like anyone else rather than
// bypassing it. See backend/src/app/lib/recruitment/page-access.ts.
model RecruitmentPageAccess {
  id             String   @id @default(cuid())
  companyId      String
  pageKey        String
  departmentIds  Json     @default("[]") // string[] of Department.id
  designationIds Json     @default("[]") // string[] of Designation.id
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedBy      String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, pageKey])
  @@map("recruitment_page_access")
}
// ==================== RECRUITMENT: CANDIDATE PORTAL ====================
// Candidate Portal
enum AccountDocumentCategory {
  RESUME
  COVER_LETTER
  CERTIFICATE
  IDENTIFICATION
  PORTFOLIO
  OTHER
}

enum CandidateOtpPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  STATUS_LOOKUP
}

enum JobAlertFrequency {
  INSTANT // sent on the next scheduler tick
  DAILY
  WEEKLY
}

// One global login per person. Per-company `Candidate` rows stay as they are (HR screens and the
// talent pool are untouched) and are linked to the account through Candidate.accountId.
model CandidateAccount {
  id            String  @id @default(cuid())
  email         String  @unique // stored lowercase by the app
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  headline      String?
  locationState String?
  locationLga   String?
  linkedInUrl   String?
  portfolioUrl  String?

  emailVerifiedAt  DateTime?
  tokenVersion     Int       @default(0) // bumped on password reset; old tokens stop working
  isActive         Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  candidates      Candidate[]
  experiences     CandidateExperience[]
  educations      CandidateEducation[]
  documents       CandidateAccountDocument[]
  savedJobs       SavedJob[]
  alertPreference JobAlertPreference?
  alertDeliveries JobAlertDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("candidate_accounts")
}

model CandidateExperience {
  id             String    @id @default(cuid())
  accountId      String
  title          String
  company        String
  employmentType String? // Full-time | Part-time | Contract | Internship | Remote
  startDate      DateTime // date-only, UTC midnight
  endDate        DateTime? // null while isCurrent
  isCurrent      Boolean   @default(false)
  description    String?   @db.Text

  account CandidateAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, startDate])
  @@map("candidate_experiences")
}

model CandidateEducation {
  id           String  @id @default(cuid())
  accountId    String
  institution  String
  degree       String // B.Sc, HND, M.Sc ...
  fieldOfStudy String?
  startYear    Int?
  endYear      Int? // completion year
  grade        String?

  account CandidateAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@map("candidate_educations")
}

// Metadata only, so list queries never load file bytes. One RESUME slot (replace to change it) plus
// at most 3 other documents, enforced in a transaction.
model CandidateAccountDocument {
  id        String                  @id @default(cuid())
  accountId String
  category  AccountDocumentCategory
  fileName  String
  mimeType  String
  sizeBytes Int
  resumeKey String?                 @unique // = accountId while category is RESUME

  account CandidateAccount              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  blob    CandidateAccountDocumentBlob?

  createdAt DateTime @default(now())

  @@index([accountId, category])
  @@map("candidate_account_documents")
}

model CandidateAccountDocumentBlob {
  documentId String @id
  data       Bytes

  document CandidateAccountDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("candidate_account_document_blobs")
}

model SavedJob {
  id        String @id @default(cuid())
  accountId String
  jobId     String

  account CandidateAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  job     Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([accountId, jobId])
  @@index([jobId])
  @@map("saved_jobs")
}

model JobAlertPreference {
  id         String            @id @default(cuid())
  accountId  String            @unique
  isActive   Boolean           @default(true) // the master switch; preferences are kept while off
  keywords   String[]          @default([])
  location   String?
  remoteOnly Boolean           @default(false)
  minSalary  Decimal?          @db.Decimal(18, 2) // naira
  frequency  JobAlertFrequency @default(DAILY)

  activatedFrom    DateTime  @default(now()) // only jobs published after this are alerted; reset when switched back on
  lastRunAt        DateTime?
  unsubscribeToken String    @unique // random, set by the app; works without signing in

  account CandidateAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("job_alert_preferences")
}

// One row per (account, job) that was emailed, so a job is never alerted twice.
// Written only after the email succeeds, so a failed send is retried on the next tick.
model JobAlertDelivery {
  id        String   @id @default(cuid())
  accountId String
  jobId     String
  sentAt    DateTime @default(now())

  account CandidateAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  job     Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([accountId, jobId])
  @@index([jobId])
  @@map("job_alert_deliveries")
}

// Verification codes, reset tokens and status-lookup codes. Replaces the in-memory statusOtp store.
// codeHash = sha256(secret + pepper): a 6-digit code for EMAIL_VERIFY / STATUS_LOOKUP, a 32-byte token for PASSWORD_RESET.
model CandidateOtp {
  id         String              @id @default(cuid())
  purpose    CandidateOtpPurpose
  email      String // lowercase
  accountId  String? // plain column, no FK, so cleanup never cascades
  scopeRef   String? // STATUS_LOOKUP: the reference code that was entered, if any
  codeHash   String
  attempts   Int                 @default(0)
  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([email, purpose, createdAt])
  @@index([codeHash])
  @@index([expiresAt])
  @@map("candidate_otps")
}

// The canonical list of PenCom-licensed Pension Fund Administrators, so
// StaffRecord.pfaCode has something real to validate against (and the staff
// edit/upload/bulk-edit surfaces have something to populate a dropdown from)
// instead of accepting any free-text string. Global, not company-scoped —
// PFAs are a national list, not something each company defines its own set of.
model PensionFundAdministrator {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pension_fund_administrators")
}

// Per-company PFA opt-out. Presence of a row means this PFA code is DISABLED
// for this company; absence means enabled (subject to the PFA's own global
// isActive flag). A PFA is only actually offered to a company's staff
// edit/upload/bulk-edit dropdowns when it is both globally active AND has no
// row here for that company. Not FK'd to PensionFundAdministrator.code
// (free-standing string, same as StaffRecord.pfaCode) so a global PFA
// rename/retire never orphans rows here.
model CompanyDisabledPfa {
  id         String   @id @default(cuid())
  companyId  String
  pfaCode    String
  disabledAt DateTime @default(now())
  disabledBy String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, pfaCode])
  @@map("company_disabled_pfas")
}

// Company-scoped offer letter templates. bodyHtml holds rich text with
// {{placeholder}} tokens (see lib/offers/template-variables) that are resolved
// from company / candidate / job / offer data at render time. The template
// itself is generic — no company-specific values are baked in.
model OfferTemplate {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?  @db.Text
  bodyHtml    String   @db.Text
  sections    Json? // optional structured section/clause config for the builder
  variables   Json? // snapshot of placeholder keys referenced by this template
  status      String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  isDefault   Boolean  @default(false)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archived    Int?     @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([companyId, archived])
  @@index([companyId, isDefault])
  @@map("offer_templates")
}

model Candidate {
  id                   String    @id @default(cuid())
  companyId            String
  firstName            String
  lastName             String
  email                String
  phone                String?
  address              String?
  applicationStartDate DateTime?
  linkedInUrl          String?
  portfolioUrl         String?
  locationState        String? // New field for state
  // When true the candidate has unsubscribed from talent-pool job-advert emails
  // (via the unsubscribe link). They stay visible to HR but receive no bulk
  // vacancy notifications. See lib/talent-pool.
  talentPoolOptOut     Boolean   @default(false)
  createdBy            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  archived             Int?      @default(0)
  accountId            String?

  // Relations
  documents    CandidateDocument[]
  files        CandidateFile[]
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications JobApplication[]
  offers       Offer[]
  account      CandidateAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([email, companyId])
  @@index([companyId, archived])
  @@map("candidates")
  @@index([accountId])
}

model ApplicationStageHistory {
  id            String             @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedBy     String?
  changedAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt
  comment       String?
  archived      Int?               @default(0)
  application   JobApplication     @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, archived])
  @@map("application_stage_history")
}

model Interview {
  id            String           @id @default(cuid())
  applicationId String
  companyId     String
  type          InterviewType    @default(VIDEO)
  scheduledAt   DateTime
  durationMins  Int?
  meetingLink   String?
  location      String?
  interviewers  String[]
  notes         String?
  outcome       InterviewOutcome @default(PENDING)
  createdBy     String?
  archived      Int?             @default(0)
  updatedAt     DateTime         @updatedAt
  application   JobApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([applicationId, scheduledAt])
  @@index([companyId, archived])
  @@map("interviews")
}

// ==================== OFFER LETTER MODULE (standalone) ====================
// Independent of the recruitment Offer/OfferTemplate system above — not tied
// to a JobApplication/Candidate. HR uploads a real .docx sample (letterhead,
// layout, wording, with {{variable}} placeholders); the original file is kept
// byte-for-byte as the layout source of truth and every generated letter is
// produced by substituting only the placeholder text via docxtemplater, so
// letters from the same template stay visually identical apart from the
// variable values.
model OfferLetterTemplate {
  id               String   @id @default(cuid())
  companyId        String
  name             String
  description      String?
  originalFileName String
  fileData         Bytes // the uploaded .docx, byte-for-byte — the layout source of truth
  fileSize         Int
  variables        Json // detected {{tokens}}: string[], in first-appearance order
  status           String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdBy        String
  updatedBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  archived         Int      @default(0)

  company Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  letters GeneratedOfferLetter[]

  @@index([companyId, archived])
  @@map("offer_letter_templates")
}

// Deliberately has no link to StaffRecord anywhere — this module is a
// standalone add-on, not part of onboarding/staff management. The uploaded
// Excel sheet is the only source of recipient data; nothing here is ever
// cross-referenced against a staff record.
model GeneratedOfferLetter {
  id             String   @id @default(cuid())
  companyId      String
  templateId     String?
  recipientName  String
  recipientEmail String
  variableValues Json // exact values substituted for this specific letter
  fileData       Bytes // the generated .docx for this letter
  fileName       String
  fileSize       Int
  month          String // mirrors Payslip.month convention exactly
  year           Int
  status         String   @default("GENERATED") // GENERATED | REGENERATED
  createdBy      String
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company  Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template OfferLetterTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  emails   OfferLetterEmail[]

  @@index([companyId, year, month])
  @@index([companyId, createdAt])
  @@map("generated_offer_letters")
}

// Tracks any async offer-letter bulk operation — either generating many new
// letters from an uploaded sheet (CREATE) or regenerating existing ones
// (EDIT). Both share the exact same PENDING/PROCESSING/COMPLETED/FAILED
// lifecycle and the same status/pending/failure-report endpoints; only the
// row-processing logic differs per jobType.
model OfferLetterBulkJob {
  id            String                   @id @default(cuid())
  companyId     String
  jobType       OfferLetterBulkJobType
  templateId    String? // CREATE/EDIT jobs are scoped to one Word template; EMAIL_SEND jobs are not (letters may span templates)
  payload       Json? // job-type-specific input, e.g. EMAIL_SEND: { letterIds, emailTemplateId, subjectOverride?, bodyOverride? }
  fileName      String?
  totalRecords  Int                      @default(0)
  successful    Int                      @default(0)
  failed        Int                      @default(0)
  errors        Json? // [{ row, message, data: {...original row cells} }]
  uploadedBy    String
  status        OfferLetterBulkJobStatus @default(PENDING)
  failureReason String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime                 @default(now())
  company       Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@map("offer_letter_bulk_jobs")
}

enum OfferLetterBulkJobType {
  CREATE
  EDIT
  EMAIL_SEND
}

enum OfferLetterBulkJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Per-company Hostinger mailbox configuration — every company sends/receives
// offer-letter mail through its own mailbox (no shared/global fallback).
// Passwords are stored AES-256-GCM encrypted (backend/src/app/lib/crypto/mailSecret.ts),
// never in plaintext. imapUser/imapPasswordEncrypted are null in the common
// case where the IMAP account matches the SMTP one exactly.
model OfferLetterMailConfig {
  id                    String    @id @default(cuid())
  companyId             String    @unique
  fromName              String
  smtpHost              String    @default("smtp.hostinger.com")
  smtpPort              Int       @default(465)
  smtpSecure            Boolean   @default(true)
  smtpUser              String
  smtpPasswordEncrypted String
  imapHost              String    @default("imap.hostinger.com")
  imapPort              Int       @default(993)
  imapUser              String?
  imapPasswordEncrypted String?
  isVerified            Boolean   @default(false)
  lastVerifiedAt        DateTime?
  updatedBy             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("offer_letter_mail_configs")
}

// Offer Letter email delivery — a second, independent email pathway from the
// rest of this codebase (backend/src/app/lib/mailgun.ts, used for payslips).
// Mail must be sent via real SMTP submission through the company's actual
// Hostinger mailbox so it lands in that mailbox's own Sent folder, and
// replies are pulled via real IMAP polling of that same mailbox's Inbox —
// a relay-based provider like Mailgun can't satisfy either requirement.
model OfferLetterEmailTemplate {
  id               String   @id @default(cuid())
  companyId        String
  name             String
  description      String?
  ccEmails         Json? // string[]
  bccEmails        Json? // string[]
  subject          String // supports {{variable}} substitution — same flat-key convention as letter variables
  body             String // HTML, supports {{variable}}
  signatureHtml    String?
  autoAttachLetter Boolean  @default(true)
  isActive         Boolean  @default(true)
  createdBy        String
  updatedBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  emails  OfferLetterEmail[]

  @@index([companyId, isActive])
  @@map("offer_letter_email_templates")
}

// letterId doubles as the thread key — one candidate per generated letter,
// so there's no need for a separate threadId. companyId is denormalized
// from the letter at send time so every read can filter by it directly
// without an extra join, which matters once multiple companies share one
// physical mailbox (see OfferLetterUnmatchedReply below).
model OfferLetterEmail {
  id            String                    @id @default(cuid())
  companyId     String
  letterId      String
  templateId    String?
  parentEmailId String?
  direction     OfferLetterEmailDirection
  fromEmail     String
  fromName      String
  toEmail       String
  toName        String
  ccEmails      Json?
  bccEmails     Json?
  subject       String
  body          String
  status        OfferLetterEmailStatus    @default(PENDING) // PENDING | SENT | FAILED — plain SMTP can't confirm DELIVERED/BOUNCED
  messageId     String? // Message-ID we generate on send; the anchor reply-matching resolves against
  inReplyTo     String? // raw header from an inbound message, kept for audit/debugging
  errorMessage  String?
  isRead        Boolean                   @default(false)
  sentAt        DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  company         Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  letter          GeneratedOfferLetter         @relation(fields: [letterId], references: [id], onDelete: Cascade)
  template        OfferLetterEmailTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  attachments     OfferLetterEmailAttachment[]
  mailboxMessages OfferLetterMailboxMessage[]

  @@index([companyId, letterId])
  @@index([messageId])
  @@map("offer_letter_emails")
}

enum OfferLetterEmailDirection {
  OUTBOUND
  INBOUND
}

enum OfferLetterEmailStatus {
  PENDING
  SENT
  FAILED
}

model OfferLetterEmailAttachment {
  id        String                      @id @default(cuid())
  emailId   String
  fileName  String
  fileSize  Int
  mimeType  String
  fileData  Bytes // consistent with the rest of this module — no disk, no S3
  source    OfferLetterAttachmentSource
  createdAt DateTime                    @default(now())

  email OfferLetterEmail @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@map("offer_letter_email_attachments")
}

// Neutral Inbox staging record. Mail is imported here before company
// assignment; assigned rows are exposed through the company Inbox API.
model OfferLetterMailboxMessage {
  id            String                    @id @default(cuid())
  companyId     String?
  folder        String                    @default("INBOX")
  uid           String?
  fingerprint   String                    @unique
  direction     OfferLetterEmailDirection @default(INBOUND)
  messageId     String?
  inReplyTo     String?
  references    Json?
  fromEmail     String
  fromName      String?
  toEmails      Json?
  ccEmails      Json?
  subject       String
  body          String
  rawHeaders    Json
  receivedAt    DateTime
  linkedEmailId String?
  isRead        Boolean                   @default(false)
  createdAt     DateTime                  @default(now())
