  startDate          DateTime
  endDate            DateTime
  totalDays          Decimal   @db.Decimal(5, 1)
  reason             String
  emergencyContact   String?
  contactPhone       String?
  status             String    @default("PENDING")
  currentStep        String    @default("MANAGER")
  // Position on the department line-manager ladder currently awaiting action
  // (see LeaveApprovalStep). Null once the request is at HR / finished.
  currentLevel       Int?
  managerApproverId  String?
  managerApprovedAt  DateTime?
  managerApprovedBy  String?
  managerComments    String?
  hrApproverUserId   String?
  hrApproverRole     String?
  hrApprovedAt       DateTime?
  hrApprovedBy       String?
  hrComments         String?
  rejectionReason    String?
  rejectedByStep     String?
  rejectedById       String?
  handoverTo         String?
  handoverStaffId    String?
  handoverNotes      String?
  attachmentUrl      String?
  fileName           String?
  attachmentData     Bytes?
  attachmentMimeType String?
  attachmentSize     Int?
  hasAttachment      Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdBy          String
  updatedBy          String?

  // Relations - ALL must have unique relation names
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Each relation to StaffRecord needs a unique name
  managerApprover StaffRecord?        @relation("LeaveRequestManagerApprover", fields: [managerApproverId], references: [id])
  staffRecord     StaffRecord         @relation("LeaveRequestStaff", fields: [staffRecordId], references: [id], onDelete: Cascade)
  handoverStaff   StaffRecord?        @relation("LeaveRequestHandover", fields: [handoverStaffId], references: [id])
  approvalSteps   LeaveApprovalStep[]

  @@index([companyId])
  @@index([staffRecordId, startDate])
  @@index([status, startDate])
  @@index([managerApproverId, status])
  @@index([hrApproverUserId, status])
  @@map("leave_requests")
}

// Ordered ladder of line managers for a department (level 1 = closest to staff,
// higher = more senior). Leave approvals walk this ladder, then HR.
model DepartmentLineManager {
  id           String   @id @default(cuid())
  companyId    String
  departmentId String
  staffId      String
  level        Int
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  staff      StaffRecord @relation("StaffDepartmentLineManager", fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([departmentId, staffId])
  @@unique([departmentId, level])
  @@index([companyId])
  @@index([staffId])
  @@map("department_line_managers")
}

// Per-request snapshot of the approval chain: one row per line-manager level
// plus a final HR row. Re-synced when a department's ladder is edited.
model LeaveApprovalStep {
  id              String    @id @default(cuid())
  leaveRequestId  String
  level           Int
  kind            String // LINE_MANAGER | HR
  approverStaffId String?
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED | SKIPPED
  actedByStaffId  String?
  actedByUserId   String?
  actedAt         DateTime?
  comments        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  approver     StaffRecord? @relation("LeaveApprovalStepApprover", fields: [approverStaffId], references: [id])

  @@unique([leaveRequestId, level])
  @@index([approverStaffId, status])
  @@map("leave_approval_steps")
}

