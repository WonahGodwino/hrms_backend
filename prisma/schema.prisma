// ==================== PAYROLL ENGINE MODELS ====================

enum PayPeriodStatus {
  DRAFT
  VALIDATION_OPEN
  VALIDATION_CLOSED
  COMPUTING
  REVIEW
  APPROVED
  PAID
}

enum ValidationStatus {
  PENDING
  YES_FOR_PAYMENT
  NO_FOR_PAYMENT
}

enum PaymentStatus {
  PENDING
  ACTIVE
  WITHHELD
  PAID
}

enum EmployeeCategory {
  REGULAR
  CONTRACT
}

enum DeductionType {
  UNION_DUES
  COOPERATIVE
  LOAN
  SALARY_ADVANCE
  OTHER
}

model PayPeriod {
  id                    String          @id @default(cuid())
  companyId             String
  year                  Int
  month                 Int
  periodName            String
  startDate             DateTime
  endDate               DateTime
  validationWindowStart DateTime?
  validationWindowEnd   DateTime?
  status                PayPeriodStatus @default(DRAFT)
  standardMonthlyHours  Int             @default(176)
  createdBy             String
  approvedBy            String?
  approvedAt            DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  computedPayslips   ComputedPayslip[]
  payValidations     PayValidation[]
  overtimeEntries    OvertimeEntry[]
  deductionEntries   DeductionEntry[]
  taxFilingSchedules TaxFilingSchedule[]

  @@unique([companyId, year, month])
  @@index([companyId, status])
  @@map("pay_periods")
}

model EmployeeSalary {
  id                       String           @id @default(cuid())
  staffId                  String
  companyId                String
  employeeCategory         EmployeeCategory @default(REGULAR)
  basicSalary              Decimal          @db.Decimal(18, 2)
  housingAllowance         Decimal          @default(0) @db.Decimal(18, 2)
  transportAllowance       Decimal          @default(0) @db.Decimal(18, 2)
  dressingAllowance        Decimal          @default(0) @db.Decimal(18, 2)
  leaveAllowance           Decimal          @default(0) @db.Decimal(18, 2)
  entertainmentAllowance   Decimal          @default(0) @db.Decimal(18, 2)
  utilityAllowance         Decimal          @default(0) @db.Decimal(18, 2)
  otherAllowances          Decimal          @default(0) @db.Decimal(18, 2)
  annualRent               Decimal          @default(0) @db.Decimal(18, 2)
  bankName                 String?
  accountNumber            String?
  accountName              String?
  pensionFundAdministrator String?
  pensionPin               String?
  isActive                 Boolean          @default(true)
  effectiveDate            DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  staff   StaffRecord @relation(fields: [staffId], references: [id], onDelete: Cascade)
  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([staffId, companyId, isActive])
  @@index([companyId])
  @@map("employee_salaries")
}

model PayValidation {
  id           String           @id @default(cuid())
  payPeriodId  String
  staffId      String
  supervisorId String?
  departmentId String?
  companyId    String
  status       ValidationStatus @default(PENDING)
  reason       String?
  validatedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  payPeriod  PayPeriod    @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  staff      StaffRecord  @relation("PayValidationStaff", fields: [staffId], references: [id], onDelete: Cascade)
  supervisor StaffRecord? @relation("PayValidationSupervisor", fields: [supervisorId], references: [id])
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([payPeriodId, staffId])
  @@index([payPeriodId, status])
  @@index([payPeriodId, supervisorId])
  @@index([companyId])
  @@map("pay_validations")
}

model OvertimeEntry {
  id            String    @id @default(cuid())
  payPeriodId   String
  staffId       String
  companyId     String
  overtimeHours Decimal   @db.Decimal(10, 2)
  multiplier    Decimal   @default(1.5) @db.Decimal(5, 2)
  date          DateTime?
  description   String?
  sourceFileId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payPeriod PayPeriod   @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  staff     StaffRecord @relation(fields: [staffId], references: [id], onDelete: Cascade)
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([payPeriodId, staffId])
  @@index([companyId])
  @@index([sourceFileId])
  @@map("overtime_entries")
}

model DeductionEntry {
  id            String        @id @default(cuid())
  payPeriodId   String
  staffId       String
  companyId     String
  deductionType DeductionType
  amount        Decimal       @db.Decimal(18, 2)
  description   String?
  sourceFileId  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payPeriod PayPeriod   @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  staff     StaffRecord @relation(fields: [staffId], references: [id], onDelete: Cascade)
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([payPeriodId, staffId])
  @@index([payPeriodId, deductionType])
  @@index([companyId])
  @@index([sourceFileId])
  @@map("deduction_entries")
}

model ComputedPayslip {
  id             String  @id @default(cuid())
  payPeriodId    String
  staffId        String
  companyId      String
  employeeName   String?
  employeeEmail  String?
  departmentId   String?
  departmentName String?

  basicSalary            Decimal @default(0) @db.Decimal(18, 2)
  housingAllowance       Decimal @default(0) @db.Decimal(18, 2)
  transportAllowance     Decimal @default(0) @db.Decimal(18, 2)
  dressingAllowance      Decimal @default(0) @db.Decimal(18, 2)
  leaveAllowance         Decimal @default(0) @db.Decimal(18, 2)
  entertainmentAllowance Decimal @default(0) @db.Decimal(18, 2)
  utilityAllowance       Decimal @default(0) @db.Decimal(18, 2)
  otherAllowances        Decimal @default(0) @db.Decimal(18, 2)
  overtimeEarnings       Decimal @default(0) @db.Decimal(18, 2)
  bonusKpi               Decimal @default(0) @db.Decimal(18, 2)
  grossSalary            Decimal @default(0) @db.Decimal(18, 2)

  pensionEmployee          Decimal @default(0) @db.Decimal(18, 2)
  pensionEmployer          Decimal @default(0) @db.Decimal(18, 2)
  nhf                      Decimal @default(0) @db.Decimal(18, 2)
  nhis                     Decimal @default(0) @db.Decimal(18, 2)
  totalStatutoryDeductions Decimal @default(0) @db.Decimal(18, 2)

  annualGrossIncome           Decimal @default(0) @db.Decimal(18, 2)
  rentRelief                  Decimal @default(0) @db.Decimal(18, 2)
  consolidatedReliefAllowance Decimal @default(0) @db.Decimal(18, 2)
  annualChargeableIncome      Decimal @default(0) @db.Decimal(18, 2)
  annualPAYE                  Decimal @default(0) @db.Decimal(18, 2)
  monthlyPAYE                 Decimal @default(0) @db.Decimal(18, 2)

  unionDues            Decimal @default(0) @db.Decimal(18, 2)
  cooperativeDeduction Decimal @default(0) @db.Decimal(18, 2)
  loanRepayment        Decimal @default(0) @db.Decimal(18, 2)
  otherDeductions      Decimal @default(0) @db.Decimal(18, 2)
  totalDeductions      Decimal @default(0) @db.Decimal(18, 2)

  netSalary Decimal @default(0) @db.Decimal(18, 2)

  paymentStatus    PaymentStatus     @default(PENDING)
  validationStatus ValidationStatus?
  withheldReason   String?

  bankName                 String?
  accountNumber            String?
  accountName              String?
  pensionFundAdministrator String?
  pensionPin               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payPeriod PayPeriod   @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  staff     StaffRecord @relation(fields: [staffId], references: [id], onDelete: Cascade)
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([payPeriodId, staffId])
  @@index([payPeriodId, paymentStatus])
  @@index([payPeriodId, departmentId])
  @@index([staffId])
  @@index([companyId])
  @@map("computed_payslips")
}

// ==================== PHED MODULE (Port Harcourt Client) ====================

enum PhedStaffCategory {
  REGULAR
  CONTRACT
  NYSC_IT
}

enum PhedPayPeriodStatus {
  DRAFT
  VALIDATION_OPEN
  VALIDATION_CLOSED
  TEMPLATE_ISSUED
  PROCESSING
  REVIEW
  APPROVED
  PAID
}

enum PhedValidationStatus {
  PENDING
  YES_FOR_PAYMENT
  NO_FOR_PAYMENT
}

enum PhedPaymentStatus {
  ACTIVE
  WITHHELD
}

// Grade level definitions (Regular: Officer IV → GM | Contract: Staff 1, Staff 2)
model PhedGrade {
  id                 String            @id @default(cuid())
  companyId          String
  name               String // e.g. "Officer IV", "General Manager"
  code               String // e.g. "GL06", "GM"
  category           PhedStaffCategory
  levelOrder         Int
  defaultBasicSalary Decimal?          @db.Decimal(18, 2)
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  company            Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  allowanceTemplates PhedAllowanceTemplate[]
  staff              PhedStaff[]

  @@unique([companyId, code])
  @@index([companyId, category])
  @@map("phed_grades")
}

// Default allowance templates per grade (FIXED = naira, PERCENTAGE = % of basic)
model PhedAllowanceTemplate {
  id            String   @id @default(cuid())
  gradeId       String
  allowanceType String // HOUSING | TRANSPORT | FURNITURE | MEAL_SUBSIDY | UTILITY | LEAVE | DOMESTIC | HAZARD | ELECTRICITY | DISCOVERY | CAR_SUBSIDY | ENTERTAINMENT | DATA | NIGHT | ARREARS | OTHER
  valueType     String // FIXED | PERCENTAGE
  value         Decimal  @db.Decimal(18, 4)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  grade PhedGrade @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@unique([gradeId, allowanceType])
  @@map("phed_allowance_templates")
}

// HR-managed regions
model PhedRegion {
  id        String   @id @default(cuid())
  companyId String
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  feeders PhedFeeder[]
  staff   PhedStaff[]

  @@unique([companyId, name])
  @@map("phed_regions")
}

// HR-managed feeders (belong to a region)
model PhedFeeder {
  id        String   @id @default(cuid())
  regionId  String
  companyId String
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  region    PhedRegion     @relation(fields: [regionId], references: [id], onDelete: Cascade)
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payPoints PhedPayPoint[]
  staff     PhedStaff[]

  @@unique([companyId, name])
  @@map("phed_feeders")
}

// HR-managed pay points (optionally linked to a feeder)
model PhedPayPoint {
  id        String   @id @default(cuid())
  feederId  String?
  companyId String
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feeder  PhedFeeder? @relation(fields: [feederId], references: [id])
  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff   PhedStaff[]

  @@unique([companyId, name])
  @@map("phed_pay_points")
}

// Unions — percentage of gross salary deduction per month
model PhedUnion {
  id         String   @id @default(cuid())
  companyId  String
  name       String
  percentage Decimal  @default(0) @db.Decimal(5, 4) // e.g. 0.0250 = 2.5%
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staffUnions PhedStaffUnion[]

  @@unique([companyId, name])
  @@map("phed_unions")
}

// Cooperatives — per-member fixed monthly deduction
model PhedCooperative {
  id         String   @id @default(cuid())
  companyId  String
  name       String
  percentage Decimal  @default(0) @db.Decimal(5, 4) // legacy, no longer used for computation
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company           Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staffCooperatives PhedStaffCooperative[]

  @@unique([companyId, name])
  @@map("phed_cooperatives")
}

// PHED Staff record (independent of main StaffRecord)
model PhedStaff {
  id         String            @id @default(cuid())
  companyId  String
  staffId    String // Employee ID e.g. PHED-001
  firstName  String
  lastName   String
  email      String
  phone      String?
  category   PhedStaffCategory @default(REGULAR)
  gradeId    String?
  department String?
  unit       String?
  regionId   String?
  feederId   String?
  payPointId String?

  // Banking & statutory identifiers
  bankName      String?
  accountNumber String?
  accountName   String?
  rsaPin        String?
  pfaName       String?
  pensionNumber String? // Pension member enrollment / PIN from PFA
  tin           String? // Tax Identification Number (FIRS)
  nhfNumber     String? // National Housing Fund membership number

  // Life assurance
  hasLifeAssurance    Boolean  @default(false)
  lifeAssuranceAmount Decimal? @db.Decimal(18, 2) // Annual premium — deducted from annual gross before PAYE

  // For rent relief calculation
  annualRent Decimal? @db.Decimal(18, 2)

  // Staff profile extras
  jobTitle       String?
  level          String?
  resumptionDate DateTime?
  callCenter     String? // Call center / support desk the employee is assigned to

  // Voluntary deductions (monthly amounts)
  voluntaryPension Decimal? @db.Decimal(18, 2)
  insurance        Decimal? @db.Decimal(18, 2)
  cashAdvanced     Decimal? @db.Decimal(18, 2)
  loan             Decimal? @db.Decimal(18, 2)
  domesticLoan     Decimal? @db.Decimal(18, 2)

  // Salary (overrides grade defaults when set)
  basicSalary            Decimal? @db.Decimal(18, 2)
  housingAllowance       Decimal? @db.Decimal(18, 2)
  transportAllowance     Decimal? @db.Decimal(18, 2)
  furnitureAllowance     Decimal? @db.Decimal(18, 2)
  mealSubsidy            Decimal? @db.Decimal(18, 2)
  utilityAllowance       Decimal? @db.Decimal(18, 2)
  leaveAllowance         Decimal? @db.Decimal(18, 2)
  domesticAllowance      Decimal? @db.Decimal(18, 2)
  hazardAllowance        Decimal? @db.Decimal(18, 2)
  electricityAllowance   Decimal? @db.Decimal(18, 2)
  discoveryAllowance     Decimal? @db.Decimal(18, 2)
  carSubsidy             Decimal? @db.Decimal(18, 2)
  entertainmentAllowance Decimal? @db.Decimal(18, 2)
  dataAllowance          Decimal? @db.Decimal(18, 2)
  nightAllowance         Decimal? @db.Decimal(18, 2)
  arrears                Decimal? @db.Decimal(18, 2)
  otherAllowances        Decimal? @db.Decimal(18, 2)

  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company              Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  grade                PhedGrade?                    @relation(fields: [gradeId], references: [id])
  region               PhedRegion?                   @relation(fields: [regionId], references: [id])
  feeder               PhedFeeder?                   @relation(fields: [feederId], references: [id])
  payPoint             PhedPayPoint?                 @relation(fields: [payPointId], references: [id])
  unions               PhedStaffUnion[]
  cooperatives         PhedStaffCooperative[]
  deductionLiabilities PhedStaffDeductionLiability[]
  validations          PhedValidation[]
  overtimeEntries      PhedOvertimeEntry[]
  computedPayrolls     PhedComputedPayroll[]
  periodAdvances       PhedStaffPeriodAdvance[]
  changeLogs           PhedChangeLog[]
  exitRecords          PhedStaffExit[]

  @@unique([companyId, staffId])
  @@unique([companyId, email])
  @@index([companyId, category, isActive])
  @@map("phed_staff")
}

// Staff ↔ Union (many-to-many)
model PhedStaffUnion {
  id         String   @id @default(cuid())
  staffId    String
  unionId    String
  assignedAt DateTime @default(now())

  staff PhedStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  union PhedUnion @relation(fields: [unionId], references: [id], onDelete: Cascade)

  @@unique([staffId, unionId])
  @@map("phed_staff_unions")
}

// Staff ↔ Cooperative (many-to-many, per-member fixed monthly deduction amounts)
model PhedStaffCooperative {
  id                 String   @id @default(cuid())
  staffId            String
  cooperativeId      String
  contributionAmount Decimal  @default(0) @db.Decimal(18, 2)
  loanAmount         Decimal  @default(0) @db.Decimal(18, 2)
  totalAmount        Decimal  @default(0) @db.Decimal(18, 2) // contributionAmount + loanAmount
  assignedAt         DateTime @default(now())
  updatedAt          DateTime @updatedAt

  staff       PhedStaff       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  cooperative PhedCooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)

  @@unique([staffId, cooperativeId])
  @@map("phed_staff_cooperatives")
}

// Deductions & Liabilities (per-employee fixed monthly deduction, name only to create)
model PhedDeductionLiability {
  id        String   @id @default(cuid())
  companyId String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff   PhedStaffDeductionLiability[]

  @@unique([companyId, name])
  @@map("phed_deduction_liabilities")
}

model PhedStaffDeductionLiability {
  id                   String   @id @default(cuid())
  staffId              String
  deductionLiabilityId String
  amount               Decimal  @default(0) @db.Decimal(18, 2)
  assignedAt           DateTime @default(now())
  updatedAt            DateTime @updatedAt

  staff              PhedStaff              @relation(fields: [staffId], references: [id], onDelete: Cascade)
  deductionLiability PhedDeductionLiability @relation(fields: [deductionLiabilityId], references: [id], onDelete: Cascade)

  @@unique([staffId, deductionLiabilityId])
  @@map("phed_staff_deduction_liabilities")
}

// Monthly pay periods
model PhedPayPeriod {
  id                String              @id @default(cuid())
  companyId         String
  year              Int
  month             Int
  periodName        String // e.g. "April 2026"
  validationOpenAt  DateTime?
  validationCloseAt DateTime?
  status            PhedPayPeriodStatus @default(DRAFT)
  createdBy         String
  approvedBy        String?
  approvedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  company          Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  validations      PhedValidation[]
  overtimeEntries  PhedOvertimeEntry[]
  computedPayrolls PhedComputedPayroll[]
  bulkUploads      PhedBulkUpload[]
  periodAdvances   PhedStaffPeriodAdvance[]
  approvalMemo     PhedApprovalMemo?

  @@unique([companyId, year, month])
  @@index([companyId, status])
  @@map("phed_pay_periods")
}

// Monthly staff payment validation (Yes/No for payment)
model PhedValidation {
  id          String               @id @default(cuid())
  payPeriodId String
  staffId     String
  companyId   String
  status      PhedValidationStatus @default(PENDING)
  validatedBy String?
  validatedAt DateTime?
  reason      String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  payPeriod PhedPayPeriod @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  staff     PhedStaff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([payPeriodId, staffId])
  @@index([payPeriodId, status])
  @@map("phed_validations")
}

// Overtime entries per staff per period
model PhedOvertimeEntry {
  id             String   @id @default(cuid())
  payPeriodId    String
  staffId        String
  companyId      String
  overtimeHours  Decimal  @db.Decimal(10, 2)
  computedAmount Decimal? @db.Decimal(18, 2)
  sourceFileId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payPeriod PhedPayPeriod @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  staff     PhedStaff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([payPeriodId, staffId])
  @@index([payPeriodId])
  @@map("phed_overtime_entries")
}

// Cash advances, loans, and domestic loans per staff per period (HR-entered via payroll template)
model PhedStaffPeriodAdvance {
  id           String   @id @default(cuid())
  payPeriodId  String
  staffId      String
  companyId    String
  cashAdvanced Decimal  @default(0) @db.Decimal(18, 2)
  loan         Decimal  @default(0) @db.Decimal(18, 2)
  domesticLoan Decimal  @default(0) @db.Decimal(18, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payPeriod PhedPayPeriod @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  staff     PhedStaff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([payPeriodId, staffId])
  @@index([payPeriodId])
  @@map("phed_staff_period_advances")
}

// Final computed payroll per staff per period
model PhedComputedPayroll {
  id          String @id @default(cuid())
  payPeriodId String
  staffId     String
  companyId   String

  // Staff snapshot (denormalized for reports)
  staffName   String?
  staffEmail  String?
  staffIdCode String?
  category    PhedStaffCategory?
  gradeName   String?
  department  String?
  unit        String?
  regionName  String?

  // Earnings
  basicSalary            Decimal @default(0) @db.Decimal(18, 2)
  housingAllowance       Decimal @default(0) @db.Decimal(18, 2)
  transportAllowance     Decimal @default(0) @db.Decimal(18, 2)
  furnitureAllowance     Decimal @default(0) @db.Decimal(18, 2)
  mealSubsidy            Decimal @default(0) @db.Decimal(18, 2)
  utilityAllowance       Decimal @default(0) @db.Decimal(18, 2)
  leaveAllowance         Decimal @default(0) @db.Decimal(18, 2)
  domesticAllowance      Decimal @default(0) @db.Decimal(18, 2)
  hazardAllowance        Decimal @default(0) @db.Decimal(18, 2)
  electricityAllowance   Decimal @default(0) @db.Decimal(18, 2)
  discoveryAllowance     Decimal @default(0) @db.Decimal(18, 2)
  carSubsidy             Decimal @default(0) @db.Decimal(18, 2)
  entertainmentAllowance Decimal @default(0) @db.Decimal(18, 2)
  dataAllowance          Decimal @default(0) @db.Decimal(18, 2)
  nightAllowance         Decimal @default(0) @db.Decimal(18, 2)
  arrears                Decimal @default(0) @db.Decimal(18, 2)
  otherAllowances        Decimal @default(0) @db.Decimal(18, 2)
  overtimeEarnings       Decimal @default(0) @db.Decimal(18, 2)
  grossSalary            Decimal @default(0) @db.Decimal(18, 2)

  // Statutory deductions
  pensionEmployee Decimal @default(0) @db.Decimal(18, 2)
  pensionEmployer Decimal @default(0) @db.Decimal(18, 2)
  nhf             Decimal @default(0) @db.Decimal(18, 2)

  // Tax calculation (NTA 2025)
  annualRentRelief       Decimal @default(0) @db.Decimal(18, 2)
  lifeAssuranceAmount    Decimal @default(0) @db.Decimal(18, 2)
  annualGrossIncome      Decimal @default(0) @db.Decimal(18, 2)
  annualPensionDeduction Decimal @default(0) @db.Decimal(18, 2)
  annualChargeableIncome Decimal @default(0) @db.Decimal(18, 2)
  annualPAYE             Decimal @default(0) @db.Decimal(18, 2)
  monthlyPAYE            Decimal @default(0) @db.Decimal(18, 2)

  // Variable deductions
  unionDeductions       Decimal @default(0) @db.Decimal(18, 2)
  cooperativeDeductions Decimal @default(0) @db.Decimal(18, 2)
  deductionLiabilities  Decimal @default(0) @db.Decimal(18, 2)
  voluntaryPension      Decimal @default(0) @db.Decimal(18, 2)
  insurance             Decimal @default(0) @db.Decimal(18, 2)
  cashAdvanced          Decimal @default(0) @db.Decimal(18, 2)
  loan                  Decimal @default(0) @db.Decimal(18, 2)
  domesticLoan          Decimal @default(0) @db.Decimal(18, 2)
  otherDeductions       Decimal @default(0) @db.Decimal(18, 2)
  totalDeductions       Decimal @default(0) @db.Decimal(18, 2)

  netSalary Decimal @default(0) @db.Decimal(18, 2)

  // Status
  validationStatus PhedValidationStatus?
  paymentStatus    PhedPaymentStatus     @default(ACTIVE)
  withheldReason   String?

  // Banking & statutory snapshot (for reports)
  bankName      String?
  accountNumber String?
  accountName   String?
  pfaName       String?
  rsaPin        String?
  pensionNumber String?
  tin           String?
  nhfNumber     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payPeriod PhedPayPeriod @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  staff     PhedStaff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([payPeriodId, staffId])
  @@index([payPeriodId, paymentStatus])
  @@index([payPeriodId])
  @@index([companyId])
  @@map("phed_computed_payrolls")
}

// ============================================================
// PHED PAYROLL APPROVAL WORKFLOW & ACCESS MATRIX (Module 12 & 13)
// These roles are created from scratch and are independent of
// StaffRecord.role — they grant no access outside the PHED module.
// ============================================================

enum PhedAccessRole {
  MANAGER_COMP_BENEFITS // Stage 1 label — filled by the payroll uploader (HR/ADMIN/SUPER_ADMIN); full page access
  TAX_AUDIT // Stage 2 approver + full payroll page access
  HEAD_INTERNAL_AUDIT // Stage 3 approver + IAD Page only
  CHIEF_PEOPLE_OFFICER // Stage 4 approver + full payroll page access
  CHIEF_FINANCE_OFFICER // Stage 5 approver + full payroll page access
  MD_CEO // Stage 6 approver + full payroll page access
  TREASURY_TEAM // no approval stage; scoped page access
  FINANCIAL_REPORTING_TEAM // no approval stage; Cost Centre Report only
  TAX_TEAM // no approval stage; PAYE Schedule only
}

model PhedStaffAccessRole {
  id            String         @id @default(cuid())
  companyId     String
  staffRecordId String         @unique
  accessRole    PhedAccessRole
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staffRecord StaffRecord @relation(fields: [staffRecordId], references: [id], onDelete: Cascade)

  @@index([companyId, accessRole])
  @@map("phed_staff_access_roles")
}

// Immutable governance ledger for PHED workflow/page-role assignments.
// The assignment row holds current access; this ledger records every grant,
// change, and revocation with an accountable actor and a required reason.
enum PhedAccessRoleChangeAction {
  ASSIGNED
  CHANGED
  REVOKED
}

model PhedAccessRoleChange {
  id            String                     @id @default(cuid())
  companyId     String
  staffRecordId String
  action        PhedAccessRoleChangeAction
  previousRole  PhedAccessRole?
  newRole       PhedAccessRole?
  reason        String
  changedById   String
  changedByName String
  changedByRole String
  createdAt     DateTime                   @default(now())

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staffRecord StaffRecord @relation("PhedAccessRoleChangeTarget", fields: [staffRecordId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([staffRecordId, createdAt])
  @@map("phed_access_role_changes")
}

// Module 12 — Payroll Approval Workflow.
// Stage order/role mapping is fixed in application code (PHED_APPROVAL_STAGES),
// never DB-configurable.
enum PhedApprovalMemoStatus {
  PENDING_TAX_AUDIT // at Stage 2 (Tax Audit)
  PENDING_HR_APPROVAL // back at Stage 1 — Tax Audit concurred, awaiting HR sign-off
  PENDING_REVIEW // at Stage 3 (Head IAD)
  PENDING_FIRST_LEVEL_APPROVAL // at Stage 4 (CPO)
  PENDING_SECOND_LEVEL_APPROVAL // at Stage 5 (CFO)
  PENDING_FINAL_APPROVAL // at Stage 6 (MD/CEO)
  APPROVED // terminal — ready for disbursement
  RETURNED_FOR_CORRECTION // flagged back to Stage 1, awaiting resubmission
}

enum PhedApprovalStampAction {
  SUBMITTED
  TAX_AUDITED
  RELEASED_TO_AUDIT // Stage 1 HR sign-off after Tax Audit concurrence (HR release step)
  RECOMMENDED
  APPROVED
  FINAL_APPROVED
  FLAGGED
}

model PhedLetterTemplate {
  id             String   @id @default(cuid())
  companyId      String
  type           String   @default("SALARY_INCREASE")
  version        Int      @default(1)
  body           String // canonical text with {{tokens}}
  letterhead     String // address block + "Personal and Confidential"
  signatoryName  String
  signatoryTitle String
  tokens         Json // string[] of tokens used
  createdById    String
  createdAt      DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, type, version])
  @@map("phed_letter_templates")
}

model PhedLetterRun {
  id               String    @id @default(cuid())
  companyId        String
  operatorId       String
  sourceFileName   String
  sourceFileSize   Int
  sourceFileSha256 String
  storageKey       String?
  runInputs        Json
  templateId       String? // snapshot id of the template version used (plain string, no FK)
  templateVersion  Int?
  status           String    @default("VALIDATING") // VALIDATING | AWAITING_CONFIRMATION | GENERATING | COMPLETED | COMPLETED_WITH_FAILURES | CANCELLED | EXPIRED
  counts           Json?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?
  filesExpireAt    DateTime?

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rows    PhedLetterRunRow[]

  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@map("phed_letter_runs")
}

model PhedLetterRunRow {
  id         String   @id @default(cuid())
  runId      String
  companyId  String
  excelRow   Int
  employeeId String
  values     Json?
  findings   Json?
  status     String   @default("PENDING") // PENDING | EXCLUDED | QUEUED | GENERATED | FAILED
  outputKey  String?
  error      String?
  createdAt  DateTime @default(now())

  run     PhedLetterRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([runId, employeeId])
  @@index([companyId, runId])
  @@map("phed_letter_run_rows")
}

model PhedLetterAuditEvent {
  id        String   @id @default(cuid())
  companyId String
  actorId   String?
  action    String
  runId     String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([runId])
  @@map("phed_letter_audit_events")
}

model PhedApprovalMemo {
  id             String                 @id @default(cuid())
  companyId      String
  payPeriodId    String                 @unique // one active memo per pay period
  currentStage   Int // 1–5
  status         PhedApprovalMemoStatus
  attemptNumber  Int                    @default(1) // bumped on every flag→resubmit cycle
  stageEnteredAt DateTime               @default(now()) // for "time elapsed at this desk"
  createdAt      DateTime               @default(now()) // frozen memo DATE — Stage 1's original submission
  updatedAt      DateTime               @updatedAt

  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payPeriod PhedPayPeriod       @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  stamps    PhedApprovalStamp[]

  @@index([companyId, status])
  @@map("phed_approval_memos")
}

// Append-only audit trail — no update/delete code path is ever written for
// this model. Stamps from a superseded attempt (attemptNumber < memo.attemptNumber)
// remain visible in history but are superseded by the current attempt's stamps.
model PhedApprovalStamp {
  id            String                  @id @default(cuid())
  memoId        String
  attemptNumber Int
  stage         Int
  action        PhedApprovalStampAction
  staffRecordId String // not a relation — stamp must outlive the actor's record
  actorName     String // snapshot, immutable even if the profile name changes later
  actorRole     PhedAccessRole // snapshot
  comment       String?
  createdAt     DateTime                @default(now())

  memo PhedApprovalMemo @relation(fields: [memoId], references: [id], onDelete: Cascade)

  @@index([memoId, attemptNumber])
  @@map("phed_approval_stamps")
}

// Module 13 — Role-Based Payroll Access Matrix.
// Page-level access is layered IN FRONT of, and independent from, the
// approval-action permission above (PRD 12.2 / 13). Full-access roles
// (Manager Comp&Benefits, CPO, CFO, MD/CEO) are granted every pageKey as
// literal rows — no special-casing in the guard code (PRD 13.6 point 46).
enum PhedPageKey {
  BANK_PAGE
  PENSION_SCHEDULE
  PAYE_SCHEDULE
  NSITF_SCHEDULE
  ITF_SCHEDULE
  NHF_SCHEDULE
  UNIONS_COOPERATIVES_DEDUCTIONS
  LIABILITIES_TO_PHED
  COST_CENTRE_REPORT
  IAD_SUMMARY
  IAD_CHANGES
  IAD_EXITED
  IAD_NEW_HIRED
}

model PhedRoleAccessGrant {
  id         String         @id @default(cuid())
  companyId  String
  accessRole PhedAccessRole
  pageKey    PhedPageKey
  createdAt  DateTime       @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, accessRole, pageKey])
  @@index([companyId, accessRole])
  @@map("phed_role_access_grants")
}

// IAD Page — "Changes" tab (PRD 13.3). Logs payroll-affecting edits to
// PhedStaff (salary, allowances, grade, department/unit, tax inputs) so the
// Head of Internal Audit can see what changed since the previous pay period.
model PhedChangeLog {
  id            String   @id @default(cuid())
  companyId     String
  staffId       String
  field         String
  oldValue      String?
  newValue      String?
  changedBy     String // StaffRecord id of the actor
  changedByName String // snapshot, mirrors the immutability convention used for approval stamps
  changedAt     DateTime @default(now())

  company Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff   PhedStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([companyId, changedAt])
  @@index([staffId, changedAt])
  @@map("phed_change_logs")
}

// IAD Page — "Exited" tab (PRD 13.3). Self-contained within PHED — there is
// no Offboarding module backend to cross-reference (confirmed empty), so
// exit detail is captured directly here rather than deferred to a module
// that doesn't exist yet.
enum PhedExitReason {
  RESIGNATION
  TERMINATION
  RETIREMENT
  END_OF_CONTRACT
  OTHER
}

model PhedStaffExit {
  id              String         @id @default(cuid())
  companyId       String
  staffId         String
  exitDate        DateTime
  reason          PhedExitReason
  finalGrossPay   Decimal?       @db.Decimal(18, 2)
  finalDeductions Decimal?       @db.Decimal(18, 2)
  finalNetPay     Decimal?       @db.Decimal(18, 2)
  notes           String?
  recordedBy      String
  recordedByName  String
  createdAt       DateTime       @default(now())

  company Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff   PhedStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([companyId, exitDate])
  @@map("phed_staff_exits")
}

// ============================================================
// TRAINING & CERTIFICATION MODULE
// ============================================================

model TrainingProgram {
  id                 String    @id @default(cuid())
  companyId          String
  programName        String
  slug               String
  category           String
  trainingType       String // Online | Hybrid | Instructor-Led | On-site
  description        String
  level              String    @default("Beginner") // Beginner | Intermediate | Advanced
  departments        String[]
  trainer            String
  durationHours      Decimal?  @db.Decimal(6, 2)
  sessionType        String    @default("Single") // Single | Multi-session
  startDate          DateTime
  endDate            DateTime
  location           String?
  maxParticipants    Int?
  assessmentRequired Boolean   @default(true)
  assessmentType     String?   @default("Quiz") // Quiz | Certification | Evaluation
  passingScore       Int       @default(80)
