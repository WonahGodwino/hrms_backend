  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template    PayrollTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  staff       StaffRecord     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([companyId, staffId, payPeriod])
  @@index([companyId, payPeriod, status])
  @@index([templateId, payPeriod])
  @@index([createdAt])
  @@map("payroll_data")
}

model PayrollTemplateUpload {
  id                String   @id @default(cuid())
