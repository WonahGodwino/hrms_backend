  recurrenceValue       Int?
  recurrenceUnit        String?
  startOption           String?
  endOption             String?
  graceDays             Int       @default(7)
  priority              String    @default("Medium")
  scope                 String    @default("All Employees")
  notifyOnAssignment    Boolean   @default(true)
  statusHandling        String[]
  escalateManager       Boolean   @default(false)
  preExpiryNotifications Int[]
