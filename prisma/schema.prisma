// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

model Company {
 id          String   @id @default(cuid())
  companyName String
  address     String?
  phone       String?
  email       String?
  logo        String?
  taxId       String?
  archived    Int      @default(0)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt  // Nullable first
  // Relations
  staff              StaffRecord[] // One-to-many relation with StaffRecord
  payrolls           Payroll[] // One-to-many relation with Payroll
  payslips           Payslip[] // One-to-many relation with Payslip
  staffUploads       StaffUpload[] // One-to-many relation with StaffUpload
  payrollUploads     PayrollUpload[] // One-to-many relation with PayrollUpload
  jobs               Job[] // One-to-many relation with Job
  candidates         Candidate[] // One-to-many relation with Candidate
  applications       JobApplication[] // One-to-many relation with JobApplication
  offers             Offer[] // One-to-many relation with Offer
  onboardings        Onboarding[] // One-to-many relation with Onboarding
  interviews         Interview[] // One-to-many relation with Interview
  candidateDocuments CandidateDocument[] // One-to-many relation with CandidateDocument
  candidateFiles     CandidateFile[] // One-to-many relation with CandidateFile
  
  // NEW: AI Settings relations (one-to-one and one-to-many)
  aiSettings  AISettings? // One-to-one relation with AISettings
  aiUsageLogs AIUsageLog[] // One-to-many relation with AIUsageLog

   // NEW: UserCompany relation
  userCompanies UserCompany[] // Add this line

  @@map("companies")
}

model StaffRecord {
  id            String   @id @default(cuid())
  staffId       String
  email         String
  firstName     String
  lastName      String
  department    String
  position      String
  phone         String?
  bankName      String?
  accountNumber String?
  bvn           String?
  password      String?
  isRegistered  Boolean  @default(false)
  role          String   @default("STAFF")
  isActive      Boolean  @default(true)
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  payrolls    Payroll[]
  payslips    Payslip[]
  onboardings Onboarding[]
  userCompanies UserCompany[] // Add this line to complete the relation

  @@unique([staffId, companyId])
  @@unique([email, companyId])
  @@map("staff_records")
}

model Payroll {
  id            String @id @default(cuid())
  month         String
  year          Int
  staffRecordId String
  companyId     String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Basic salary components
  grossPay         Decimal @db.Decimal(18, 2)
  proratedGrossPay Decimal @db.Decimal(18, 2)
  basicSalary      Decimal @db.Decimal(18, 2)
  housing          Decimal @db.Decimal(18, 2)
  transport        Decimal @db.Decimal(18, 2)
  dressing         Decimal @db.Decimal(18, 2)
  leaveAllowance   Decimal @db.Decimal(18, 2)
  entertainment    Decimal @db.Decimal(18, 2)
  utility          Decimal @db.Decimal(18, 2)

  // Calculations
  proratedGrossWithExtra Decimal @db.Decimal(18, 2)
  annualPension          Decimal @db.Decimal(18, 2)
  annualGrossPay         Decimal @db.Decimal(18, 2)
  consolidatedRelief     Decimal @db.Decimal(18, 2)
  taxableIncome          Decimal @db.Decimal(18, 2)

  // Deductions
  deductions          Decimal @db.Decimal(18, 2)
  payee               Decimal @db.Decimal(18, 2)
  pensionDeduction    Decimal @db.Decimal(18, 2)
  bonusKPI            Decimal @db.Decimal(18, 2)
  netSalary           Decimal @db.Decimal(18, 2)
  finalGross          Decimal @db.Decimal(18, 2)
  medicalContribution Decimal @db.Decimal(18, 2)

  // Employer contributions
  employerPension    Decimal @db.Decimal(18, 2)
  nsitf              Decimal @db.Decimal(18, 2)
  proratedSubTotal   Decimal @db.Decimal(18, 2)
  managementFee      Decimal @db.Decimal(18, 2)
  vatOnManagementFee Decimal @db.Decimal(18, 2)
  totalInvoiceValue  Decimal @db.Decimal(18, 2)

  status     PayrollStatus @default(PROCESSED)
  uploadedBy String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  staffRecord StaffRecord @relation(fields: [staffRecordId], references: [id], onDelete: Cascade)
  payslips    Payslip[]

  @@unique([staffRecordId, month, year, companyId])
  @@index([companyId, year, month])
  @@map("payrolls")
}

model Payslip {
  id            String   @id @default(cuid())
  payrollId     String
  staffRecordId String
  companyId     String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // File storage as binary data
  fileData      Bytes?   // Store PDF as binary data
  fileName      String
  fileType      String   @default("application/pdf")
  fileSize      Int?     // in bytes
  
  // Keep original filePath for migration/backward compatibility
  filePath      String?  
  
  month         String
  year          Int
  grossPay      Decimal? @db.Decimal(18, 2)
  netPay        Decimal? @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  updatedBy String?
  createdBy String?

  payroll     Payroll     @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  staffRecord StaffRecord @relation(fields: [staffRecordId], references: [id], onDelete: Cascade)

  @@index([staffRecordId, year, month])
  @@map("payslips")
}

model StaffUpload {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  fileName     String
  filePath     String
  totalRecords Int
  successful   Int
  failed       Int
  errors       String[]
  uploadedBy   String
  createdAt    DateTime @default(now())

  @@map("staff_uploads")
}

model PayrollUpload {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  fileName          String
  filePath          String
  processedFilePath String?
  processedFileName String?

  totalRecords      Int
  successful        Int
  failed            Int
  payslipsGenerated Int?
  payslipsUpdated   Int?
  emailsSent        Int?
  emailAttempts     Int?
  errors            String[]

  uploadedBy String
  createdAt  DateTime @default(now())

  @@map("payroll_uploads")
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  PAID
  FAILED
}

enum JobStatus {
  DRAFT
  ACTIVE
  CLOSED
  EXPIRED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING      // Add this
  SHORTLISTED
  INTERVIEWING
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

enum InterviewType {
  PHONE
  VIDEO
  ONSITE
}

enum InterviewOutcome {
  PENDING
  PASSED
  FAILED
  NO_SHOW
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OnboardingTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
}

enum CandidateDocumentType {
  CV
  COVER_LETTER
  ID_CARD
  CERTIFICATE
  OFFER_LETTER
  CONTRACT
  NDA
  OTHER
}

enum CandidateFileType {
  CV
  COVER_LETTER
  OTHER
}

model JobApplication {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  cvFilePath      String
  cvFileName      String?
  parsedCvContent String?

  status ApplicationStatus @default(SUBMITTED)

  score Int?
  notes String?
  
  // NEW: Add metadata field for AI review information
  metadata Json?
  reviewedBy String?
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviewedAt DateTime?

  // Relations with CandidateFile
  files    CandidateFile[] @relation("ApplicationFiles")
  cvFileId String?         @unique // Added @unique for one-to-one
  cvFile   CandidateFile?  @relation("ApplicationCVFile", fields: [cvFileId], references: [id])

  interviews   Interview[]
  stageHistory ApplicationStageHistory[]
  offer        Offer?

  @@unique([jobId, candidateId])
  @@index([companyId, jobId, status])
  @@index([cvFileId])
  @@map("job_applications")
}

model CandidateFile {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // For general application files (one-to-many)
  applicationId String?
  application   JobApplication? @relation("ApplicationFiles", fields: [applicationId], references: [id], onDelete: SetNull)

  // For CV file reference (one-to-one) - this is the back relation
  cvForApplication JobApplication? @relation("ApplicationCVFile")

  type CandidateFileType @default(CV)

  fileName  String
  mimeType  String
  sizeBytes Int
  data      Bytes

  createdBy String?
  createdAt DateTime @default(now())

  @@index([companyId, candidateId])
  @@index([applicationId])
  @@index([companyId, applicationId, type])
  @@map("candidate_files")
}

model Keyword {
  id          String @id @default(cuid())
  name        String @unique
  description String
  jobId       String
  job         Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("keywords")
}

model Job {
  id          String @id @default(cuid())
  title       String
  description String
  department  String
  position    String

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  status         JobStatus @default(ACTIVE)
  expirationDate DateTime?

  createdBy String
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  applications JobApplication[]
  keywords     Keyword[]

  @@index([companyId, status])
  @@map("jobs")
}

model Candidate {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  email        String
  phone        String?
  address      String?
  linkedInUrl  String?
  portfolioUrl String?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications JobApplication[]
  documents    CandidateDocument[]
  offers       Offer[]
  files        CandidateFile[]

  @@unique([email, companyId])
  @@index([companyId])
  @@map("candidates")
}

model ApplicationStageHistory {
  id String @id @default(cuid())

  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  fromStatus ApplicationStatus?
  toStatus   ApplicationStatus

  changedBy String?
  changedAt DateTime @default(now())
  comment   String?

  @@index([applicationId])
  @@map("application_stage_history")
}

model Interview {
  id String @id @default(cuid())

  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type         InterviewType @default(VIDEO)
  scheduledAt  DateTime
  durationMins Int?
  meetingLink  String?
  location     String?

  interviewers String[] // userIds/emails
  notes        String?
  outcome      InterviewOutcome @default(PENDING)

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId, scheduledAt])
  @@index([companyId])
  @@map("interviews")
}

model Offer {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  applicationId String         @unique
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  status OfferStatus @default(DRAFT)

  proposedStartDate DateTime?
  employmentType    String? // can become enum later
  salary            Decimal?  @db.Decimal(18, 2)
  currency          String? // NGN, USD...

  offerLetterPath String?
  offerLetterName String?

  sentAt     DateTime?
  acceptedAt DateTime?
  declinedAt DateTime?

  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  onboarding Onboarding?

  @@index([companyId, status])
  @@map("offers")
}

model Onboarding {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  offerId String @unique
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  status OnboardingStatus @default(NOT_STARTED)

  startDate   DateTime?
  completedAt DateTime?

  staffRecordId String?
  staffRecord   StaffRecord? @relation(fields: [staffRecordId], references: [id], onDelete: SetNull)

  tasks     OnboardingTask[]
  documents CandidateDocument[]

  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@map("onboardings")
}

model OnboardingTask {
  id String @id @default(cuid())

  onboardingId String
  onboarding   Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  title       String
  description String?
  department  String? // HR / IT / FINANCE
  assigneeId  String? // userId or staffRecordId
  dueDate     DateTime?

  status      OnboardingTaskStatus @default(PENDING)
  completedAt DateTime?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([onboardingId, status])
  @@map("onboarding_tasks")
}

model CandidateDocument {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  onboardingId String?
  onboarding   Onboarding? @relation(fields: [onboardingId], references: [id], onDelete: SetNull)

  type       CandidateDocumentType @default(OTHER)
  filePath   String
  fileName   String
  uploadedBy String?
  createdAt  DateTime              @default(now())

  @@index([candidateId, type])
  @@index([companyId])
  @@map("candidate_documents")
}
//AI cv review models
model AISettings {
  id                   String   @id @default(cuid())
  companyId            String   @unique
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  // Budget settings
  monthlyBudget        Float    @default(100.00) // in USD
  costPerReview        Float    @default(0.02)   // estimated cost per review
  costAlertThreshold   Int      @default(80)     // percentage of budget to trigger alert
  
  // Service settings
  enabled              Boolean  @default(true)
  defaultService       String   @default("openai") // openai, anthropic, gemini, local
  defaultModel         String   @default("gpt-3.5-turbo")
  
  // Usage settings
  autoShortlistThreshold Int    @default(75)
  useForSeniorRoles    Boolean  @default(true)
  useForTechnicalRoles Boolean  @default(true)
  useForManagerRoles   Boolean  @default(true) // Added this field based on your API code
  
  // Notification settings
  notifyEmails         String[] // Emails to notify for alerts
  
  // Tracking
  createdBy            String?
  updatedBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  
  @@map("ai_settings")
}

model AIUsageLog {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  applicationId String? // Link to job application
  service      String   // openai, anthropic, etc.
  model        String
  tokensUsed   Int
  cost         Float
  endpoint     String
  inputLength  Int
  outputLength Int
  
  metadata     Json?
  
  createdAt    DateTime @default(now())
  
  @@index([companyId])
  @@index([createdAt])
  @@map("ai_usage_logs")
}
// Updated UserCompany model with StaffRecord relation
model UserCompany {
  id         String   @id @default(cuid())
  userId     String
  companyId  String
  role       String   @default("HR") // "HR", "ADMIN", "MANAGER", etc.
  
  // Audit fields
  createdBy  String?
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    StaffRecord @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Add a composite unique constraint
  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@index([role])
  @@map("user_companies")
}