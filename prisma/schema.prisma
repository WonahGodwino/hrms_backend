generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id                  String    @id @default(cuid())
  companyName         String
  tradingName         String?
  rcNumber            String?
  industry            String?
  website             String?
  biography           String?   @db.Text
  fiscalYearStart     String?
  leaveYearStart      String?
  status              String    @default("Active")
  address             String?
  phone               String?
  email               String
  logo                String?
  taxId               String?
  pensionEmployerCode String?
  baseCurrency        String    @default("NGN") @db.VarChar(3)
  archived            Int       @default(0)
  createdBy           String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime? @updatedAt
  workWeekPattern     String?   @db.VarChar(20)
  // Attendance lateness rule for Attendance Reporting — "HH:mm" (e.g. "09:00").
  // Null falls back to "09:00"/0 minutes so behavior matches the previous
  // hardcoded client-side default until a company configures its own.
  standardStartTime   String?   @db.VarChar(5)
  lateGraceMinutes    Int?      @default(0)
  // Closing time ("HH:mm", Africa/Lagos) — used to auto clock staff out on
  // holidays. Null falls back to "17:00" in lib/attendance/work-calendar.ts.
  standardEndTime     String?   @db.VarChar(5)

  // Free-trial lifecycle (lib/trial). UNRESTRICTED = paid / legacy company with no
  // limits. TRIAL -> READ_ONLY (day 45, 30 days) -> ARCHIVED. HELD = waiting on
  // Super_Admin review, DECLINED = sign-up refused. Every legacy row defaults to
  // UNRESTRICTED so existing companies are unaffected.
  trialStatus        String    @default("UNRESTRICTED") @db.VarChar(20)
  trialStartsAt      DateTime?
  trialEndsAt        DateTime?
  readOnlyEndsAt     DateTime?
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  // Limits profile key ("standard" | "tight") resolved by lib/trial/limits.ts.
  trialLimitsProfile String?   @db.VarChar(20)
  trialExtraDays     Int       @default(0)

  trialUsage         TrialUsageCounter[]
  trialSignals       TrialSignal[]
  trialReviews       TrialReview[]
  signupVerification SignupVerification?

  // Offer letter / employer details (populated onto the offer letter template).
  // Every company-specific value comes from here so the shared template stays generic.
  secondedCompany       String? // client org a hire may be seconded to
  hrRepName             String? // HR representative who signs the letter
  hrRepTitle            String? // e.g. "HRBP"
  communicationTool     String? // official comms tool, e.g. "Lark"
  governingLaw          String? @default("Laws of the Federal Republic of Nigeria")
  arbitrationVenue      String? @default("Lagos")
  // Days a candidate has to accept + return the signed offer letter before the
  // offer lapses. Per-company (multi-tenant); null falls back to the 14-day default.
  offerResponseDays     Int?
  // Reusable company-wide offer approval workflow (set once, applied to every new
  // offer). Shape: { mode: 'sequential'|'parallel', steps: [{ order, approverId,
  // approverName, approverRole }] }. Null = no default flow (approvers assigned ad-hoc).
  offerApprovalWorkflow Json?

  // Secret token for the public job-board distribution feed (lib/recruitment/job-feed.ts) —
  // lets LinkedIn/Jobberman/Indeed/etc. pull this company's active jobs without exposing a
  // guessable public URL. Lazily generated on first feed request if null.
  jobFeedToken String?

  // Offer letter signature — uploaded by HR/Admin in Offer Letter Settings.
  // Rendered below the body in generated offer letters.
  signatureImage    String? @db.Text // base64 or URL of uploaded signature image
  signatoryName     String? // e.g. "John Okafor"
  signatoryPosition String? // e.g. "HR Manager" or "CEO"

  // Company handbook — PDF shown to candidates during pre-offer onboarding.
  // Stored on disk (public/company/<id>/handbook/...), not base64 (too large).
  handbookPath      String?
  handbookFileName  String?
  handbookUpdatedAt DateTime?

  // Locations
  locations Location[]

  // Offer letter templates
  offerTemplates OfferTemplate[]

  // Offer Letter module (standalone)
  offerLetterTemplates       OfferLetterTemplate[]
  generatedOfferLetters      GeneratedOfferLetter[]
  offerLetterBulkJobs        OfferLetterBulkJob[]
  offerLetterEmailTemplates  OfferLetterEmailTemplate[]
  offerLetterEmails          OfferLetterEmail[]
  offerLetterMailboxMessages OfferLetterMailboxMessage[]
  offerLetterMailConfig      OfferLetterMailConfig?

  // AI & Settings
  aiSettings  AISettings?
  aiUsageLogs AIUsageLog[]

  // AI Assistant
  aiAssistantSettings   AiAssistantSettings?
  aiConversations       AiConversation[]
  aiProposals           AiProposal[]
  customAutomationRules CustomAutomationRule[]

  // Attendance
  attendances Attendance[]

  // Recruitment
  assessmentPlans       RecruitmentAssessmentPlan[]
  onboardingTemplates   OnboardingTemplate[]
  candidateAssessments  RecruitmentCandidateAssessment[]
  candidateDocuments    CandidateDocument[]
  candidateFiles        CandidateFile[]
  candidates            Candidate[]
  interviews            Interview[]
  applications          JobApplication[]
  jobs                  Job[]
  offers                Offer[]
  onboardings           Onboarding[]
  meetings              Meeting[]
  jobBoardDeliveryLogs  JobBoardDeliveryLog[]
  recruitmentPageAccess RecruitmentPageAccess[]
  companyDisabledPfas   CompanyDisabledPfa[]

  // Leave Management
  leave_blackout_periods leave_blackout_periods[]
  leavePolicies          LeavePolicy[]
  leave_uploads          leave_uploads[]
  leaveRequests          LeaveRequest[]
  publicHolidays         PublicHoliday[]

  // Payroll
  payrollUploads           PayrollUpload[]
  payrolls                 Payroll[]
  payslips                 Payslip[]
  payslipBulkSends         PayslipBulkSend[]
  payrollTemplates         PayrollTemplate[]
  payslipPresets           PayslipPreset[]
  guidedSetupState         GuidedSetupState?
  payrollData              PayrollData[]
  payrollTemplateUploads   PayrollTemplateUpload[]
  staffPayrollProfiles     StaffPayrollProfile[]
  payrollGenerationRuns    PayrollGenerationRun[]
  staffCompensationUploads StaffCompensationUpload[]

  // Company Export
  companyExportJobs CompanyExportJob[]

  // Tax
  employeeTaxProfiles EmployeeTaxProfile[]
  taxFilingSchedules  TaxFilingSchedule[]
  annualReturns       AnnualReturn[]
  taxProfileUploads   TaxProfileUpload[]

  // Exchange Rates
  exchangeRates CompanyExchangeRate[]

  // Pay Dates
  companyPayDates CompanyPayDate[]

  // Payroll Engine
  payPeriods       PayPeriod[]
  employeeSalaries EmployeeSalary[]
  payValidations   PayValidation[]
  overtimeEntries  OvertimeEntry[]
  deductionEntries DeductionEntry[]
  computedPayslips ComputedPayslip[]

  // Staff & Users
  staff         StaffRecord[]
  staffUploads  StaffUpload[]
  userCompanies UserCompany[]

  // Notifications & Logs
  notifications     Notification[]
  emailLogs         EmailLog[]
  staffActivityLogs StaffActivityLog[]

  // Department Relations
  departments              Department[]
  departmentAuditLogs      DepartmentAuditLog[]
  departmentStaffHistories DepartmentStaffHistory[]

  // Business Unit Relations
  businessUnits BusinessUnit[]

  // Temporary role elevations granted within this company
  roleElevations RoleElevation[]

  // Staff Loans & Benefits
  loanPolicies            LoanPolicy[]
  loanRequests            LoanRequest[]             @relation("CompanyLoanRequests")
  benefitPolicies         BenefitPolicy[]
  benefitRequests         BenefitRequest[]          @relation("CompanyBenefitRequests")
  benefitAllocations      BenefitAllocation[]       @relation("CompanyBenefitAllocations")
  benefitClaims           BenefitClaim[]
  loansBenefitsPageAccess LoansBenefitsPageAccess[]

  // Performance and Appraisal
  competencies                Competency[]
  proficiencyScales           ProficiencyScale[]
  reviewTemplates             ReviewTemplate[]
  questionBankItems           QuestionBankItem[]
  appraisalCycles             AppraisalCycle[]
  appraisalWorkflowSettings   AppraisalWorkflowSettings?
  appraisalSettingsHistory    AppraisalSettingsHistory[]
  goals                       Goal[]
  orgObjectives               OrgObjective[]
  kpis                        Kpi[]
  goalConflicts               GoalConflict[]
  goalActivities              GoalActivity[]
  goalAiAnalyses              GoalAiAnalysis[]
  staffWorkloadCapacities     StaffWorkloadCapacity[]
  selfAppraisals              SelfAppraisal[]
  managerReviews              ManagerReview[]
  appraisalEscalations        AppraisalEscalation[]
  performanceOpsNotes         PerformanceOpsNote[]
  performanceActions          PerformanceAction[]
  appraisalBulkOperations     AppraisalBulkOperation[]
  appraisalPolicyExceptions   AppraisalPolicyException[]
  calibrationRecords          CalibrationRecord[]
  calibrationSessions         CalibrationSession[]
  feedbacks                   Feedback[]
  recognitions                Recognition[]
  feedbackRequests            FeedbackRequest[]
  developmentPlans            DevelopmentPlan[]
  developmentCoachingRequests DevelopmentCoachingRequest[]
  pips                        Pip[]
  promotionRecommendations    PromotionRecommendation[]
  careerAssignments           CareerDevelopmentAssignment[]
  careerHistories             StaffCareerHistory[]
  criticalRoles               CriticalRole[]
  successionCandidates        SuccessionCandidate[]
  comparisonReports           ComparisonReport[]
  performanceAuditEvents      PerformanceAuditEvent[]
  auditInvestigationCases     AuditInvestigationCase[]
  auditAnomalies              AuditAnomaly[]
  auditExportJobs             AuditExportJob[]
  auditComplianceSnapshots    AuditComplianceSnapshot[]
  successionSnapshots         SuccessionMetricSnapshot[]
  successionReports           SuccessionReport[]
  intelligenceSettings        IntelligenceSettings?
  intelligenceReports         IntelligenceReport[]
  automationRules             AutomationRule[]
  automationNotifications     AutomationNotification[]
  automationEvents            AutomationEvent[]
  automationExecutorTicks     AutomationExecutorTick[]
  fairnessSignals             FairnessSignal[]
  fairnessDetectionRuns       FairnessDetectionRun[]
  fairnessMetricSnapshots     FairnessMetricSnapshot[]
  fairnessCases               FairnessCase[]
  fairnessReports             FairnessReport[]

  // PHED Module relations
  phedGrades               PhedGrade[]
  phedRegions              PhedRegion[]
  phedFeeders              PhedFeeder[]
  phedPayPoints            PhedPayPoint[]
  phedUnions               PhedUnion[]
  phedCooperatives         PhedCooperative[]
  phedDeductionLiabilities PhedDeductionLiability[]
  phedStaff                PhedStaff[]
  phedPayPeriods           PhedPayPeriod[]
  phedValidations          PhedValidation[]
  phedOvertimeEntries      PhedOvertimeEntry[]
  phedComputedPayrolls     PhedComputedPayroll[]
  phedBulkUploads          PhedBulkUpload[]
  phedPeriodAdvances       PhedStaffPeriodAdvance[]
  phedStaffAccessRoles     PhedStaffAccessRole[]
  phedApprovalMemos        PhedApprovalMemo[]
  phedAccessRoleChanges    PhedAccessRoleChange[]
  phedRoleAccessGrants     PhedRoleAccessGrant[]
  phedChangeLogs           PhedChangeLog[]
  phedStaffExits           PhedStaffExit[]

  // Training & Certification Module relations
  trainingPrograms       TrainingProgram[]
  trainingSessions       TrainingSession[]
  trainingMaterials      TrainingMaterial[]
  assessments            Assessment[]
  assessmentAttempts     AssessmentAttempt[]
  participantProgress    ParticipantProgress[]
  certificationTypes     CertificationType[]
  certificationTemplates CertificationTemplate[]
  certificationRecords   CertificationRecord[]
  assignmentRules        AssignmentRule[]
  riskItems              RiskItem[]
  trainingAuditLogs      TrainingAuditLog[]
  moduleAccess           CompanyModuleAccess[]

  designations Designation[] // opposite of Designation.company

  // Benefits
  benefits Benefit[] // opposite of Benefit.company

  // Company Salary Formulas
  companySalaryFormulas CompanySalaryFormula[] // opposite of CompanySalaryFormula.company

  offboardings Offboarding[]

  // PHED bulk promotion / salary-increase letters
  phedLetterTemplates   PhedLetterTemplate[]
  phedLetterRuns        PhedLetterRun[]
  phedLetterRunRows     PhedLetterRunRow[]
  phedLetterAuditEvents PhedLetterAuditEvent[]

  // Core Setup intelligence (Action Center, Automation Center, Activity Log)
  automationRuleSettings AutomationRuleSetting[]
  actionItemDecisions    ActionItemDecision[]
  automationRuns         AutomationRun[]
  coreSetupAuditEvents   CoreSetupAuditEvent[]

  @@map("companies")
}

model Location {
  id        String   @id @default(cuid())
  companyId String
  name      String
  code      String?
  type      String?
  country   String? // e.g. Nigeria, United Kingdom (defaults to Nigeria for legacy rows)
  state     String? // level 1: State (NG) / Nation (UK) / State-Province (other)
  lga       String? // level 2: LGA (NG) / County (UK) / City (other)
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company               Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff                 StaffRecord[]
  appraisalParticipants AppraisalCycleParticipant[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("locations")
}

// Sidebar section that groups modules in the navigation shell.
// Seeded with the app's default sections; super admins can add custom ones.
model NavSection {
  id        String   @id @default(cuid())
  label     String
  // null label = the unlabelled main section at the top of the sidebar.
  sortOrder Int      @default(0)
  // System sections (Workforce/Operations/More/main) cannot be deleted.
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules PlatformModule[]

  @@map("nav_sections")
}

model PlatformModule {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  // Soft-archive: archived modules stay registered (visible in Module Setup
  // with an "archived" state) but are hidden from the sidebar nav-config and
  // treated as disabled for every company until re-registered (un-archived).
  archived Boolean @default(false)

  // --- Sidebar placement (nullable = falls back to hardcoded defaults) ---
  // Which NavSection this module renders under in the sidebar.
  navSectionId String?
  // Display order within its section (lower first).
  navOrder     Int     @default(0)
  // Optional sidebar label override (falls back to `name`).
  navLabel     String?
  // Optional lucide icon key override (falls back to the module default).
  navIcon      String?

  navSection    NavSection?           @relation(fields: [navSectionId], references: [id], onDelete: SetNull)
  companyAccess CompanyModuleAccess[]

  @@map("platform_modules")
}

model CompanyModuleAccess {
  id        String   @id @default(cuid())
  companyId String
  moduleId  String
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module  PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([companyId, moduleId])
  @@map("company_module_access")
}

model DemoRequest {
  id               String    @id @default(cuid())
  firstName        String
  lastName         String
  workEmail        String
  phone            String
  companyName      String
  jobTitle         String
  companySize      String
  modules          Json
  currentHRSystem  String
  message          String?
  status           String    @default("NOT_CONTACTED")
  outcomeNote      String?
  outcomeUpdatedBy String?
  outcomeUpdatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([workEmail])
  @@map("demo_requests")
}

model CompanyExchangeRate {
  id            String    @id @default(cuid())
  companyId     String
  baseCurrency  String    @db.VarChar(3)
  quoteCurrency String    @db.VarChar(3)
  rate          Decimal   @db.Decimal(20, 8)
  source        String?   @default("MANUAL")
  fetchedAt     DateTime?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, baseCurrency, quoteCurrency])
  @@index([companyId, updatedAt])
  @@index([companyId, baseCurrency])
  @@map("company_exchange_rates")
}

model StaffRecord {
  id                       String    @id @default(cuid())
  staffId                  String
  email                    String
  firstName                String
  lastName                 String
  department               String?
  departmentId             String?
  position                 String
  phone                    String?
  hireDate                 DateTime?
  bankName                 String?
  accountNumber            String?
  bvn                      String?
  rsaPin                   String?
  pfaCode                  String?
  pensionContributionType  String?
  pensionEmployerCode      String?
  voluntaryPensionEmployee Decimal?  @db.Decimal(18, 2)
  voluntaryPensionEmployer Decimal?  @db.Decimal(18, 2)
  otherPensionContribution Decimal?  @db.Decimal(18, 2)
  password                 String?
  isRegistered             Boolean   @default(false)
  requirePasswordChange    Boolean   @default(false)
  role                     String    @default("STAFF")
  isActive                 Boolean   @default(true)
  companyId                String
  createdBy                String
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  encodedId                String?
  updatedBy                String?
  managerId                String?
  avatarUrl                String?
  location                 String?
  locationId               String?

  // Device Management — blocking
  isBlocked     Boolean   @default(false)
  blockedAt     DateTime?
  blockedById   String?
  blockedByName String?
  blockedByRole String? // 'SUPER_ADMIN' | 'ADMIN' | 'HR' — drives who may unblock
  blockReason   String?

  // NSITF Employees' Schedule of Payments identity fields — all optional,
  // never enforced; captured so the NSITF filing sheet can be produced
  // without a separate one-off data collection exercise.
  middleName                String?
  gender                    String? // 'Male' | 'Female'
  dateOfBirth               DateTime?
  maritalStatus             String? // 'Married' | 'Single' | 'Divorced' | 'Others'
  stateOfOrigin             String?
  lgaOfOrigin               String?
  townOfOrigin              String?
  alternatePhone            String?
  nin                       String? // MEANS_OF_IDENTIFICATION_NUMBER; the means itself is always "NIN" on the NSITF sheet, never stored
  stateOfIssuance           String?
  residentialAddress        String?
  numberOfPrimaryDependants Int?

  // Relations with matching relation names
  attendances                     Attendance[]
  leaveRequestsToApproveAsManager LeaveRequest[]          @relation("LeaveRequestManagerApprover")
  leaveRequests                   LeaveRequest[]          @relation("LeaveRequestStaff")
  leaveRequestsAsHandover         LeaveRequest[]          @relation("LeaveRequestHandover")
  departmentLineManagerRoles      DepartmentLineManager[] @relation("StaffDepartmentLineManager")
  leaveApprovalSteps              LeaveApprovalStep[]     @relation("LeaveApprovalStepApprover")
  onboardings                     Onboarding[]
  payrolls                        Payroll[]
  payslips                        Payslip[]
  leaveBalances                   StaffLeaveBalance[]
  company                         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager                         StaffRecord?            @relation("StaffManagers", fields: [managerId], references: [id])
  directReports                   StaffRecord[]           @relation("StaffManagers")
  userCompanies                   UserCompany[]
  notifications                   Notification[]
  emailLogs                       EmailLog[]
  payrollData                     PayrollData[]
  payrollProfile                  StaffPayrollProfile?
  taxProfile                      EmployeeTaxProfile?

  // Department relations
  departments               Department?              @relation(fields: [departmentId], references: [id])
  headOfDepartment          Department[]             @relation("DepartmentHead")
  assistantHeadOfDepartment Department[]             @relation("DepartmentAssistantHead")
  departmentStaffHistories  DepartmentStaffHistory[]

  // Business Unit relations (as head / assistant head)
  headOfBusinessUnit          BusinessUnit[] @relation("BusinessUnitHead")
  assistantHeadOfBusinessUnit BusinessUnit[] @relation("BusinessUnitAssistantHead")

  // Temporary role elevations granted to this staff member
  roleElevations RoleElevation[] @relation("StaffRoleElevations")

  // Location relation (legacy `location` string retained for back-compat)
  locationRecord Location? @relation(fields: [locationId], references: [id])

  // Payroll Engine relations
  employeeSalaries           EmployeeSalary[]
  payValidationsAsStaff      PayValidation[]   @relation("PayValidationStaff")
  payValidationsAsSupervisor PayValidation[]   @relation("PayValidationSupervisor")
  overtimeEntries            OvertimeEntry[]
  deductionEntries           DeductionEntry[]
  computedPayslips           ComputedPayslip[]

  // Training & Certification Module relations
  assessmentAttempts   AssessmentAttempt[]
  participantProgress  ParticipantProgress[]
  certificationRecords CertificationRecord[]
  trainingAuditLogs    TrainingAuditLog[]

  // Staff Loans & Benefits
  loanRequests                  LoanRequest[]       @relation("StaffLoanRequests")
  loanRequestsAsGuarantor       LoanRequest[]       @relation("LoanGuarantor")
  benefitRequests               BenefitRequest[]    @relation("StaffBenefitRequests")
  benefitAllocations            BenefitAllocation[] @relation("StaffBenefitAllocations")
  benefitAllocationsAsAllocator BenefitAllocation[] @relation("BenefitAllocator")
  benefitClaims                 BenefitClaim[]

  // Performance and appraisal relations
  competenciesOwned             Competency[]                    @relation("CompetencyOwner")
  competencyHistory             CompetencyHistory[]             @relation("CompetencyHistoryActor")
  ownedReviewTemplates          ReviewTemplate[]                @relation("ReviewTemplateOwner")
  reviewTemplateHistoryActions  TemplateHistory[]               @relation("ReviewTemplateHistoryActor")
  ownedAppraisalCycles          AppraisalCycle[]                @relation("AppraisalCycleOwner")
  appraisalCycleHistoryActions  AppraisalCycleHistory[]         @relation("AppraisalCycleHistoryActor")
  appraisalParticipations       AppraisalCycleParticipant[]     @relation("AppraisalParticipantStaff")
  appraisalPeerReviews          AppraisalPeerAssignment[]       @relation("AppraisalPeerReviewer")
  appraisalSettingsActions      AppraisalSettingsHistory[]      @relation("AppraisalSettingsActor")
  ownedGoals                    Goal[]                          @relation("GoalOwner")
  goalProgressActions           GoalProgressUpdate[]            @relation("GoalProgressActor")
  goalEvidenceUploads           GoalEvidence[]                  @relation("GoalEvidenceUploader")
  goalHistoryActions            GoalHistory[]                   @relation("GoalHistoryActor")
  goalCommentsAuthored          GoalComment[]                   @relation("GoalCommentAuthor")
  assignedGoals                 Goal[]                          @relation("GoalAssignee")
  goalsAssignedByMe             Goal[]                          @relation("GoalAssigner")
  ownedOrgObjectives            OrgObjective[]                  @relation("OrgObjectiveOwner")
  ownedKpis                     Kpi[]                           @relation("KpiOwner")
  goalConflictsAsAssignee       GoalConflict[]                  @relation("GoalConflictAssignee")
  goalConflictsResolved         GoalConflict[]                  @relation("GoalConflictResolver")
  goalActivitiesAuthored        GoalActivity[]                  @relation("GoalActivityAuthor")
  workloadCapacity              StaffWorkloadCapacity?          @relation("StaffWorkloadCapacityOwner")
  competencyReviewsAssigned     CompetencyReview[]              @relation("CompetencyReviewAssignee")
  competencyReviewsScheduled    CompetencyReview[]              @relation("CompetencyReviewScheduler")
  competencyReviewsCompleted    CompetencyReview[]              @relation("CompetencyReviewCompleter")
  competencyDuplicatesDismissed CompetencyDuplicateDismissal[]  @relation("DuplicateDismissedBy")
  selfAppraisals                SelfAppraisal[]                 @relation("SelfAppraisalOwner")
  selfAppraisalEvidence         SelfAppraisalEvidence[]         @relation("SelfAppraisalEvidenceUploader")
  selfAppraisalHistory          SelfAppraisalHistory[]          @relation("SelfAppraisalHistoryActor")
  managerReviewsAsSubject       ManagerReview[]                 @relation("ManagerReviewSubject")
  managerReviewsAsReviewer      ManagerReview[]                 @relation("ManagerReviewReviewer")
  managerReviewHistory          ManagerReviewHistory[]          @relation("ManagerReviewHistoryActor")
  escalationsAssigned           AppraisalEscalation[]           @relation("EscalationAssignee")
  escalationsRaised             AppraisalEscalation[]           @relation("EscalationRaiser")
  escalationsResolved           AppraisalEscalation[]           @relation("EscalationResolver")
  escalationHistoryActions      AppraisalEscalationHistory[]    @relation("EscalationHistoryActor")
  opsNotesAuthored              PerformanceOpsNote[]            @relation("OpsNoteAuthor")
  performanceActionsAsSubject   PerformanceAction[]             @relation("PerformanceActionSubject")
  performanceActionsCreated     PerformanceAction[]             @relation("PerformanceActionCreator")
  performanceActionAttachments  PerformanceActionAttachment[]   @relation("PerformanceActionAttachmentUploader")
  performanceActionHistory      PerformanceActionHistory[]      @relation("PerformanceActionHistoryActor")
  bulkOperationsPerformed       AppraisalBulkOperation[]        @relation("BulkOperationPerformer")
  policyExceptionsRequested     AppraisalPolicyException[]      @relation("PolicyExceptionRequester")
  policyExceptionsDecided       AppraisalPolicyException[]      @relation("PolicyExceptionDecider")
  calibrationRecords            CalibrationRecord[]             @relation("CalibrationSubject")
  managedParticipants           AppraisalCycleParticipant[]     @relation("AppraisalParticipantManager")
  calibrationSessionsCreated    CalibrationSession[]            @relation("CalibrationSessionCreator")
  calibrationAttendances        CalibrationSessionAttendee[]    @relation("CalibrationSessionAttendee")
  calibrationHistoryActions     CalibrationHistory[]            @relation("CalibrationHistoryActor")
  feedbackAuthored              Feedback[]                      @relation("FeedbackAuthor")
  feedbackReceived              Feedback[]                      @relation("FeedbackRecipient")
  feedbackLikes                 FeedbackLike[]                  @relation("FeedbackLiker")
  feedbackBookmarks             FeedbackBookmark[]              @relation("FeedbackBookmarker")
  feedbackComments              FeedbackComment[]               @relation("FeedbackCommenter")
  feedbackReports               FeedbackReport[]                @relation("FeedbackReporter")
  recognitionsGiven             Recognition[]                   @relation("RecognitionGiver")
  recognitionsReceived          Recognition[]                   @relation("RecognitionRecipient")
  feedbackRequestsMade          FeedbackRequest[]               @relation("FeedbackRequester")
  feedbackRequestsReceived      FeedbackRequest[]               @relation("FeedbackReviewer")
  feedbackHistoryActions        FeedbackHistory[]               @relation("FeedbackHistoryActor")
  recognitionReactions          RecognitionReaction[]           @relation("RecognitionReactor")
  developmentPlans              DevelopmentPlan[]               @relation("DevelopmentPlanOwner")
  developmentPlansMentored      DevelopmentPlan[]               @relation("DevelopmentPlanMentor")
  developmentPlansCreated       DevelopmentPlan[]               @relation("DevelopmentPlanCreator")
  developmentEvidenceUploads    DevelopmentPlanEvidence[]       @relation("DevelopmentEvidenceUploader")
  coachingRequestsMade          DevelopmentCoachingRequest[]    @relation("CoachingRequester")
  coachingRequestsAsCoach       DevelopmentCoachingRequest[]    @relation("CoachingCoach")
  coachingRequestsResponded     DevelopmentCoachingRequest[]    @relation("CoachingResponder")
  developmentHistoryActions     DevelopmentPlanHistory[]        @relation("DevelopmentHistoryActor")
  pipsAsSubject                 Pip[]                           @relation("PipSubject")
  pipsAsManager                 Pip[]                           @relation("PipManager")
  pipsCreated                   Pip[]                           @relation("PipCreator")
  pipHistoryActed               PipHistory[]                    @relation("PipHistoryActor")
  pipSessionsCreated            PipCoachingSession[]            @relation("PipSessionCreator")
  pipActionItemsCreated         PipActionItem[]                 @relation("PipActionItemCreator")
  escalationCommentsAuthored    AppraisalEscalationComment[]    @relation("EscalationCommentAuthor")
  escalationAttachmentUploads   AppraisalEscalationAttachment[] @relation("EscalationAttachmentUploader")
  pipSupportRequests            PipSupportRequest[]             @relation("PipSupportRequester")
  promotionsAsSubject           PromotionRecommendation[]       @relation("PromotionSubject")
  promotionsCreated             PromotionRecommendation[]       @relation("PromotionCreator")
  promotionsDecided             PromotionRecommendation[]       @relation("PromotionDecider")
  promotionAttachmentUploads    PromotionAttachment[]           @relation("PromotionAttachmentUploader")
  promotionHistoryActed         PromotionHistory[]              @relation("PromotionHistoryActor")
  careerAssignmentsAsSubject    CareerDevelopmentAssignment[]   @relation("CareerAssignmentSubject")
  careerAssignmentsGiven        CareerDevelopmentAssignment[]   @relation("CareerAssignmentAssigner")
  criticalRolesCreated          CriticalRole[]                  @relation("CriticalRoleCreator")
  successionCandidacies         SuccessionCandidate[]           @relation("SuccessionSubject")
  successionNominations         SuccessionCandidate[]           @relation("SuccessionNominator")
  successionHistoryActed        SuccessionHistory[]             @relation("SuccessionHistoryActor")
  pipEvidenceUploaded           PipEvidence[]                   @relation("PipEvidenceUploader")
  pipProgressDrafts             PipProgressDraft[]              @relation("PipProgressDraftOwner")
  comparisonReportsCreated      ComparisonReport[]              @relation("ComparisonReportCreator")
  comparisonReportHistoryActed  ComparisonReportHistory[]       @relation("ComparisonReportHistoryActor")
  auditEventsActed              PerformanceAuditEvent[]         @relation("PerfAuditEventActor")
  auditEventsResolved           PerformanceAuditEvent[]         @relation("PerfAuditEventResolver")
  auditCasesAssigned            AuditInvestigationCase[]        @relation("AuditCaseAssignee")
  auditCasesOpened              AuditInvestigationCase[]        @relation("AuditCaseOpener")
  auditCaseNotesAuthored        AuditInvestigationCaseNote[]    @relation("AuditCaseNoteAuthor")
  auditAnomaliesAffected        AuditAnomaly[]                  @relation("AuditAnomalySubject")
  auditExportsRequested         AuditExportJob[]                @relation("AuditExportRequester")
  successionReportsCreated      SuccessionReport[]              @relation("SuccessionReportCreator")
  successionReportHistoryActed  SuccessionReportHistory[]       @relation("SuccessionReportHistoryActor")
  intelligenceSettingsUpdated   IntelligenceSettings[]          @relation("IntelligenceSettingsUpdater")
  intelligenceSettingsActions   IntelligenceSettingsHistory[]   @relation("IntelligenceSettingsActor")
  intelligenceReportsCreated    IntelligenceReport[]            @relation("IntelligenceReportCreator")
  intelligenceSharesCreated     IntelligenceReportShare[]       @relation("IntelligenceShareCreator")
  intelligenceSharesRevoked     IntelligenceReportShare[]       @relation("IntelligenceShareRevoker")
  intelligenceReportEvents      IntelligenceReportEvent[]       @relation("IntelligenceReportActor")
  automationRulesCreated        AutomationRule[]                @relation("AutomationRuleCreator")
  automationRulesUpdated        AutomationRule[]                @relation("AutomationRuleUpdater")
  automationRunTargets          AutomationRuleRun[]             @relation("AutomationRunTarget")
  automationHistory             AutomationHistory[]             @relation("AutomationHistoryActor")
  fairnessSignalsAsManager      FairnessSignal[]                @relation("FairnessSignalManager")
  fairnessCasesAsManager        FairnessCase[]                  @relation("FairnessCaseManager")
  fairnessCasesAssigned         FairnessCase[]                  @relation("FairnessCaseAssignee")
  fairnessCasesEscalatedTo      FairnessCase[]                  @relation("FairnessCaseEscalatee")

  // Designation relation
  designationId String?
  designation   Designation?         @relation(fields: [designationId], references: [id])
  careerHistory StaffCareerHistory[]

  // PHED Approval Workflow / Access Matrix (Module 12 & 13) — independent of `role` above
  phedAccessRole        PhedStaffAccessRole?
  phedAccessRoleChanges PhedAccessRoleChange[] @relation("PhedAccessRoleChangeTarget")
  offboardings          Offboarding[]          @relation("StaffOffboardings")
  reviewedOffboardings  Offboarding[]          @relation("OffboardingReviewer")

  // Device Management
  devices      Device[]
  activityLogs StaffActivityLog[] @relation("StaffActivityLogSubject")

  @@unique([staffId, companyId])
  @@unique([email, companyId])
  @@index([email])
  @@index([locationId])
  @@map("staff_records")
}

// One row per registered device "slot" for a staff member (max 3, enforced in
// application code, not a DB constraint). Doubles as the session record — the
// JWT carries this row's id as `deviceId`, so there is no separate session table.
model Device {
  id            String @id @default(cuid())
  staffRecordId String

  deviceKey  String // client-persisted UUID sent as X-Device-Id — identity, not the JWT claim
  deviceName String // derived from User-Agent, e.g. "Chrome on Windows"
  deviceType String // 'DESKTOP' | 'MOBILE' | 'TABLET' | 'OTHER'
  ipAddress  String
  userAgent  String?

  isActive     Boolean  @default(true)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  revokedAt     DateTime?
  revokedById   String?
  revokedByRole String?
  revokedReason String? // 'SELF_CLEARED' | 'ADMIN_CLEARED' | 'BLOCKED' | 'LOGOUT' | 'EVICTED'

  // Device history — set when the device is evicted to make room for a 4th
  // device (login flow), so the account keeps a record of every device it
  // has ever used. null = occupies a live slot; non-null = past device.
  archivedAt DateTime?

  staffRecord StaffRecord @relation(fields: [staffRecordId], references: [id], onDelete: Cascade)

  @@unique([staffRecordId, deviceKey])
  @@index([staffRecordId, isActive])
  @@index([staffRecordId, archivedAt])
  @@map("devices")
}

// Generic staff-scoped activity/audit log, purpose-built for Device
// Management (login, device, block/unblock events). Written inline from
// each route handler, wrapped in try/catch — a logging failure must never
// block the parent action (same convention as reconcileStaffDepartmentLink).
model StaffActivityLog {
  id            String @id @default(cuid())
  staffRecordId String // subject — whose record this event is about
  companyId     String // subject's company, for company-scoped listing by HR/ADMIN

  action String // LOGIN_SUCCESS | LOGIN_BLOCKED_ATTEMPT | DEVICE_REGISTERED |
  // DEVICE_EVICTED | DEVICE_CLEARED | LOGOUT | STAFF_BLOCKED | STAFF_UNBLOCKED

  performedById   String // actor; equals staffRecordId for self-service actions
  performedByName String
  performedByRole String
  details         Json?
  createdAt       DateTime @default(now())

  staffRecord StaffRecord @relation("StaffActivityLogSubject", fields: [staffRecordId], references: [id], onDelete: Cascade)
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([staffRecordId, createdAt])
  @@index([companyId, createdAt])
  @@map("staff_activity_logs")
}

// Audit trail for cross-company staff transfers — one row per transfer,
// recording what moved and what was reset so it's forensically
// reconstructable later. No enforced relation to StaffRecord (mirrors the
// free-text-actor-ID style already used by RoleElevation.grantedBy/revokedBy)
// since this is a pure audit log, not something that should cascade.
model StaffCompanyTransfer {
  id                    String   @id @default(cuid())
  staffRecordId         String
  fromCompanyId         String
  toCompanyId           String
  transferredBy         String
  transferredAt         DateTime @default(now())
  reason                String?
  previousDepartmentId  String?
  previousDesignationId String?
  previousLocationId    String?
  previousManagerId     String?
  newDepartmentId       String?
  newDesignationId      String?
  newLocationId         String?
  recordCounts          Json

  @@index([staffRecordId])
  @@index([fromCompanyId])
  @@index([toCompanyId])
  @@map("staff_company_transfers")
}

// Compliance/audit snapshot written whenever a staff member is permanently
// deleted (see lib/staff/deleteStaffPermanently.ts). Payroll, payslip, and
// tax profile figures are captured here BEFORE the delete, since those live
// rows are destroyed by StaffRecord's own cascade rules along with
// everything else. No enforced relation to StaffRecord, same reasoning as
// StaffCompanyTransfer above — this row must outlive the record it describes.
model StaffDeletionRecord {
  id            String   @id @default(cuid())
  staffRecordId String
  companyId     String
  staffId       String
  fullName      String
  email         String
  deletedBy     String
  deletedAt     DateTime @default(now())
  reason        String?
  preservedData Json

  @@index([companyId])
  @@index([staffId])
  @@map("staff_deletion_records")
}

model Payroll {
  id                      String   @id @default(cuid())
  companyId               String
  staffRecordId           String
  month                   String
  year                    Int
  grossPay                Decimal? @db.Decimal(18, 2)
  basicSalary             Decimal? @db.Decimal(18, 2)
  housing                 Decimal? @db.Decimal(18, 2)
  transport               Decimal? @db.Decimal(18, 2)
  dressing                Decimal? @db.Decimal(18, 2)
  leaveAllowance          Decimal? @db.Decimal(18, 2)
  entertainment           Decimal? @db.Decimal(18, 2)
  utility                 Decimal? @db.Decimal(18, 2)
  otherAllowance          Decimal? @db.Decimal(18, 2)
  proratedGrossPay        Decimal? @db.Decimal(18, 2)
  proratedGrossWithExtra  Decimal? @db.Decimal(18, 2)
  annualPension           Decimal? @db.Decimal(18, 2)
  annualGrossPay          Decimal? @db.Decimal(18, 2)
  consolidatedRelief      Decimal? @db.Decimal(18, 2)
  taxableIncome           Decimal? @db.Decimal(18, 2)
  deductions              Decimal? @db.Decimal(18, 2)
  payee                   Decimal? @db.Decimal(18, 2)
  pensionDeduction        Decimal? @db.Decimal(18, 2)
  bonusKPI                Decimal? @db.Decimal(18, 2)
  netSalary               Decimal? @db.Decimal(18, 2)
  finalGross              Decimal? @db.Decimal(18, 2)
  medicalContribution     Decimal? @db.Decimal(18, 2)
  employerPension         Decimal? @db.Decimal(18, 2)
  nsitf                   Decimal? @db.Decimal(18, 2)
  itf                     Decimal? @db.Decimal(18, 2)
  nhf                     Decimal? @db.Decimal(18, 2)
  proratedSubTotal        Decimal? @db.Decimal(18, 2)
  managementFee           Decimal? @db.Decimal(18, 2)
  vatOnManagementFee      Decimal? @db.Decimal(18, 2)
  totalInvoiceValue       Decimal? @db.Decimal(18, 2)
  overtimeIncome          Decimal? @db.Decimal(18, 2)
  communicationAllowance  Decimal? @db.Decimal(18, 2)
  transportationAllowance Decimal? @db.Decimal(18, 2)
  outstandingIncome       Decimal? @db.Decimal(18, 2)

  // NEW FIELDS - Add these
  walletPayment     Decimal? @db.Decimal(18, 2) // Maps to "Pay OPay"
  commercialPayment Decimal? @db.Decimal(18, 2) // Maps to "Bank Payment"
  customFields      Json?
  templateId        String? // Reference to the dynamic template used

  // Pension identity snapshot — captures what StaffRecord.rsaPin/pfaCode/
  // pensionEmployerCode held AT THE MOMENT this payroll row was created, since
  // StaffRecord itself is never versioned. Powers the Pension Schedule
  // compliance history/gap-detection report (as-of-then values, not current).
  // pensionSnapshotAt is set (non-null) only on rows created after this
  // feature shipped — its presence, not the snapshot fields themselves being
  // null, is what distinguishes "tracked, but blank at the time" from
  // "pre-dates this feature, never tracked" (both leave the 3 fields above as
  // null, so they alone can't tell the two apart).
  pensionRsaPinSnapshot       String?
  pensionPfaCodeSnapshot      String?
  pensionEmployerCodeSnapshot String?
  pensionSnapshotAt           DateTime?

  // Payroll history linkage (additive) — set by the upload processors to the
  // PayrollUpload row that created/updated this record, so per-upload reports
  // (e.g. the Bank Schedule) can scope to exactly one upload. Null for
  // generation-flow rows and anything uploaded before this field existed
  // (those fall back to the upload's time window).
  payrollUploadId String?

  status        String           @default("PROCESSED")
  templateType  String?          @default("ISURF_STANDARD")
  // Payroll Generation (additive) — 'UPLOAD' for every existing row and every
  // row the untouched manual upload path continues to create; 'GENERATED'
  // only for rows finalized by the new Payroll Generation flow. Audit/
  // traceability only — doesn't change how any existing code reads a row.
  source        String           @default("UPLOAD")
  uploadedBy    String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staffRecord   StaffRecord      @relation(fields: [staffRecordId], references: [id], onDelete: Cascade)
  template      PayrollTemplate? @relation(fields: [templateId], references: [id])
  payrollUpload PayrollUpload?   @relation(fields: [payrollUploadId], references: [id], onDelete: SetNull)
  payslips      Payslip[]
  emailLogs     EmailLog[]

  @@index([staffRecordId, month, year, companyId])
  @@index([companyId, year, month])
  @@index([templateType])
  @@index([templateId])
  @@index([payrollUploadId])
  @@map("payrolls")
}

model Payslip {
  id            String      @id @default(cuid())
  payrollId     String
  staffRecordId String
  companyId     String
  fileData      Bytes?
  fileName      String
  fileType      String      @default("application/pdf")
  fileSize      Int?
  filePath      String?
  month         String
  year          Int
  grossPay      Decimal?    @db.Decimal(18, 2)
  netPay        Decimal?    @db.Decimal(18, 2)
  draft         Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  updatedBy     String?
  createdBy     String?
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payroll       Payroll     @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  staffRecord   StaffRecord @relation(fields: [staffRecordId], references: [id], onDelete: Cascade)
  emailLogs     EmailLog[]

  @@index([staffRecordId, year, month])
  @@index([staffRecordId, draft])
  @@map("payslips")
}

model StaffUpload {
  id                String            @id @default(cuid())
  companyId         String
  fileName          String
  filePath          String
  processedFilePath String? // Add this field
  processedFileName String? // Add this field
  totalRecords      Int               @default(0)
  successful        Int               @default(0)
