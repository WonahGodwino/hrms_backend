// payment date

model CompanyPayDate {
  id              String   @id @default(cuid())
  companyId       String
  paymentDate     DateTime // Actual date (e.g., 2026-04-28)
  paymentCycle    PaymentCycle // WEEKLY, BI_WEEKLY, MONTHLY
  description     String?  // Optional custom description
  isActive        Boolean  @default(true)
  createdBy       String
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, paymentDate])
  @@index([companyId, isActive])
  @@index([paymentDate])
  @@map("company_pay_dates")
}

enum PaymentCycle {
  WEEKLY
  BI_WEEKLY
  MONTHLY
}

// Update Department model 
model Department {
  id            String      @id @default(cuid())
  name          String
  code          String
  // Denormalised business unit NAME (legacy / display). The canonical link is
  // businessUnitId → BusinessUnit; the name string is kept in sync for back-compat.
  businessUnit  String?
  businessUnitId String?
  companyId     String
  headId        String?
  assistantHeadId String?
  status        String      @default("Active")
  activeHeadcount Int?      @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  maxHeadcount  Int?
  costCenter    String?
  budgetCode    String?
  positionCapacity Json?
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff         StaffRecord[]
  jobs          Job[]
  head          StaffRecord? @relation("DepartmentHead", fields: [headId], references: [id])
  assistantHead StaffRecord? @relation("DepartmentAssistantHead", fields: [assistantHeadId], references: [id])
  businessUnitRef BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  auditLogs     DepartmentAuditLog[]
  staffHistory  DepartmentStaffHistory[]
  transferredFrom DepartmentStaffHistory[] @relation("FromDepartmentTransfer")
  transferredTo   DepartmentStaffHistory[] @relation("ToDepartmentTransfer")
  offboardings  Offboarding[]  @relation("OffboardingDepartment")

  @@unique([companyId, code])
  // Case-insensitive name uniqueness per company is enforced by a functional
  // unique index on (companyId, lower(name)) — see migration
  // 20260711020000_department_unique_name. Prisma can't express expression
  // indexes in the schema, so it lives in the migration and app-level checks
  // compare with mode: 'insensitive'. Stored names keep their original casing.
  @@index([companyId])
  @@index([status])
  @@index([businessUnitId])
  @@map("departments")
}

// A Business Unit groups departments under a common cost centre / leadership.
// Company-scoped (multi-tenant). Departments link via Department.businessUnitId
// (canonical) while Department.businessUnit keeps the denormalised name.
model BusinessUnit {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  code            String?
  costCenter      String?
  description     String?  @db.Text
  headId          String?
  assistantHeadId String?
  status          String   @default("Active") // Active | Inactive
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  archived        Int?     @default(0)

  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  head            StaffRecord? @relation("BusinessUnitHead", fields: [headId], references: [id])
  assistantHead   StaffRecord? @relation("BusinessUnitAssistantHead", fields: [assistantHeadId], references: [id])
  departments     Department[]
  auditLogs       BusinessUnitAuditLog[]

  @@index([companyId, status])
  @@index([companyId, archived])
  @@map("business_units")
}

model BusinessUnitAuditLog {
  id             String   @id @default(cuid())
  businessUnitId String
  companyId      String
  action         String
  performedBy    String?
  performedByName String?
  details        String?  @db.Text
  createdAt      DateTime @default(now())

  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@index([businessUnitId, createdAt])
  @@index([companyId])
  @@map("business_unit_audit_logs")
}

// A temporary elevation of a staff member's access role within a company (e.g. a
// developer given HR access to sit on an interview panel). It's an OVERLAY: the
// staff's base role is never mutated. While ACTIVE (and not past expiresAt) the
// auth layer resolves the elevated role; on revoke/expiry it falls back to base.
model RoleElevation {
  id            String    @id @default(cuid())
  companyId     String
  staffId       String    // StaffRecord being elevated
  fromRole      String    // base role captured at grant time (display only)
  toRole        String    // elevated role: ADMIN | HR
  reason        String    @db.Text
  status        String    @default("ACTIVE") // ACTIVE | REVOKED | EXPIRED
  grantedBy     String    // StaffRecord id of the granter
  grantedByName String?
  grantedByRole String?
  revokedBy     String?
  revokedByName String?
  revokedAt     DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff         StaffRecord @relation("StaffRoleElevations", fields: [staffId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([staffId, status])
  @@map("role_elevations")
}

// Add DepartmentStaffHistory model for tracking staff movements
model DepartmentStaffHistory {
  id            String    @id @default(cuid())
  staffId       String
  departmentId  String
  companyId     String
  action        String
  fromDepartmentId String?
  toDepartmentId   String?
  oldPosition   String?
  newPosition   String?
  reason        String?
  effectiveDate DateTime  @default(now())
  performedBy   String
  createdAt     DateTime  @default(now())
  
  staff         StaffRecord   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  department    Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromDepartment Department?  @relation("FromDepartmentTransfer", fields: [fromDepartmentId], references: [id])
  toDepartment   Department?  @relation("ToDepartmentTransfer", fields: [toDepartmentId], references: [id])

  @@index([staffId, effectiveDate])
  @@index([departmentId, effectiveDate])
  @@index([companyId])
  @@map("department_staff_history")
}

model DepartmentAuditLog {
  id           String   @id @default(cuid())
  departmentId String
  companyId    String
  action       String
  userId       String?
  userName     String?
  type         String?
  details      Json?
  timestamp    DateTime @default(now())

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([departmentId, timestamp])
  @@index([companyId, timestamp])
  @@index([type])
  @@map("department_audit_logs")
}

// ==================== LOANS & BENEFITS MODELS (NEW) ====================
// LoanType enum removed — loanType is now a free-form TEXT field so each
// company can store their own loan product names (e.g. "Car Loan", "Staff Welfare")
// without being constrained to a fixed enum list.

enum LoanRequestStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
  REPAID
  DEFAULTED
}

enum BenefitRequestStatus {
  PENDING
  APPROVED
  REJECTED
  ALLOCATED
  COMPLETED
  CANCELLED
}

model LoanRequest {
  id                     String              @id @default(cuid())
  companyId              String
  staffId                String
  loanType               String              @default("OTHER")
  requestedAmount        Decimal             @db.Decimal(18, 2)
  approvedAmount         Decimal?            @db.Decimal(18, 2)
  tenureMonths           Int
  purpose                String?
  status                 LoanRequestStatus   @default(PENDING)
  rejectionReason        String?
  approvalComment        String?
  approvedBy             String?
  approvedAt             DateTime?
  disbursedAt            DateTime?
  disbursedBy            String?
  expectedRepaymentDate  DateTime?
  interestRate           Decimal             @default(0) @db.Decimal(5, 2)
  monthlyRepayment       Decimal?            @db.Decimal(18, 2)
  remainingBalance       Decimal?            @db.Decimal(18, 2)
  signature              String?             @db.Text
  signatureType          String?             @db.VarChar(20)
  signedAt               DateTime?
  guarantorStaffId       String?
  guarantorStatus        String              @default("NOT_REQUIRED")
  guarantorToken         String?             @unique
  guarantorTokenExpiry   DateTime?
  guarantorRespondedAt   DateTime?
  guarantorDeclineReason String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  createdBy              String

  company                Company             @relation("CompanyLoanRequests", fields: [companyId], references: [id], onDelete: Cascade)
  staff                  StaffRecord         @relation("StaffLoanRequests", fields: [staffId], references: [id], onDelete: Cascade)
  approver               StaffRecord?        @relation("LoanApprover", fields: [approvedBy], references: [id])

  @@index([staffId, companyId])
  @@index([companyId, status])
  @@index([status, createdAt])
  @@index([staffId, status])
  @@map("loan_requests")
}

model BenefitRequest {
  id                     String              @id @default(cuid())
  companyId              String
  staffId                String
  benefitId              String
  benefitName            String
  reason                 String?
  status                 BenefitRequestStatus @default(PENDING)
  rejectionReason        String?
  approvalComment        String?
  approvedBy             String?
  approvedAt             DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  createdBy              String

  company                Company             @relation("CompanyBenefitRequests", fields: [companyId], references: [id], onDelete: Cascade)
  staff                  StaffRecord         @relation("StaffBenefitRequests", fields: [staffId], references: [id], onDelete: Cascade)
  approver               StaffRecord?        @relation("BenefitRequestApprover", fields: [approvedBy], references: [id])

  @@index([staffId, companyId])
  @@index([companyId, status])
  @@index([status, createdAt])
  @@index([staffId, status])
  @@map("benefit_requests")
}

model BenefitAllocation {
  id                     String              @id @default(cuid())
  companyId              String
  staffId                String
  benefitId              String
  benefitName            String
  allocationAmount       Decimal             @db.Decimal(18, 2)
  allocatedBy            String
  note                   String?
  status                 BenefitRequestStatus @default(ALLOCATED)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  company                Company             @relation("CompanyBenefitAllocations", fields: [companyId], references: [id], onDelete: Cascade)
  staff                  StaffRecord         @relation("StaffBenefitAllocations", fields: [staffId], references: [id], onDelete: Cascade)
  allocator              StaffRecord         @relation("BenefitAllocator", fields: [allocatedBy], references: [id])

  @@index([staffId, companyId])
  @@index([companyId, createdAt])
  @@index([staffId, createdAt])
  @@map("benefit_allocations")
}
enum FilingStatus {
  PENDING
  GENERATED
  FILED
  CONFIRMED
}


// Grade Level model

model GradeLevel {
  id                  String            @id @default(cuid())
  name                String
  rank                Int
  summary             String?           @db.Text
  basePay             Float?
  basePayFrequency    BasePayFrequency? @default(Monthly)
  totalSteps          Int               @default(1)
  autoProgression     Boolean           @default(true)
  progressionTimeline Int?
  requirePerfRating   Boolean           @default(true)
  status              GradeStatus       @default(Active)
  companyId           String
  createdBy           String
  updatedBy           String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  
  // Relations
  steps                   GradeStep[]
  benefits                Benefit[]              @relation("GradeBenefits")
  designations            Designation[]
  company                 Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  staff                   StaffRecord[]          @relation("StaffGradeLevel")
  staffSalaryHistory      StaffSalaryHistory[]
  companyAllowanceRules   CompanyAllowanceRule[]
  gradeStepAllowances     GradeStepAllowance[]
  gradeAllowanceTemplates GradeAllowanceTemplate[]
  staffGradeHistory       StaffGradeHistory[]
  previousGradeHistory    StaffGradeHistory[]    @relation("PreviousGradeHistory")
  
  @@unique([companyId, rank])
  @@unique([companyId, name])
  @@index([companyId, status])
}

model GradeStep {
  id               String     @id @default(cuid())
  gradeLevelId     String
  stepNumber       Int
  incrementPercent Float      @default(0)
  calculatedPay    Float?
  gradeLevel       GradeLevel @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  
  @@unique([gradeLevelId, stepNumber])
}

model Benefit {
  id          String        @id @default(cuid())
  label       String        @unique
  type        String
  description String?
  companyId   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  gradeLevels  GradeLevel[] @relation("GradeBenefits")
  company      Company?     @relation(fields: [companyId], references: [id])
}

enum GradeStatus {
  Active
  Inactive
}

enum BasePayFrequency {
  Yearly
  Monthly
  BiWeekly
}

// Designation model 
model Designation {
  id           String      @id @default(cuid())
  companyId    String?
  title        String
  code         String
  gradeLevelId String?
  departmentId String?
  description  String?     @db.Text
  status       String      @default("Active")
  staffCount   Int         @default(0)
  // Whether this designation derives pay from a grade level. When false, base
  // pay is stored directly on the designation via basePay/basePayFrequency.
  hasGradeLevel     Boolean            @default(false)
  basePay           Float?
  basePayFrequency  BasePayFrequency?
  benefits          Json?
  gradeLevel   GradeLevel? @relation(fields: [gradeLevelId], references: [id])
  staffRecords  StaffRecord[]
  jobs          Job[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  company      Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, status])
  @@index([gradeLevelId])
}



// Company-specific allowance/benefit rules
model CompanyAllowanceRule {
  id              String            @id @default(cuid())
  companyId       String
  name            String            // e.g., "Housing Allowance", "Transport Allowance"
  code            String            // e.g., "HOUSING", "TRANSPORT"
  type            AllowanceType     @default(PERCENTAGE) // PERCENTAGE, FIXED
  value           Float?            // Percentage (e.g., 20 for 20%) or fixed amount
  appliesTo       String            // BASIC_SALARY, GROSS_SALARY, SPECIFIC_GRADE
  gradeLevelId    String?           // Optional: specific grade level this applies to
  minAmount       Float?            // Minimum amount if percentage calculation
  maxAmount       Float?            // Maximum amount if percentage calculation
  isTaxable       Boolean           @default(false)
  isActive        Boolean           @default(true)
  requiresApproval Boolean          @default(false)
  priority        Int               @default(0) // Order of calculation
  createdBy       String
  updatedBy       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  gradeLevel      GradeLevel?       @relation(fields: [gradeLevelId], references: [id])

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([companyId, gradeLevelId])
  @@map("company_allowance_rules")
}

// Grade-specific step allowances
model GradeStepAllowance {
  id              String            @id @default(cuid())
  companyId       String
  gradeLevelId    String
  stepNumber      Int
  allowanceCode   String
  allowanceType   AllowanceType
  value           Float
  isTaxable       Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  gradeLevel      GradeLevel        @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)

  @@unique([gradeLevelId, stepNumber, allowanceCode])
  @@index([companyId, gradeLevelId, stepNumber])
  @@map("grade_step_allowances")
}

// Company-wide salary calculation formulas
model CompanySalaryFormula {
  id              String            @id @default(cuid())
  companyId       String            @unique
  name            String
  description     String?
  baseFormula     Json              // JSON formula definition
  allowancesFormula Json            // JSON allowances calculation rules
  deductionsFormula Json            // JSON deductions calculation rules
  isActive        Boolean           @default(true)
  version         Int               @default(1)
  createdBy       String
  updatedBy       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_salary_formulas")
}

// Grade level allowance templates (default rules per grade)
model GradeAllowanceTemplate {
  id              String            @id @default(cuid())
  companyId       String
  gradeLevelId    String
  allowanceCode   String
  allowanceType   AllowanceType
  value           Float             // Percentage or fixed amount
  appliesTo       String            // BASIC_SALARY, GROSS_SALARY
  minAmount       Float?
  maxAmount       Float?
  isTaxable       Boolean           @default(false)
  priority        Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  gradeLevel      GradeLevel        @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)

  @@unique([gradeLevelId, allowanceCode])
  @@index([companyId, gradeLevelId])
  @@map("grade_allowance_templates")
}


model StaffSalaryHistory {
  id              String      @id @default(cuid())
  staffId         String
  companyId       String
  gradeLevelId    String
  stepNumber      Int
  basicSalary     Decimal     @db.Decimal(18, 2)
  totalAllowances Decimal     @db.Decimal(18, 2)
  grossSalary     Decimal     @db.Decimal(18, 2)
  effectiveDate   DateTime
  endDate         DateTime?
  reason          String
  approvedBy      String
  notes           String?
  createdAt       DateTime    @default(now())
  
  staff           StaffRecord @relation(fields: [staffId], references: [id], onDelete: Cascade)
  gradeLevel      GradeLevel  @relation(fields: [gradeLevelId], references: [id])
  company         Company     @relation(fields: [companyId], references: [id])
  
  @@index([staffId, effectiveDate])
  @@index([gradeLevelId, effectiveDate])
  @@index([companyId, effectiveDate])
}

model StaffGradeHistory {
  id              String      @id @default(cuid())
  staffId         String
  companyId       String
  gradeLevelId    String
  stepNumber      Int
  effectiveDate   DateTime
  endDate         DateTime?
  reason          String
  previousGradeId String?
  previousStep    Int?
  createdBy       String
  createdAt       DateTime    @default(now())

  staff           StaffRecord @relation(fields: [staffId], references: [id], onDelete: Cascade)
  gradeLevel      GradeLevel  @relation(fields: [gradeLevelId], references: [id])
  previousGrade   GradeLevel? @relation("PreviousGradeHistory", fields: [previousGradeId], references: [id])
  company         Company     @relation(fields: [companyId], references: [id])

  @@index([staffId, effectiveDate])
  @@index([gradeLevelId, effectiveDate])
  @@index([companyId, effectiveDate])
  @@index([previousGradeId])
}

enum AllowanceType {
  PERCENTAGE
  FIXED
  TIERED
  FORMULA
}

// ─── Staff Loans & Benefits ───

model LoanPolicy {
  id                        String    @id @default(cuid())
  companyId                 String
  name                      String
  interestRatePercent       Float     @default(5)
  maxDurationMonths         Int       @default(12)
  maxAmount                 Float     @default(500000)
  minServiceMonths          Int       @default(3)
  maxDebtRatioPercent       Float     @default(40)
  requiresGuarantor                  Boolean   @default(false)
  guarantorThresholdAmount           Float?
  guarantorMustBeActiveInCompany     Boolean   @default(true)
  guarantorMustNotHaveActiveLoan     Boolean   @default(false)
  salaryMultiplier                   Float     @default(1.0)
  isActive                  Boolean   @default(true)
  rules                     String?   @db.Text
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  company                   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

model BenefitPolicy {
  id              String    @id @default(cuid())
  companyId       String
  name            String
  category        String
  description     String?   @db.Text
  monetaryValue   Float?
  keyValue        String?
  eligibilityRule String?   @db.Text
  isActive        Boolean   @default(true)
  // Optional job scope: when set, this benefit applies only to that job role;
  // when null it applies to all roles (the default).
  jobId           String?
  // Optional designation/grade scope. When designationId is set the benefit only
  // applies to staff in that designation; if gradeLevelId is ALSO set it is
  // further restricted to staff in that grade level within the designation. A
  // blank gradeLevelId means all staff in the designation qualify. Both blank =
  // company-wide. FKs are enforced in SQL only (no Prisma relation) so the
  // generated client is not required to read/write these columns.
  designationId   String?
  gradeLevelId    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@index([companyId, jobId])
  @@index([companyId, designationId])
}

// Required onboarding documents uploaded by a new hire (STAFF). One row per
// category per staff (re-upload replaces). Bytes are stored in the DB.
model StaffOnboardingDocument {
  id         String   @id @default(cuid())
  companyId  String
  staffId    String
  category   String   // MEANS_OF_ID | GUARANTOR_FORM | SIGNED_OFFER
  fileName   String
  mimeType   String
  sizeBytes  Int
  data       Bytes
  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([staffId, category])
  @@index([companyId, staffId])
  @@map("staff_onboarding_documents")
}

// Add to schema.prisma

enum OffboardingType {
  RESIGNATION
  TERMINATION
}

enum OffboardingStatus {
  PENDING_REVIEW
  HANDOVER_REQUESTED
  HANDOVER_SUBMITTED
  COMPLETED
  REJECTED
}

enum InitiatedBy {
  STAFF
  HR
}

model Offboarding {
  id                   String            @id @default(cuid())
  companyId            String
  staffId              String
  departmentId         String?
  
  type                 OffboardingType
  status               OffboardingStatus @default(PENDING_REVIEW)
  initiatedBy          InitiatedBy
  
  // Resignation specific
  resignationLetter    String?           // File URL/path
  resignationComment   String?
  
  // Handover
  handoverRequired     Boolean           @default(true)
  handoverDocument     String?           // File URL/path
  handoverSubmittedAt  DateTime?
  
  // Review
  reviewComment        String?
  reviewedBy           String?
  reviewedAt           DateTime?
  
  // Timestamps
  createdAt            DateTime          @default(now())
  submittedAt          DateTime?
  completedAt          DateTime?
  updatedAt            DateTime          @updatedAt
  
  // Relations
  company              Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  // Staff who is being offboarded
  staff                StaffRecord       @relation("StaffOffboardings", fields: [staffId], references: [id], onDelete: Cascade)
  
  // Staff who reviewed this offboarding (HR/Admin)
  reviewer             StaffRecord?      @relation("OffboardingReviewer", fields: [reviewedBy], references: [id])
  department           Department? @relation("OffboardingDepartment", fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([companyId, staffId, status])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([staffId])
  @@index([departmentId])
  @@index([createdAt])
  @@map("offboardings")
}