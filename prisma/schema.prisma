// Triage queue for inbound mail whose In-Reply-To/References didn't match
// any stored messageId — e.g. a corporate gateway stripped the headers, or
// a candidate forwarded instead of replying. Deliberately NOT linked to any
// company until a SUPER_ADMIN manually attributes it: the shared mailbox
// means a wrong automatic guess would leak one company's candidate reply
// into another company's thread.
model OfferLetterUnmatchedReply {
  id            String   @id @default(cuid())
  messageId     String?
  fromEmail     String
  fromName      String?
  subject       String
  body          String
  rawHeaders    Json // full header dump, for manual investigation
  receivedAt    DateTime
  linkedEmailId String? // set once a SUPER_ADMIN attributes it; this row stays as an audit trail
  createdAt     DateTime @default(now())

  @@map("offer_letter_unmatched_replies")
}

