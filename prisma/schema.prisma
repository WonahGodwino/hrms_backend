  @@index([companyId])
  @@map("certification_templates")
}

model CertificationRecord {
  id                  String    @id @default(cuid())
  companyId           String
  employeeId          String
  certificationTypeId String
  certIdNumber        String?
  issueDate           DateTime
  expiryDate          DateTime?
  duration            String?
  status              String    @default("Pending") // Valid | Expiring Soon | Expired | Pending
