{
  "info": {
    "_postman_id": "tax-filing-collection-2026",
    "name": "iSURFHR Tax Filing API",
    "description": "Multi-State Tax Compliance & Filing API for Nigerian PAYE tax filing, monthly schedules, and annual Form H1 returns.\n\n## Setup Instructions\n\n1. Set the `base_url` variable to your API server (e.g., `http://localhost:3000`)\n2. Set the `access_token` variable after logging in\n3. Set the `company_id` variable to your company ID\n\n## Authentication\n\nAll requests require Bearer token authentication. Get a token from the Auth endpoints and set it in the `access_token` variable.\n\n## Response Format\n\nAll responses follow this format:\n```json\n{\n  \"success\": true|false,\n  \"message\": \"string\",\n  \"data\": {...}\n}\n```",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "your-jwt-token-here",
      "type": "string"
    },
    {
      "key": "company_id",
      "value": "your-company-id",
      "type": "string"
    },
    {
      "key": "staff_id",
      "value": "staff-record-id",
      "type": "string"
    },
    {
      "key": "period_id",
      "value": "pay-period-id",
      "type": "string"
    },
    {
      "key": "state_code",
      "value": "LA",
      "type": "string"
    },
    {
      "key": "year",
      "value": "2026",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Tax Profiles",
      "description": "Employee tax profile management - state of residence, TIN, and PFA",
      "item": [
        {
          "name": "List Tax Profiles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/profiles?companyId={{company_id}}&page=1&limit=50",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "profiles"],
              "query": [
                {
                  "key": "companyId",
                  "value": "{{company_id}}",
                  "description": "Company ID (required for Admin/Super_Admin)"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number"
                },
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Items per page"
                },
                {
                  "key": "state",
                  "value": "LA",
                  "description": "Filter by state code",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Search by name or staff ID",
                  "disabled": true
                }
              ]
            },
            "description": "Get list of employee tax profiles with pagination and filtering."
          },
          "response": []
        },
        {
          "name": "List Employees Without Profiles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/profiles?companyId={{company_id}}&missingProfiles=true",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "profiles"],
              "query": [
                {
                  "key": "companyId",
                  "value": "{{company_id}}"
                },
                {
                  "key": "missingProfiles",
                  "value": "true",
                  "description": "Get employees without tax profiles"
                }
              ]
            },
            "description": "Get list of employees who don't have tax profiles yet."
          },
          "response": []
        },
        {
          "name": "Staff Lookup (for Dropdown)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/profiles/staff-lookup?companyId={{company_id}}&withoutProfile=true&limit=500",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "profiles", "staff-lookup"],
              "query": [
                {
                  "key": "companyId",
                  "value": "{{company_id}}",
                  "description": "Company ID (required for Admin/Super_Admin)"
                },
                {
                  "key": "withoutProfile",
                  "value": "true",
                  "description": "Only return staff without tax profiles"
                },
                {
                  "key": "limit",
                  "value": "500",
                  "description": "Max results"
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Search by name, staffId, or email",
                  "disabled": true
                }
              ]
            },
            "description": "Get list of staff formatted for dropdown selection when creating tax profiles. Integrates with /api/engine/staff endpoint."
          },
          "response": []
        },
        {
          "name": "Get Single Tax Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/profiles/{{staff_id}}?companyId={{company_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "profiles", "{{staff_id}}"],
              "query": [
                {
                  "key": "companyId",
                  "value": "{{company_id}}"
                }
              ]
            },
            "description": "Get tax profile for a specific employee."
          },
          "response": []
        },
        {
          "name": "Create Tax Profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"staffId\": \"{{staff_id}}\",\n  \"stateOfResidence\": \"Lagos\",\n  \"jtbTin\": \"1234567890123\",\n  \"pfaName\": \"ARM Pension\",\n  \"companyId\": \"{{company_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/profiles",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "profiles"]
            },
            "description": "Create a new tax profile for an employee.\n\n**Required Fields:**\n- staffId: Staff record ID\n- stateOfResidence: Nigerian state name (e.g., \"Lagos\", \"FCT\", \"Ogun\")\n\n**Optional Fields:**\n- jtbTin: 13-digit JTB Tax ID\n- pfaName: Pension Fund Administrator name"
          },
          "response": []
        },
        {
          "name": "Update Tax Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stateOfResidence\": \"Ogun\",\n  \"jtbTin\": \"9876543210123\",\n  \"pfaName\": \"Stanbic IBTC Pension\",\n  \"tinVerified\": false,\n  \"companyId\": \"{{company_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/profiles/{{staff_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "profiles", "{{staff_id}}"]
            },
            "description": "Update an existing tax profile.\n\nAll fields are optional - only include fields you want to update."
          },
          "response": []
        },
        {
          "name": "Delete Tax Profile",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/profiles/{{staff_id}}?companyId={{company_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "profiles", "{{staff_id}}"],
              "query": [
                {
                  "key": "companyId",
                  "value": "{{company_id}}"
                }
              ]
            },
            "description": "Delete an employee's tax profile."
          },
          "response": []
        },
        {
          "name": "Download Import Template",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/profiles/template?companyId={{company_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "profiles", "template"],
              "query": [
                {
                  "key": "companyId",
                  "value": "{{company_id}}"
                }
              ]
            },
            "description": "Download Excel template for bulk importing tax profiles.\n\n**Template Columns:**\n- staffId (required)\n- stateOfResidence (required)\n- jtbTin (optional)\n- pfaName (optional)"
          },
          "response": []
        },
        {
          "name": "Bulk Import Tax Profiles",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "Excel or CSV file with tax profiles"
                },
                {
                  "key": "companyId",
                  "value": "{{company_id}}",
                  "type": "text",
                  "description": "Company ID (required for Admin/Super_Admin)"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/profiles/upload",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "profiles", "upload"]
            },
            "description": "Bulk import tax profiles from Excel or CSV file.\n\n**Supported Formats:**\n- .xlsx (Excel)\n- .xls (Excel 97-2003)\n- .csv (Comma Separated)"
          },
          "response": []
        },
        {
          "name": "Check Lock Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/profiles/lock-states?companyId={{company_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "profiles", "lock-states"],
              "query": [
                {
                  "key": "companyId",
                  "value": "{{company_id}}"
                }
              ]
            },
            "description": "Check if states have been locked for the current year (January 1st rule)."
          },
          "response": []
        },
        {
          "name": "Lock States for Year",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"year\": 2026,\n  \"companyId\": \"{{company_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/profiles/lock-states",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "profiles", "lock-states"]
            },
            "description": "Lock employee states for the tax year (January 1st rule per PITA).\n\n**Important:**\n- This action locks all employees' current states\n- Cannot be undone\n- Should be done at the start of each tax year"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Monthly Filing",
      "description": "Monthly PAYE schedule generation and filing",
      "item": [
        {
          "name": "Get Monthly Filing Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/monthly/{{period_id}}?companyId={{company_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "monthly", "{{period_id}}"],
              "query": [
                {
                  "key": "companyId",
                  "value": "{{company_id}}"
                }
              ]
            },
            "description": "Get monthly filing summary for a pay period.\n\nIncludes:\n- Period information\n- Generated schedules by state\n- State summary (preview)\n- Missing employees (no tax profile)\n- Overall totals"
          },
          "response": []
        },
        {
          "name": "Generate Monthly Schedules",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": \"{{company_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/monthly/{{period_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "monthly", "{{period_id}}"]
            },
            "description": "Generate monthly PAYE schedules for all states with employees.\n\n**Prerequisites:**\n- Pay period must be in REVIEW, APPROVED, or PAID status\n- Employees must have tax profiles\n\n**Note:** Running this again will update existing schedules."
          },
          "response": []
        },
        {
          "name": "Get State Schedule Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/monthly/{{period_id}}/{{state_code}}?companyId={{company_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "monthly", "{{period_id}}", "{{state_code}}"],
              "query": [
                {
                  "key": "companyId",
                  "value": "{{company_id}}"
                }
              ]
            },
            "description": "Get detailed schedule data for a specific state.\n\n**Path Parameters:**\n- periodId: Pay period ID\n- stateCode: State code (e.g., LA, OG, FC)\n\n**Returns:**\n- Employee list with tax breakdown\n- Filing status"
          },
          "response": []
        },
        {
          "name": "Download State Schedule (Excel)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/monthly/{{period_id}}/{{state_code}}/download?format=xlsx&companyId={{company_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "monthly", "{{period_id}}", "{{state_code}}", "download"],
              "query": [
                {
                  "key": "format",
                  "value": "xlsx",
                  "description": "Export format: xlsx or csv"
                },
                {
                  "key": "companyId",
                  "value": "{{company_id}}"
                }
              ]
            },
            "description": "Download state PAYE schedule as Excel file.\n\n**Formats:**\n- xlsx (default) - Excel with formatting\n- csv - Plain CSV"
          },
          "response": []
        },
        {
          "name": "Download State Schedule (CSV)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/monthly/{{period_id}}/{{state_code}}/download?format=csv&companyId={{company_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "monthly", "{{period_id}}", "{{state_code}}", "download"],
              "query": [
                {
                  "key": "format",
                  "value": "csv"
                },
                {
                  "key": "companyId",
                  "value": "{{company_id}}"
                }
              ]
            },
            "description": "Download state PAYE schedule as CSV file."
          },
          "response": []
        },
        {
          "name": "Mark Schedule as Filed",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentReference\": \"LIRS-2026-03-12345\",\n  \"companyId\": \"{{company_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/monthly/{{period_id}}/{{state_code}}",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "monthly", "{{period_id}}", "{{state_code}}"]
            },
            "description": "Mark a state schedule as filed after submitting to the IRS.\n\n**Optional:**\n- paymentReference: Payment or receipt reference from IRS"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Annual Returns",
      "description": "Annual Form H1 generation and filing",
      "item": [
        {
          "name": "Get Annual Filing Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/annual/{{year}}?companyId={{company_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "annual", "{{year}}"],
              "query": [
                {
                  "key": "companyId",
                  "value": "{{company_id}}"
                }
              ]
            },
            "description": "Get annual filing summary for a tax year.\n\nIncludes:\n- Available pay periods\n- Generated returns by state\n- Year totals"
          },
          "response": []
        },
        {
          "name": "Generate Annual Returns (Form H1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": \"{{company_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/annual/{{year}}",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "annual", "{{year}}"]
            },
            "description": "Generate Form H1 annual returns for all states.\n\n**Prerequisites:**\n- At least some pay periods completed for the year\n- Employees with tax profiles\n\n**Note:** Should be run after all 12 months are complete."
          },
          "response": []
        },
        {
          "name": "Get State Annual Return (Form H1 Data)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/annual/{{year}}/{{state_code}}?companyId={{company_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "annual", "{{year}}", "{{state_code}}"],
              "query": [
                {
                  "key": "companyId",
                  "value": "{{company_id}}"
                }
              ]
            },
            "description": "Get detailed Form H1 data for a specific state.\n\nIncludes:\n- Company information\n- Employee list with monthly breakdown\n- Annual totals\n- Filing status"
          },
          "response": []
        },
        {
          "name": "Download Form H1 (Excel)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/annual/{{year}}/{{state_code}}/download?format=xlsx&companyId={{company_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "annual", "{{year}}", "{{state_code}}", "download"],
              "query": [
                {
                  "key": "format",
                  "value": "xlsx"
                },
                {
                  "key": "companyId",
                  "value": "{{company_id}}"
                }
              ]
            },
            "description": "Download Form H1 as Excel file.\n\n**Contents:**\n- Header with company info and IRS\n- Employee table with monthly tax breakdown (Jan-Dec)\n- Annual totals"
          },
          "response": []
        },
        {
          "name": "Download Form H1 (CSV)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/annual/{{year}}/{{state_code}}/download?format=csv&companyId={{company_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "annual", "{{year}}", "{{state_code}}", "download"],
              "query": [
                {
                  "key": "format",
                  "value": "csv"
                },
                {
                  "key": "companyId",
                  "value": "{{company_id}}"
                }
              ]
            },
            "description": "Download Form H1 as CSV file."
          },
          "response": []
        },
        {
          "name": "Mark Annual Return as Filed",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": \"{{company_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/annual/{{year}}/{{state_code}}",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "annual", "{{year}}", "{{state_code}}"]
            },
            "description": "Mark an annual return as filed after submitting to the IRS."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Tax Certificates",
      "description": "Employee tax certificate generation",
      "item": [
        {
          "name": "List Eligible Employees",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": \"{{company_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/annual/tax-certificates/{{year}}",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "annual", "tax-certificates", "{{year}}"]
            },
            "description": "Get list of employees eligible for tax certificates.\n\nEligibility:\n- Has payslips for the specified year\n- Payslips are in completed status"
          },
          "response": []
        },
        {
          "name": "Download Employee Tax Certificate",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/annual/tax-certificates/{{year}}?staffId={{staff_id}}&companyId={{company_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "annual", "tax-certificates", "{{year}}"],
              "query": [
                {
                  "key": "staffId",
                  "value": "{{staff_id}}",
                  "description": "Staff record ID"
                },
                {
                  "key": "companyId",
                  "value": "{{company_id}}"
                }
              ]
            },
            "description": "Download tax certificate for a specific employee.\n\n**Certificate Contents:**\n- Employee information\n- Employer information\n- Annual summary (gross, PAYE, pension)\n- Monthly breakdown"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Dashboard & States",
      "description": "Overview and reference endpoints",
      "item": [
        {
          "name": "Get Filing Dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/dashboard?companyId={{company_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "dashboard"],
              "query": [
                {
                  "key": "companyId",
                  "value": "{{company_id}}"
                }
              ]
            },
            "description": "Get tax filing dashboard overview.\n\nIncludes:\n- Current period filing status\n- Annual summary\n- Tax profile status\n- Recent activity"
          },
          "response": []
        },
        {
          "name": "List States with Employee Counts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/engine/tax-filing/states?companyId={{company_id}}&includeEmpty=false",
              "host": ["{{base_url}}"],
              "path": ["api", "engine", "tax-filing", "states"],
              "query": [
                {
                  "key": "companyId",
                  "value": "{{company_id}}"
                },
                {
                  "key": "includeEmpty",
                  "value": "false",
                  "description": "Include states with 0 employees"
                }
              ]
            },
            "description": "Get list of Nigerian states with employee counts.\n\nUseful for:\n- Seeing distribution of employees\n- Identifying states requiring filing"
          },
          "response": []
        },
