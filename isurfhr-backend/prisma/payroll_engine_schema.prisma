// // ============================================================
// // FOREIGN KEY CONSTRAINTS (for your reference sir)
// // ============================================================
// //
// // EXISTING TABLES (do NOT create):
// //   - companies (id: TEXT PRIMARY KEY)
// //   - staff_records (id: TEXT PRIMARY KEY)
// //
// // NEW TABLE FOREIGN KEYS:
// //
// // pay_periods:
// //   - companyId -> companies(id) ON DELETE CASCADE
// //
// // employee_salaries:
// //   - staffId -> staff_records(id) ON DELETE CASCADE
// //   - companyId -> companies(id) ON DELETE CASCADE
// //
// // pay_validations:
// //   - payPeriodId -> pay_periods(id) ON DELETE CASCADE
// //   - staffId -> staff_records(id) ON DELETE CASCADE
// //   - supervisorId -> staff_records(id) ON DELETE SET NULL
// //   - companyId -> companies(id) ON DELETE CASCADE
// //
// // overtime_entries:
// //   - payPeriodId -> pay_periods(id) ON DELETE CASCADE
// //   - staffId -> staff_records(id) ON DELETE CASCADE
// //   - companyId -> companies(id) ON DELETE CASCADE
// //
// // deduction_entries:
// //   - payPeriodId -> pay_periods(id) ON DELETE CASCADE
// //   - staffId -> staff_records(id) ON DELETE CASCADE
// //   - companyId -> companies(id) ON DELETE CASCADE
// //
// // computed_payslips:
// //   - payPeriodId -> pay_periods(id) ON DELETE CASCADE
// //   - staffId -> staff_records(id) ON DELETE CASCADE
// //   - companyId -> companies(id) ON DELETE CASCADE
// //
// // ============================================================
// // TAX CALCULATION REFERENCE (Nigeria 2026)
// // ============================================================
// //
// // STATUTORY RATES:
// //   - Pension (Employee): 8% of (Basic + Housing + Transport)
// //   - Pension (Employer): 10% of (Basic + Housing + Transport)
// //   - NHF: 2.5% of Basic Salary
// //   - NHIS: 5% of Gross Income (if applicable)
// //   - ITF: 1% of Total Payroll (employer contribution)
// //   - NSITF: 1% of Total Payroll (employer contribution)
// //
// // TAX RELIEFS:
// //   - CRA: MAX(₦200,000, 1% of Gross + 20% of Gross)
// //   - Rent Relief: MIN(20% of Annual Rent, ₦500,000)
// //
// // PAYE TAX BANDS:
// //   - First ₦300,000: 7%
// //   - Next ₦300,000: 11%
// //   - Next ₦500,000: 15%
// //   - Next ₦500,000: 19%
// //   - Next ₦1,600,000: 21%
// //   - Above ₦3,200,000: 24%
// //
// // ZERO TAX RULE:
// //   - If Annual Chargeable Income ≤ ₦800,000, PAYE = ₦0
// //
// // ============================================================
