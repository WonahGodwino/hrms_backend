{
  "info": {
    "_postman_id": "payroll-engine-collection",
    "name": "iSURFHR Payroll Engine API",
    "description": "Complete API collection for the iSURFHR Payroll Engine module. This collection includes all endpoints for managing payroll periods, employee salaries, overtime, deductions, validations, payroll computation, and payslip generation.\n\n## Authentication\nAll endpoints require Bearer token authentication. Set the `{{auth_token}}` variable with your JWT token.\n\n## Base URL\nSet the `{{base_url}}` variable to your API server (e.g., `http://localhost:3000/api/engine`)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api/engine",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "your-jwt-token-here",
      "type": "string"
    },
    {
      "key": "pay_period_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "staff_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Pay Periods",
      "description": "Endpoints for managing payroll periods",
      "item": [
        {
          "name": "Create Pay Period",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"March 2026 Payroll\",\n  \"startDate\": \"2026-03-01\",\n  \"endDate\": \"2026-03-31\",\n  \"paymentDate\": \"2026-03-28\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/pay-periods",
              "host": ["{{base_url}}"],
              "path": ["pay-periods"]
            },
            "description": "Create a new payroll period. Only SUPER_ADMIN and ADMIN roles can create pay periods."
          },
          "response": []
        },
        {
          "name": "Get All Pay Periods",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/pay-periods",
              "host": ["{{base_url}}"],
              "path": ["pay-periods"]
            },
            "description": "Retrieve all payroll periods for the company. Results are sorted by creation date (newest first)."
          },
          "response": []
        },
        {
          "name": "Get Pay Period by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/pay-periods/{{pay_period_id}}",
              "host": ["{{base_url}}"],
              "path": ["pay-periods", "{{pay_period_id}}"]
            },
            "description": "Retrieve details of a specific payroll period including its current status."
          },
          "response": []
        },
        {
          "name": "Update Pay Period Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"VALIDATION_OPEN\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/pay-periods/{{pay_period_id}}",
              "host": ["{{base_url}}"],
              "path": ["pay-periods", "{{pay_period_id}}"]
            },
            "description": "Update the status of a payroll period. Valid statuses: DRAFT, VALIDATION_OPEN, VALIDATION_CLOSED, COMPUTING, REVIEW, APPROVED, PAID"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Employee Salaries",
      "description": "Endpoints for managing employee salary structures",
      "item": [
        {
          "name": "Create Employee Salary",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"staffId\": \"{{staff_id}}\",\n  \"basicSalary\": 500000,\n  \"housingAllowance\": 100000,\n  \"transportAllowance\": 50000,\n  \"otherAllowances\": 25000,\n  \"effectiveDate\": \"2026-01-01\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/employee-salaries",
              "host": ["{{base_url}}"],
              "path": ["employee-salaries"]
            },
            "description": "Create a new salary structure for an employee. All amounts are in Naira."
          },
          "response": []
        },
        {
          "name": "Get All Employee Salaries",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/employee-salaries",
              "host": ["{{base_url}}"],
              "path": ["employee-salaries"]
            },
            "description": "Retrieve all employee salary structures for the company."
          },
          "response": []
        },
        {
          "name": "Get Employee Salary by Staff ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/employee-salaries/{{staff_id}}",
              "host": ["{{base_url}}"],
              "path": ["employee-salaries", "{{staff_id}}"]
            },
            "description": "Retrieve the current salary structure for a specific employee."
          },
          "response": []
        },
        {
          "name": "Update Employee Salary",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"basicSalary\": 550000,\n  \"housingAllowance\": 110000,\n  \"transportAllowance\": 55000,\n  \"otherAllowances\": 30000\n}"
            },
            "url": {
              "raw": "{{base_url}}/employee-salaries/{{staff_id}}",
              "host": ["{{base_url}}"],
              "path": ["employee-salaries", "{{staff_id}}"]
            },
            "description": "Update salary structure for an employee. Only changed fields need to be sent."
          },
          "response": []
        },
        {
          "name": "Delete Employee Salary",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/employee-salaries/{{staff_id}}",
              "host": ["{{base_url}}"],
              "path": ["employee-salaries", "{{staff_id}}"]
            },
            "description": "Delete an employee's salary structure. Cannot delete if there are computed payslips for this employee."
          },
          "response": []
        },
        {
          "name": "Bulk Import Employee Salaries",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"salaries\": [\n    {\n      \"staffId\": \"staff-001\",\n      \"basicSalary\": 500000,\n      \"housingAllowance\": 100000,\n      \"transportAllowance\": 50000,\n      \"otherAllowances\": 25000,\n      \"effectiveDate\": \"2026-01-01\"\n    },\n    {\n      \"staffId\": \"staff-002\",\n      \"basicSalary\": 450000,\n      \"housingAllowance\": 90000,\n      \"transportAllowance\": 45000,\n      \"otherAllowances\": 20000,\n      \"effectiveDate\": \"2026-01-01\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/employee-salaries/import",
              "host": ["{{base_url}}"],
              "path": ["employee-salaries", "import"]
            },
            "description": "Bulk import multiple employee salary structures. Existing salaries will be updated (upsert behavior)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Overtime",
      "description": "Endpoints for managing overtime entries",
      "item": [
        {
          "name": "Add Overtime Entry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"staffId\": \"{{staff_id}}\",\n  \"payPeriodId\": \"{{pay_period_id}}\",\n  \"hours\": 10,\n  \"rate\": 1.5,\n  \"description\": \"Weekend overtime - Project deadline\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/overtime",
              "host": ["{{base_url}}"],
              "path": ["overtime"]
            },
            "description": "Add an overtime entry for an employee. Rate is a multiplier (e.g., 1.5 = time and a half)."
          },
          "response": []
        },
        {
          "name": "Get Overtime by Period",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/overtime/{{pay_period_id}}",
              "host": ["{{base_url}}"],
              "path": ["overtime", "{{pay_period_id}}"]
            },
            "description": "Get all overtime entries for a specific pay period."
          },
          "response": []
        },
        {
          "name": "Get Staff Overtime Total",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/overtime/{{pay_period_id}}/staff/{{staff_id}}",
              "host": ["{{base_url}}"],
              "path": ["overtime", "{{pay_period_id}}", "staff", "{{staff_id}}"]
            },
            "description": "Get total overtime hours and amount for a specific staff member in a pay period."
          },
          "response": []
        },
        {
          "name": "Delete Overtime Entry",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/overtime/entry/{{overtime_entry_id}}",
              "host": ["{{base_url}}"],
              "path": ["overtime", "entry", "{{overtime_entry_id}}"]
            },
            "description": "Delete a specific overtime entry. Cannot delete if payroll has been computed."
          },
          "response": []
        },
        {
          "name": "Bulk Upload Overtime",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entries\": [\n    {\n      \"staffId\": \"staff-001\",\n      \"hours\": 8,\n      \"rate\": 1.5,\n      \"description\": \"Weekend work\"\n    },\n    {\n      \"staffId\": \"staff-002\",\n      \"hours\": 4,\n      \"rate\": 2.0,\n      \"description\": \"Holiday work\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/overtime/upload/{{pay_period_id}}",
              "host": ["{{base_url}}"],
              "path": ["overtime", "upload", "{{pay_period_id}}"]
            },
            "description": "Bulk upload overtime entries for multiple employees in a pay period."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Deductions",
      "description": "Endpoints for managing deduction entries",
      "item": [
        {
          "name": "Add Deduction Entry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"staffId\": \"{{staff_id}}\",\n  \"payPeriodId\": \"{{pay_period_id}}\",\n  \"type\": \"LOAN\",\n  \"amount\": 50000,\n  \"description\": \"Salary advance repayment - March installment\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/deductions",
              "host": ["{{base_url}}"],
              "path": ["deductions"]
            },
            "description": "Add a deduction entry for an employee. Types: LOAN, PENALTY, OTHER"
          },
          "response": []
        },
        {
          "name": "Get Deductions by Period",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/deductions/{{pay_period_id}}",
              "host": ["{{base_url}}"],
              "path": ["deductions", "{{pay_period_id}}"]
            },
            "description": "Get all deduction entries for a specific pay period."
          },
          "response": []
        },
        {
          "name": "Get Staff Deductions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/deductions/{{pay_period_id}}/staff/{{staff_id}}",
              "host": ["{{base_url}}"],
              "path": ["deductions", "{{pay_period_id}}", "staff", "{{staff_id}}"]
            },
            "description": "Get all deductions for a specific staff member in a pay period."
          },
          "response": []
        },
        {
          "name": "Delete Deduction Entry",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/deductions/entry/{{deduction_entry_id}}",
              "host": ["{{base_url}}"],
              "path": ["deductions", "entry", "{{deduction_entry_id}}"]
            },
            "description": "Delete a specific deduction entry. Cannot delete if payroll has been computed."
          },
          "response": []
        },
        {
          "name": "Bulk Upload Deductions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entries\": [\n    {\n      \"staffId\": \"staff-001\",\n      \"type\": \"LOAN\",\n      \"amount\": 50000,\n      \"description\": \"Loan repayment\"\n    },\n    {\n      \"staffId\": \"staff-002\",\n      \"type\": \"PENALTY\",\n      \"amount\": 5000,\n      \"description\": \"Late penalty\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/deductions/upload/{{pay_period_id}}",
              "host": ["{{base_url}}"],
              "path": ["deductions", "upload", "{{pay_period_id}}"]
            },
            "description": "Bulk upload deduction entries for multiple employees in a pay period."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Validations",
      "description": "Endpoints for supervisor validation of staff payments",
      "item": [
        {
          "name": "Validate Single Staff",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payPeriodId\": \"{{pay_period_id}}\",\n  \"staffId\": \"{{staff_id}}\",\n  \"status\": \"YES_FOR_PAYMENT\",\n  \"reason\": \"\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/validations",
              "host": ["{{base_url}}"],
              "path": ["validations"]
            },
            "description": "Validate a single staff member for payment. Status: YES_FOR_PAYMENT or NO_FOR_PAYMENT. Reason is required for NO_FOR_PAYMENT."
          },
          "response": []
        },
        {
          "name": "Bulk Validate Staff",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payPeriodId\": \"{{pay_period_id}}\",\n  \"validations\": [\n    {\n      \"staffId\": \"staff-001\",\n      \"status\": \"YES_FOR_PAYMENT\"\n    },\n    {\n      \"staffId\": \"staff-002\",\n      \"status\": \"NO_FOR_PAYMENT\",\n      \"reason\": \"Pending disciplinary review\"\n    },\n    {\n      \"staffId\": \"staff-003\",\n      \"status\": \"YES_FOR_PAYMENT\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/validations?action=bulk",
              "host": ["{{base_url}}"],
              "path": ["validations"],
              "query": [
                {
                  "key": "action",
                  "value": "bulk"
                }
              ]
            },
            "description": "Bulk validate multiple staff members. Each validation must include staffId and status. Reason is required for NO_FOR_PAYMENT."
          },
          "response": []
        },
        {
          "name": "Get Validation Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/validations/{{pay_period_id}}/summary",
              "host": ["{{base_url}}"],
              "path": ["validations", "{{pay_period_id}}", "summary"]
            },
            "description": "Get validation summary statistics for a pay period including total, pending, approved, and withheld counts."
          },
          "response": []
        },
        {
          "name": "Get Team for Validation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/validations/{{pay_period_id}}/team",
              "host": ["{{base_url}}"],
              "path": ["validations", "{{pay_period_id}}", "team"]
            },
            "description": "Get team members that need validation by the current supervisor."
          },
          "response": []
        },
        {
          "name": "Get Pending Validations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/validations/{{pay_period_id}}/pending",
              "host": ["{{base_url}}"],
              "path": ["validations", "{{pay_period_id}}", "pending"]
            },
            "description": "Get all staff members who are pending validation for a pay period."
          },
          "response": []
        },
        {
          "name": "Get Withheld Staff",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/validations/{{pay_period_id}}/withheld",
              "host": ["{{base_url}}"],
              "path": ["validations", "{{pay_period_id}}", "withheld"]
            },
            "description": "Get all staff members who have been marked as NO_FOR_PAYMENT with their reasons."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Payroll Computation",
      "description": "Endpoints for computing payroll",
      "item": [
        {
          "name": "Compute Payroll",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payPeriodId\": \"{{pay_period_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/payroll/compute",
              "host": ["{{base_url}}"],
              "path": ["payroll", "compute"]
            },
            "description": "Compute payroll for all validated staff in a pay period. This calculates gross salary, tax (PAYE), pension, and net pay for each employee."
          },
          "response": []
        },
        {
          "name": "Approve Payroll",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payPeriodId\": \"{{pay_period_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/payroll/approve",
              "host": ["{{base_url}}"],
              "path": ["payroll", "approve"]
            },
            "description": "Approve computed payroll for payment. Only SUPER_ADMIN can approve payroll."
          },
          "response": []
        },
        {
          "name": "Mark Payroll as Paid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payPeriodId\": \"{{pay_period_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/payroll/mark-paid",
              "host": ["{{base_url}}"],
              "path": ["payroll", "mark-paid"]
            },
            "description": "Mark payroll as paid after bank transfers are complete. This finalizes the payroll period."
          },
          "response": []
        },
        {
          "name": "Get Computation Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/payroll/{{pay_period_id}}/summary",
              "host": ["{{base_url}}"],
              "path": ["payroll", "{{pay_period_id}}", "summary"]
            },
            "description": "Get summary of computed payroll including total gross, total tax, total pension, total deductions, and total net pay."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Payslips",
      "description": "Endpoints for accessing payslips",
      "item": [
        {
          "name": "Get Payslips by Period",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/payslips/{{pay_period_id}}",
              "host": ["{{base_url}}"],
              "path": ["payslips", "{{pay_period_id}}"]
            },
            "description": "Get all payslips for a specific pay period. Admin/Manager view."
          },
          "response": []
        },
        {
          "name": "Get Staff Payslip",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/payslips/{{pay_period_id}}/staff/{{staff_id}}",
              "host": ["{{base_url}}"],
              "path": ["payslips", "{{pay_period_id}}", "staff", "{{staff_id}}"]
            },
            "description": "Get detailed payslip for a specific staff member in a pay period."
          },
          "response": []
        },
        {
          "name": "Get My Payslips",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/payslips/my-payslips",
              "host": ["{{base_url}}"],
              "path": ["payslips", "my-payslips"]
            },
            "description": "Get payslip history for the authenticated user (employee self-service)."
          },
          "response": []
        },
        {
          "name": "Download Payslip PDF",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/payslips/{{pay_period_id}}/staff/{{staff_id}}/download",
              "host": ["{{base_url}}"],
              "path": ["payslips", "{{pay_period_id}}", "staff", "{{staff_id}}", "download"]
            },
            "description": "Download payslip as PDF document."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Tax Reports",
      "description": "Endpoints for tax reporting",
      "item": [
        {
          "name": "Get Tax Report",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tax/report/{{pay_period_id}}",
              "host": ["{{base_url}}"],
              "path": ["tax", "report", "{{pay_period_id}}"]
            },
            "description": "Get detailed PAYE tax report for a pay period. Includes breakdown by tax band."
          },
          "response": []
        },
        {
          "name": "Get Annual Tax Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tax/annual/{{staff_id}}?year=2026",
              "host": ["{{base_url}}"],
              "path": ["tax", "annual", "{{staff_id}}"],
              "query": [
                {
                  "key": "year",
                  "value": "2026"
                }
              ]
            },
            "description": "Get annual tax summary for a specific employee. Useful for tax filing."
          },
          "response": []
        }
      ]
    }
  ]
}
